---
import EditorialStaticLayout from '@/components/editorial/EditorialStaticLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteUrl } from '@/lib/site';

const title = 'Deeper API for Developers and AI Agents | Deeper Global';
const description =
  'Use Deeper API to retrieve reviewed mental health answer metadata, topic maps, source references, and agent-readable context for educational AI products.';
const jsonLd = {
  '@type': 'TechArticle',
  '@id': `${siteUrl('/developers/')}#api-docs`,
  headline: 'Deeper API for Developers and AI Agents',
  description,
  url: siteUrl('/developers/'),
  about: ['mental health answer API', 'AI agent retrieval', 'structured mental health content'],
};
---

<BaseLayout title={title} description={description} canonicalPath="/developers/" jsonLd={jsonLd}>
  <EditorialStaticLayout
    eyebrow="Developer preview"
    title="Deeper API for agents, apps, and mental health search."
    lede="Structured, reviewed mental health answer metadata built for AI retrieval, topic mapping, citation, and responsible educational products."
    class="editorial-static-page--developer"
    wide={true}
  >
    <div class="developer-actions">
      <a class="button" href="/openapi.json">OpenAPI spec</a>
      <a class="button secondary" href="/api/v1/answers">Answer API</a>
      <a class="button secondary" href="/agents.txt">Agent instructions</a>
      <a class="button secondary" href="https://github.com/rjulian2025/deeper-api-examples">Examples</a>
      <a class="button secondary" href="/api-terms/">API terms</a>
    </div>

    <div class="developer-grid">
        <article class="developer-panel">
          <p class="eyebrow">What it is</p>
          <h2>Agent-ready mental health content infrastructure.</h2>
          <p>
            Deeper API exposes canonical answer URLs, titles, summaries, extracts, risk classes,
            review metadata, source references, topic entities, and priority signals.
          </p>
        </article>
        <article class="developer-panel">
          <p class="eyebrow">Boundary</p>
          <h2>Education, not care delivery.</h2>
          <p>
            Deeper API is not a diagnosis, treatment, crisis, or therapy API. Products using it
            should preserve the educational boundary and route emergencies to appropriate support.
          </p>
        </article>
    </div>

    <div class="section-header developer-section-header">
      <div>
        <p class="editorial-static-eyebrow">Endpoints</p>
        <h2>Start with read-only indexes.</h2>
      </div>
    </div>
    <div class="endpoint-list">
          <article class="endpoint-row">
            <code>GET /api/v1/answers</code>
            <p>Paginated answer inventory with summaries, extracts, source references, risk classes, and reviewer metadata. Supports <code>q</code>, <code>topic</code>, <code>reviewed</code>, <code>limit</code>, and <code>offset</code>.</p>
          </article>
          <article class="endpoint-row">
            <code>GET /api/v1/answers/&#123;slug&#125;</code>
            <p>Single answer detail record with sections, key takeaways, care note, and follow-up questions.</p>
          </article>
          <article class="endpoint-row">
            <code>GET /llms/answers.json</code>
            <p>Agent-discovery mirror of the answer inventory for llms.txt workflows.</p>
          </article>
          <article class="endpoint-row">
            <code>GET /llms/entities.json</code>
            <p>Topic map with aliases, answer counts, canonical URLs, and representative answer slugs.</p>
          </article>
          <article class="endpoint-row">
            <code>GET /llms/priority.json</code>
            <p>Ranked quality and authority queue for agents working on content, review, or indexing tasks.</p>
          </article>
          <article class="endpoint-row">
            <code>GET /llms.txt</code>
            <p>Agent-readable site guide with high-value entry points and usage boundaries.</p>
          </article>
          <article class="endpoint-row">
            <code>GET /agents.txt</code>
            <p>Agent usage instructions, citation expectations, and clinical safety boundaries.</p>
          </article>
        </div>
    <p class="developer-note">
      Example curl, JavaScript, and Python clients are available at
      <a href="https://github.com/rjulian2025/deeper-api-examples">github.com/rjulian2025/deeper-api-examples</a>.
    </p>

    <div class="code-grid">
      <article class="developer-panel">
        <p class="editorial-static-eyebrow">curl</p>
        <pre><code>curl https://www.deeper.global/api/v1/answers</code></pre>
      </article>
      <article class="developer-panel">
        <p class="editorial-static-eyebrow">JavaScript</p>
        <pre><code>const res = await fetch('https://www.deeper.global/api/v1/answers');
const data = await res.json();
const adhd = data.answers.filter((answer) =>
  [answer.title, answer.topic, answer.summary].join(' ').toLowerCase().includes('adhd')
);</code></pre>
      </article>
      <article class="developer-panel">
        <p class="editorial-static-eyebrow">Python</p>
        <pre><code>import requests

data = requests.get(
    "https://www.deeper.global/api/v1/answers",
    timeout=20,
).json()

anxiety = [
    answer for answer in data["answers"]
    if "anxiety" in " ".join([
        answer["title"],
        answer["topic"],
        answer["summary"],
    ]).lower()
]</code></pre>
      </article>
    </div>

    <div class="developer-band">
      <p class="editorial-static-eyebrow">Commercial access</p>
      <h2>Building with Deeper API?</h2>
      <p>
        The public endpoints are a developer preview. For commercial licensing, bulk use,
        custom feeds, private keys, or MCP integration support, review the
        <a href="/api-terms/">API terms</a> and contact Deeper Global.
      </p>
    </div>
  </EditorialStaticLayout>
</BaseLayout>

<style>
  .editorial-static-page--developer .developer-actions,
  .editorial-static-page--developer .developer-grid,
  .editorial-static-page--developer .code-grid {
    display: grid;
    gap: var(--space-4);
  }

  .editorial-static-page--developer .developer-actions {
    grid-template-columns: repeat(auto-fit, minmax(11rem, max-content));
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .editorial-static-page--developer .developer-grid,
  .editorial-static-page--developer .code-grid {
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    margin-top: var(--space-8);
  }

  .editorial-static-page--developer .developer-section-header {
    margin-top: var(--space-10);
  }

  .editorial-static-page--developer .developer-panel,
  .editorial-static-page--developer .endpoint-row {
    border: 1px solid var(--d-line);
    border-radius: 2px;
    padding: var(--space-5);
    background: var(--d-surface);
  }

  .editorial-static-page--developer .developer-panel h2,
  .editorial-static-page--developer .developer-panel p {
    margin-top: 0;
  }

  .editorial-static-page--developer .endpoint-list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .editorial-static-page--developer .developer-note {
    margin-top: var(--space-4);
  }

  .editorial-static-page--developer .endpoint-row {
    display: grid;
    gap: var(--space-2);
  }

  .editorial-static-page--developer .endpoint-row code,
  .editorial-static-page--developer pre {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .editorial-static-page--developer .endpoint-row code {
    color: var(--d-heading);
    font-weight: 700;
  }

  .editorial-static-page--developer pre {
    overflow-x: auto;
    border-radius: 2px;
    background: var(--d-heading);
    color: var(--d-page);
    padding: var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .editorial-static-page--developer .developer-band {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--d-line);
  }
</style>
