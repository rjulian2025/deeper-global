---
/**
 * Peachtree Psychology organization profile.
 * Retains noindex until clinician profiles are approved, attribution migration
 * is applied, and aggregate counts are derived from production data.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  getPeachtreePsychologyOrganization,
  getPublishableClinicalContributors,
  peachtreeClinicalContributors,
} from '@/data/clinical-contributors';
import proposedAggregate from '@/data/organizations/peachtree-aggregate.proposed.json';
import { siteUrl, websiteId } from '@/lib/site';

const org = getPeachtreePsychologyOrganization();
const publishable = getPublishableClinicalContributors().filter((c) => c.assignmentEligibility !== 'report_only');
const incomplete = peachtreeClinicalContributors.filter(
  (c) => c.profileStatus === 'incomplete' || c.assignmentEligibility === 'report_only'
);
const pageUrl = siteUrl(org.url);

const specialties = [...new Set(publishable.flatMap((c) => c.specialties))].sort((a, b) =>
  a.localeCompare(b)
);

const jsonLd = {
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${pageUrl}#organization`,
      name: org.name,
      url: pageUrl,
      sameAs: org.sameAs,
      description: org.shortOverview,
      address: {
        '@type': 'PostalAddress',
        streetAddress: '555 Sun Valley Drive, Suite M-2',
        addressLocality: 'Roswell',
        addressRegion: 'GA',
        postalCode: '30076',
      },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: `${org.name} | Clinical contributors`,
      isPartOf: { '@id': websiteId() },
      about: { '@id': `${pageUrl}#organization` },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: publishable.length,
        itemListElement: publishable.map((clinician, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: siteUrl(`/reviewers/${clinician.slug}/`),
          name: clinician.fullName,
        })),
      },
    },
  ],
};
---

<BaseLayout
  title={`${org.name} | Clinical contributors | Deeper Global`}
  description={org.shortOverview}
  canonicalPath={org.url}
  jsonLd={jsonLd}
  noindex={true}
>
  <main class="discovery-surface">
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">Organization</p>
        <h1>{org.name}</h1>
        <p class="lede">{org.shortOverview}</p>
        <p class="editorial-meta discovery-meta">
          <a href={org.externalUrl} rel="noopener noreferrer">peachtreepsychology.com</a>
          <span class="meta-sep" aria-hidden="true">·</span>
          {org.locationLine}
        </p>
        <p class="editorial-meta">
          Proposed specialty-matched coverage (pre-apply): {proposedAggregate.aggregate_high_confidence_answers} answers
          across {proposedAggregate.clinician_count} clinicians. Counts remain provisional until production apply.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Relationship to Deeper Global</h2>
        <p>{org.relationshipLanguage}</p>
        <p>
          Public answer pages that name a Peachtree clinician use the label <strong>Clinical contributor</strong>. That
          reflects specialty-matched organizational approval, not an individual page-by-page clinical review unless a
          separate clinical review record exists.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Participating clinicians</h2>
        <p class="editorial-meta">
          {publishable.length} eligible profiles prepared · {incomplete.length} incomplete / report-only
        </p>
        <div class="discovery-list">
          {
            publishable.map((clinician) => (
              <article class="discovery-row">
                <h3 class="discovery-row-title">
                  <a href={`/reviewers/${clinician.slug}/`}>{clinician.fullName}</a>
                </h3>
                <p class="editorial-meta discovery-meta">
                  {clinician.credentialLine} · {clinician.specialtyLabel}
                </p>
                <p class="discovery-summary">{clinician.shortBio}</p>
                <p class="editorial-meta">
                  <a href={clinician.externalPracticeUrl} rel="noopener noreferrer">External Peachtree profile</a>
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Specialties represented</h2>
        <p>{specialties.slice(0, 48).join(' · ')}{specialties.length > 48 ? ' · …' : ''}</p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <h2>Associated Deeper topics (proposed)</h2>
        <ul>
          {
            proposedAggregate.top_topics.slice(0, 12).map(([topic, count]) => (
              <li>
                {topic}: {count} proposed answers
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>
