---
import ProfileLayout from '@/components/reviewers/ProfileLayout.astro';
import ReviewerAnswerExcerpt from '@/components/reviewers/ReviewerAnswerExcerpt.astro';
import ReviewerSidebar from '@/components/reviewers/ReviewerSidebar.astro';
import ReviewerVideoCard from '@/components/reviewers/ReviewerVideoCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getQuestions } from '@/lib/supabase';
import { getReviewedByLabel } from '@/lib/trust';
import { buildReviewGroupDisplays, resolveReviewerProfilePaths, topicAnswersLabel } from '@/lib/reviewer-page';
import { getAllReviewerRouteProfiles, type ContributorRouteProfile } from '@/lib/contributor-profiles';
import { siteUrl, websiteId } from '@/lib/site';
import { getCanonicalTopic } from '@/lib/taxonomy';
import '@/styles/reviewer-profile.css';

export async function getStaticPaths() {
  return getAllReviewerRouteProfiles().map((reviewer) => ({
    params: { reviewerSlug: reviewer.slug },
    props: { reviewer },
  }));
}

const questions = await getQuestions();
const reviewer = resolveReviewerProfilePaths(Astro.props.reviewer as ContributorRouteProfile, questions);
const activation = (Astro.props.reviewer as ContributorRouteProfile).activation;
const questionsBySlug = new Map(questions.map((question) => [question.slug, question]));

// Proposed assignments are not in DB yet; show live reviewed_by matches plus empty proposed placeholder count from build.
const reviewedAnswers = questions
  .filter((question) => getReviewedByLabel(question) === reviewer.id)
  .sort((a, b) => a.question.localeCompare(b.question));

const displayName = reviewer.displayName ?? reviewer.name;
const reviewerPageRole = reviewer.trustRoleLabel ?? 'Clinical Reviewer';
const pageTitle = `${displayName} | ${reviewerPageRole} | Deeper Global`;
const pageDescription = reviewer.designation
  ? `${displayName}. ${reviewer.designation}`
  : `${reviewer.name} is associated with selected Deeper Global answers related to ${reviewer.specialtyLabel.toLowerCase()}.`;

const reviewGroups = reviewer.reviewedContentGroups
  ? buildReviewGroupDisplays(reviewer.reviewedContentGroups, questionsBySlug)
  : [];

const hasOverview =
  Boolean(reviewer.overviewParagraphs?.length) || Boolean(reviewer.expertiseSummary) || Boolean(reviewer.bio);
const overviewTitle = reviewer.overviewParagraphs?.length ? 'Clinical overview' : 'About this contributor';
const overviewHeading = reviewer.overviewParagraphs?.length
  ? 'Assessment and diagnostic expertise'
  : `Background and expertise`;

const topicDistribution = new Map<string, number>();
for (const answer of reviewedAnswers) {
  const topic = getCanonicalTopic(answer.category || answer.raw_category || answer.primary_theme).name;
  topicDistribution.set(topic, (topicDistribution.get(topic) || 0) + 1);
}
const topicRows = [...topicDistribution.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const pageUrl = siteUrl(`/reviewers/${reviewer.slug}/`);
const personId = `${pageUrl}#person`;
const jsonLd = {
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${pageUrl}#profile`,
      url: pageUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': websiteId() },
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: displayName,
      url: pageUrl,
      jobTitle: reviewer.role || reviewer.specialtyLabel,
      description: reviewer.bio,
      knowsAbout: reviewer.expertiseTags,
      ...(reviewer.sameAs?.length ? { sameAs: reviewer.sameAs } : {}),
      ...(reviewer.practiceName === 'Peachtree Psychology'
        ? {
            affiliation: {
              '@type': 'Organization',
              '@id': `${siteUrl('/organizations/peachtree-psychology/')}#organization`,
              name: 'Peachtree Psychology',
              url: siteUrl('/organizations/peachtree-psychology/'),
            },
          }
        : {}),
    },
  ],
};

const PAGE_SIZE = 24;
const visibleAnswers = reviewedAnswers.slice(0, PAGE_SIZE);
const hiddenCount = Math.max(0, reviewedAnswers.length - visibleAnswers.length);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={`/reviewers/${reviewer.slug}`}
  imagePath={reviewer.image}
  imageAlt={reviewer.imageAlt}
  jsonLd={jsonLd}
  noindex={!activation.indexable}
>
  <main class="discovery-surface reviewer-profile">
    <div class="container">
      <nav class="reviewer-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="reviewer-breadcrumb-sep" aria-hidden="true">/</span>
        <a href="/reviewers/">Reviewers</a>
        <span class="reviewer-breadcrumb-sep" aria-hidden="true">/</span>
        <span class="reviewer-breadcrumb-current">{displayName.split(',')[0]}</span>
      </nav>
    </div>

    <section class="reviewer-body">
      <div class="container reviewer-body-shell">
        <header class="reviewer-page-header">
          <p class="eyebrow">{reviewerPageRole}</p>
          <h1>{displayName}</h1>
          <p class="reviewer-designation">{reviewer.designation ?? reviewer.specialtyLabel}</p>
          {
            reviewer.practiceName === 'Peachtree Psychology' && (
              <p class="editorial-meta">
                Affiliated with <a href="/organizations/peachtree-psychology/">Peachtree Psychology</a>
                {
                  reviewer.practiceUrl && (
                    <>
                      {' '}
                      · <a href={reviewer.practiceUrl} rel="noopener noreferrer">External practice profile</a>
                    </>
                  )
                }
              </p>
            )
          }
          {
            !activation.indexable && (
              <p class="editorial-meta">
                Profile prepared for activation (currently noindex until migration apply and editorial approval).
              </p>
            )
          }
        </header>

        <ProfileLayout>
          <ReviewerSidebar slot="sidebar" reviewer={reviewer} />

          <div class="profile-main-inner">
            {reviewer.videoModule && <ReviewerVideoCard reviewer={reviewer} />}

            {
              reviewer.clinicalPerspective && (
                <blockquote class="reviewer-pull-quote">{reviewer.clinicalPerspective}</blockquote>
              )
            }

            {
              hasOverview && (
                <section class="profile-main-section" aria-labelledby="reviewer-overview-title">
                  <p class="profile-main-label">{overviewTitle}</p>
                  <h2 id="reviewer-overview-title">{overviewHeading}</h2>
                  <div class="reviewer-prose">
                    {reviewer.overviewParagraphs?.map((paragraph) => <p>{paragraph}</p>)}
                    {
                      !reviewer.overviewParagraphs?.length && reviewer.bio && (
                        <p>{reviewer.bio}</p>
                      )
                    }
                    {reviewer.expertiseSummary && <p>{reviewer.expertiseSummary}</p>}
                  </div>
                </section>
              )
            }

            {
              topicRows.length > 0 && (
                <section class="profile-main-section profile-main-section--compact" aria-labelledby="topic-dist-title">
                  <p class="profile-main-label">Topic distribution</p>
                  <h2 id="topic-dist-title">Associated answer topics</h2>
                  <ul class="reviewer-affiliation-list">
                    {topicRows.map(([topic, count]) => (
                      <li>
                        {topic}: {count}
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }

            {
              reviewGroups.length > 0 ? (
                <section
                  class="profile-main-section"
                  id="reviewed-knowledge"
                  aria-labelledby="reviewed-knowledge-title"
                >
                  <p class="profile-main-label">Associated knowledge</p>
                  <h2 id="reviewed-knowledge-title">
                    {reviewer.reviewedKnowledgeTitle ?? `Answers associated with ${displayName.split(',')[0]}`}
                  </h2>
                  {
                    reviewer.reviewedKnowledgeIntro && (
                      <p class="reviewer-section-intro">{reviewer.reviewedKnowledgeIntro}</p>
                    )
                  }

                  {
                    reviewGroups.map((group, groupIndex) => {
                      const groupNumber = String(groupIndex + 1).padStart(2, '0');
                      return (
                      <div class="reviewer-topic-group tier-module">
                        <p class="tier-index" aria-hidden="true">{groupNumber}</p>
                        <div class="tier-group-heading">
                          <h3 class="tier-heading">{group.name}</h3>
                          <span class="tier-utility">
                            {group.totalCount} {group.totalCount === 1 ? 'answer' : 'answers'}
                          </span>
                        </div>
                        <div class="reviewer-answer-list tier-excerpt-list">
                          {group.visible.map((question) => <ReviewerAnswerExcerpt question={question} />)}
                        </div>
                        {
                          group.hiddenCount > 0 && group.viewAllPath && (
                            <p class="tier-group-more">
                              <a class="tier-utility-action" href={group.viewAllPath}>
                                {topicAnswersLabel(group.name, group.totalCount)}
                              </a>
                            </p>
                          )
                        }
                      </div>
                      );
                    })
                  }
                </section>
              ) : (
                reviewedAnswers.length > 0 && (
                  <section class="profile-main-section" aria-labelledby="reviewed-answers-title">
                    <p class="profile-main-label">Associated answers</p>
                    <h2 id="reviewed-answers-title">
                      {reviewedAnswers.length} answer{reviewedAnswers.length === 1 ? '' : 's'} currently attributed
                    </h2>
                    <div class="reviewer-answer-list tier-excerpt-list">
                      {visibleAnswers.map((question) => <ReviewerAnswerExcerpt question={question} />)}
                    </div>
                    {
                      hiddenCount > 0 && (
                        <p class="tier-group-more">
                          Showing {visibleAnswers.length} of {reviewedAnswers.length}. Additional answers will paginate
                          after contributor activation.
                        </p>
                      )
                    }
                  </section>
                )
              )
            }

            {
              reviewer.hubConnection && (
                <section class="profile-main-section profile-main-section--compact" aria-labelledby="reviewer-hub-title">
                  <p class="profile-main-label">Topic connection</p>
                  <h2 id="reviewer-hub-title">{reviewer.hubConnection.hubLabel}</h2>
                  <p class="reviewer-section-intro">{reviewer.hubConnection.summary}</p>
                  <p class="tier-group-more">
                    <a class="tier-utility-action" href={reviewer.hubConnection.hubPath}>
                      {reviewer.hubConnection.hubLabel} →
                    </a>
                  </p>
                </section>
              )
            }

            {
              reviewer.affiliations && reviewer.affiliations.length > 0 && (
                <section
                  class="profile-main-section profile-main-section--compact"
                  aria-labelledby="reviewer-affiliations-title"
                >
                  <p class="profile-main-label">Affiliations</p>
                  <h2 id="reviewer-affiliations-title">Professional affiliations</h2>
                  <ul class="reviewer-affiliation-list">
                    {reviewer.affiliations.map((item) => <li>{item}</li>)}
                  </ul>
                </section>
              )
            }
          </div>
        </ProfileLayout>
      </div>
    </section>

    <section class="reviewer-footer">
      <div class="container">
        <p class="profile-disclaimer">{reviewer.disclaimer}</p>
        {
          reviewer.practiceNotes && reviewer.practiceNotes.length > 0 && (
            <ul class="reviewer-disclaimers">
              {reviewer.practiceNotes.map((note) => <li>{note}</li>)}
            </ul>
          )
        }
        <p class="profile-disclaimer">
          See the <a href="/editorial-policy/">editorial policy</a> for how Deeper Global handles contributor
          attribution, sources, and updates. Deeper Global does not employ or certify Peachtree Psychology clinicians.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
