---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { reviewerProfiles, type ReviewerProfile } from '@/lib/trust';

export function getStaticPaths() {
  return reviewerProfiles.map((reviewer) => ({
    params: { reviewerSlug: reviewer.slug },
    props: { reviewer },
  }));
}

const reviewer = Astro.props.reviewer as ReviewerProfile;
---

<BaseLayout
  title={`${reviewer.name} | Clinical Reviewer | Deeper Global`}
  description={`${reviewer.name} is listed as a clinical reviewer for selected Deeper Global mental health answers.`}
  canonicalPath={`/reviewers/${reviewer.slug}`}
>
  <main class="content">
    <p class="eyebrow">Clinical reviewer</p>
    <h1>{reviewer.name}</h1>
    <p class="summary">{reviewer.credentialLine}</p>

    <p>
      {reviewer.name} is recorded as the clinical reviewer for selected Deeper Global answers when an answer page lists this reviewer by name.
    </p>
    <p>
      Named review signals appear only on answers where review metadata is present in the source record, along with a last reviewed date when available.
    </p>
    <p>
      See the <a href="/editorial-policy/">editorial policy</a> for how Deeper Global handles reviewer attribution, sources, and updates.
    </p>
  </main>
</BaseLayout>
