---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublicDirectoryReviewers } from '@/data/reviewers';
import '@/styles/reviewer-profile.css';

const directoryReviewers = getPublicDirectoryReviewers();
---

<BaseLayout
  title="Clinical Reviewers & Contributors | Deeper Global"
  description="Meet the clinicians and editorial reviewers associated with selected Deeper Global mental health answers."
  canonicalPath="/reviewers"
>
  <main class="discovery-surface reviewer-profile">
    <div class="container">
      <nav class="reviewer-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="reviewer-breadcrumb-sep" aria-hidden="true">/</span>
        <span class="reviewer-breadcrumb-current">Reviewers</span>
      </nav>
    </div>

    <section class="reviewer-hero">
      <div class="container">
        <p class="eyebrow">Reviewers and contributors</p>
        <h1>Who is associated with our answers</h1>
        <p class="reviewer-designation">
          Some Deeper Global answers name a clinical reviewer, clinical contributor, or editorial reviewer. Labels and
          dates depend on the attribution type; specialty-based contributor assignments do not imply page-by-page clinical
          review.
        </p>
      </div>
    </section>

    <section class="reviewer-section">
      <div class="container">
        <div class="discovery-list profile-directory">
          {
            directoryReviewers.map((reviewer) => (
              <article class="discovery-row profile-directory-row">
                <h2 class="discovery-row-title">
                  <a href={reviewer.url}>{reviewer.displayName ?? reviewer.name}</a>
                </h2>
                <p class="editorial-meta discovery-meta">
                  {reviewer.trustRoleLabel ?? 'Clinical reviewer'} · {reviewer.specialtyLabel}
                </p>
                {reviewer.designation && <p class="reviewer-directory-designation">{reviewer.designation}</p>}
                <p class="discovery-summary">{reviewer.bio}</p>
              </article>
            ))
          }
        </div>

        <p class="profile-disclaimer">
          Learn more about how Deeper Global handles sources, clinical review, and updates in our{' '}
          <a href="/editorial-policy/">editorial policy</a>.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
