---
import AnswerCard from '@/components/AnswerCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { adhdFeaturedSlugs, getAdhdHubQuestions } from '@/lib/adhd-hub';
import { answerPath, categoryPath, displayCategory, formatDate, getAnswerDisplayTitle, getAnswerSummary, getCategorySummaries, truncate } from '@/lib/content';
import { getTrendingQuestions } from '@/lib/engagement';
import { modalityFeaturedSlugs, modalityPath } from '@/lib/modality-hub';
import { getModalities, getQuestions } from '@/lib/supabase';

function truncateTrendingChip(title: string, maxLength = 40) {
  const trimmed = title.trim();
  if (trimmed.length <= maxLength) {
    return trimmed;
  }

  const slice = trimmed.slice(0, maxLength);
  const wordBreak = slice.replace(/\s+\S*$/, '').trim();
  const result = wordBreak || slice.trim();
  return result.endsWith('?') ? result : `${result}?`;
}

const questions = await getQuestions();
const modalities = await getModalities();
const recentQuestions = questions.slice(0, 6);
const categories = getCategorySummaries(questions);
const visibleCategories = categories.slice(0, 12);
const featuredQuestion = questions[0];
const featuredCategory = featuredQuestion ? displayCategory(featuredQuestion) : null;
const reviewedCount = questions.filter((question) => question.reviewed_by).length;
const aiQuestions = questions.filter((question) => question.content_prompt_version === 'deeper-ai-concerns-sprint-v1');
const aiAnswerCount = aiQuestions.length;
const aiFeaturedQuestions = aiQuestions.slice(0, 3);
const adhdHubQuestions = getAdhdHubQuestions(questions);
const adhdAnswerCount = adhdHubQuestions.length;
const adhdFeaturedQuestions = adhdFeaturedSlugs
  .map((slug) => adhdHubQuestions.find((question) => question.slug === slug))
  .filter((question): question is NonNullable<typeof question> => Boolean(question));
const modalitiesBySlug = new Map(modalities.map((modality) => [modality.slug, modality]));
const modalityAnswerCount = modalities.length;
const modalityFeatured = modalityFeaturedSlugs
  .map((slug) => modalitiesBySlug.get(slug))
  .filter((modality): modality is NonNullable<typeof modality> => Boolean(modality))
  .slice(0, 4);
const heroStats = [
  { value: questions.length ? questions.length.toLocaleString() : '1,000+', label: 'Vetted answers' },
  { value: categories.length ? categories.length.toLocaleString() : '38', label: 'Topic areas' },
  reviewedCount > 0
    ? { value: reviewedCount.toLocaleString(), label: 'Clinically reviewed' }
    : { value: '✓', label: 'Evidence-based' },
];
const trendingQuestions = getTrendingQuestions(questions, 4);
const trendingChips = trendingQuestions.map((question) => ({
  href: answerPath(question.slug),
  label: truncateTrendingChip(getAnswerDisplayTitle(question)),
}));
---

<BaseLayout>
  <main>
    <section class="hero" aria-labelledby="home-hero-title">
      <div class="hero-image" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="hero-eyebrow">Trusted mental health intelligence</p>
        <h1 id="home-hero-title">Answers to the questions you ask before you seek care.</h1>
        <p class="hero-subhead">
          Evidence-informed, human-written answers for the real questions people carry.
        </p>

        <form class="hero-search" action="/answers/" method="get" role="search" aria-label="Search mental health answers">
          <input
            id="ask"
            name="q"
            type="search"
            placeholder="What does anxiety actually feel like?"
            autocomplete="off"
            data-typed-prompts="Why do I feel anxious for no reason?|How do I know if I need therapy?|Why do I overthink everything?|Am I depressed or just sad?|How do I stop people-pleasing?|Why do I feel emotionally numb?"
          />
          <button type="submit" aria-label="Search answers">
            <span aria-hidden="true">⌕</span>
          </button>
        </form>

        <script>
          const askInput = document.querySelector<HTMLInputElement>('#ask');
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

          if (askInput && !reduceMotion) {
            const prompts = askInput.dataset.typedPrompts?.split('|').filter(Boolean) ?? [];
            let promptIndex = 0;
            let charIndex = 0;
            let deleting = false;
            let pauseTicks = 0;
            let active = true;

            const defaultPlaceholder = 'What does anxiety actually feel like?';

            const setPlaceholder = (value: string) => {
              askInput.placeholder = value ? `${value}|` : defaultPlaceholder;
            };

            const tick = () => {
              if (!active || document.activeElement === askInput || askInput.value || !prompts.length) {
                askInput.placeholder = defaultPlaceholder;
                window.setTimeout(tick, 500);
                return;
              }

              if (pauseTicks > 0) {
                pauseTicks -= 1;
                window.setTimeout(tick, 80);
                return;
              }

              const prompt = prompts[promptIndex];

              if (deleting) {
                charIndex -= 1;
                setPlaceholder(prompt.slice(0, charIndex));

                if (charIndex <= 0) {
                  deleting = false;
                  promptIndex = (promptIndex + 1) % prompts.length;
                  pauseTicks = 4;
                }
              } else {
                charIndex += 1;
                setPlaceholder(prompt.slice(0, charIndex));

                if (charIndex >= prompt.length) {
                  deleting = true;
                  pauseTicks = 18;
                }
              }

              window.setTimeout(tick, deleting ? 28 : 54);
            };

            askInput.addEventListener('focus', () => {
              askInput.placeholder = defaultPlaceholder;
            });

            window.addEventListener('beforeunload', () => {
              active = false;
            });

            window.setTimeout(tick, 800);
          }
        </script>

        <div class="trending-row" aria-label="Popular answers">
          <span class="trending-label">Popular</span>
          {
            trendingChips.length ? (
              trendingChips.map((chip) => (
                <a class="trending-chip" href={chip.href}>{chip.label}</a>
              ))
            ) : (
              ['Anxiety at work', 'Panic attacks', 'Do I need therapy?', 'Relationship anxiety'].map((label) => (
                <a class="trending-chip" href="/answers/">{label}</a>
              ))
            )
          }
        </div>

        <div class="hero-stats" aria-label="Deeper Global content coverage">
          {heroStats.map((stat) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">What people are asking</p>
            <h2>Start with what matters to you.</h2>
          </div>
          <a class="text-link" href="/answers/">See all answers</a>
        </div>
        <div class="question-grid">
          {
            recentQuestions.length ? (
              recentQuestions.map((question) => <AnswerCard question={question} />)
            ) : (
              <EmptyState
                title="Supabase content is ready to connect"
                message="Add Supabase environment variables and this section will populate from questions_master at build time."
              />
            )
          }
        </div>
      </div>
    </section>

    {
      featuredQuestion && featuredCategory && (
        <section class="section featured-section">
          <div class="container featured-answer">
            <div class="featured-question">
              <p class="eyebrow">Featured answer</p>
              <h2>{getAnswerDisplayTitle(featuredQuestion)}</h2>
              <a class="button light" href={answerPath(featuredQuestion.slug)}>Read the full answer</a>
            </div>
            <div class="featured-summary">
              <p class="eyebrow">The short answer</p>
              <p>{getAnswerSummary(featuredQuestion)}</p>
              <div class="featured-meta">
                <a class="pill" href={categoryPath(featuredCategory)}>{featuredCategory}</a>
                <span class="pill">Updated {formatDate(featuredQuestion.updated_at || featuredQuestion.created_at)}</span>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      adhdAnswerCount ? (
        <section class="section featured-section ai-discovery-section">
          <div class="container featured-answer">
            <div class="featured-question">
              <p class="eyebrow">ADHD</p>
              <h2>Diagnosis, focus, treatment, and daily life.</h2>
              <a class="button light" href="/adhd/">Open the ADHD hub</a>
            </div>
            <div class="featured-summary">
              <p class="eyebrow">Concern cluster</p>
              <p>
                Browse evidence-informed answers about adult ADHD signs, executive dysfunction, emotional overwhelm, medication, work accommodations, and building sustainable routines.
              </p>
              <div class="featured-meta">
                {adhdFeaturedQuestions.map((question) => (
                  <a class="pill" href={answerPath(question.slug)}>{truncate(getAnswerDisplayTitle(question), 44)}</a>
                ))}
              </div>
            </div>
          </div>
        </section>
      ) : null
    }

    {
      modalityAnswerCount ? (
        <section class="section featured-section ai-discovery-section">
          <div class="container featured-answer">
            <div class="featured-question">
              <p class="eyebrow">Therapy modalities</p>
              <h2>Understand approaches before you choose care.</h2>
              <a class="button light" href="/modalities/">Open the modalities hub</a>
            </div>
            <div class="featured-summary">
              <p class="eyebrow">Concern cluster</p>
              <p>
                Browse structured guides to CBT, DBT, EMDR, IFS, somatic therapies, and more — what each treats, what sessions feel like, and how to evaluate fit.
              </p>
              <div class="featured-meta">
                {modalityFeatured.map((modality) => (
                  <a class="pill" href={modalityPath(modality.slug)}>{modality.name}</a>
                ))}
              </div>
            </div>
          </div>
        </section>
      ) : null
    }

    {
      aiAnswerCount ? (
        <section class="section featured-section ai-discovery-section">
          <div class="container featured-answer">
            <div class="featured-question">
              <p class="eyebrow">AI mental health</p>
              <h2>Questions about AI, therapy, dependency, and safety.</h2>
              <a class="button light" href="/ai-mental-health/">Open the AI mental health hub</a>
            </div>
            <div class="featured-summary">
              <p class="eyebrow">New concern cluster</p>
              <p>
                Browse evidence-informed answers about AI psychosis, chatbot attachment, AI companions, teen use, work anxiety,
                deepfakes, and when real-world support matters most.
              </p>
              <div class="featured-meta">
                {aiFeaturedQuestions.map((question) => (
                  <a class="pill" href={answerPath(question.slug)}>{truncate(getAnswerDisplayTitle(question), 44)}</a>
                ))}
              </div>
            </div>
          </div>
        </section>
      ) : null
    }

    <section class="section topic-section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Browse by topic</p>
            <h2>What are you carrying right now?</h2>
          </div>
          <a class="text-link" href="/categories/">All topics</a>
        </div>
        <div class="topic-pills">
          {
            modalityAnswerCount ? (
              <a class="topic-pill featured-topic-pill" href="/modalities/">
                <span>Therapy modalities</span>
                <small>{modalityAnswerCount} guides</small>
              </a>
            ) : null
          }
          {
            adhdAnswerCount ? (
              <a class="topic-pill featured-topic-pill" href="/adhd/">
                <span>ADHD</span>
                <small>{adhdAnswerCount} answers</small>
              </a>
            ) : null
          }
          {
            aiAnswerCount ? (
              <a class="topic-pill featured-topic-pill" href="/ai-mental-health/">
                <span>AI mental health</span>
                <small>{aiAnswerCount} answers</small>
              </a>
            ) : null
          }
          {
            visibleCategories.length ? (
              visibleCategories.map((category) => (
                <a class="topic-pill" href={categoryPath(category.name)}>
                  <span>{category.name}</span>
                  <small>{category.count} answers</small>
                </a>
              ))
            ) : (
              ['Anxiety', 'Depression', 'Relationships'].map((name) => (
                <a class="topic-pill" href="/categories/">
                  <span>{name}</span>
                  <small>Coming soon</small>
                </a>
              ))
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
