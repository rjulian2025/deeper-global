---
import DiscoveryRow from '@/components/DiscoveryRow.astro';
import EmptyState from '@/components/EmptyState.astro';
import HeroPopularLinks from '@/components/HeroPopularLinks.astro';
import HomepageBodyLayout from '@/components/homepage/HomepageBodyLayout.astro';
import TopicDirectory from '@/components/TopicDirectory.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { answerPath, categoryPath, displayCategory, formatDate, getAnswerDisplayTitle, getAnswerSummary, getCategorySummaries, truncate } from '@/lib/content';
import { pickCuriosityQuestions } from '@/lib/homepage-curiosity';
import { buildHomepageSidebarData } from '@/lib/homepage-sidebar';
import '@/styles/homepage-sidebar.css';
import { getQuestions } from '@/lib/supabase';
import { getEditorialTopicDirectory } from '@/lib/topic-directory';

const questions = await getQuestions();
const sidebar = buildHomepageSidebarData(questions);
const categories = getCategorySummaries(questions);
const topicDirectory = getEditorialTopicDirectory(questions);

const recentQuestions = pickCuriosityQuestions(questions, 6);
const featuredQuestion = pickCuriosityQuestions(
  questions.filter((question) => !recentQuestions.some((item) => item.slug === question.slug)),
  1,
)[0] ?? questions[0];
const featuredCategory = featuredQuestion ? displayCategory(featuredQuestion) : null;
const reviewedCount = questions.filter((question) => question.reviewed_by).length;
const heroStats = [
  { value: questions.length ? questions.length.toLocaleString() : '1,000+', label: 'Vetted answers' },
  { value: categories.length ? categories.length.toLocaleString() : '38', label: 'Topic areas' },
  reviewedCount > 0
    ? { value: reviewedCount.toLocaleString(), label: 'Clinically reviewed' }
    : { value: '✓', label: 'Evidence-based' },
];
const trendingQuestions = pickCuriosityQuestions(questions, 4);
const popularLinks = trendingQuestions.map((question) => ({
  href: answerPath(question.slug),
  label: getAnswerDisplayTitle(question),
}));
---

<BaseLayout>
  <main class="home-page">
    <section class="hero hero--home" aria-labelledby="home-hero-title">
      <div class="hero-image" aria-hidden="true"></div>
      <div class="container hero-shell">
        <div class="hero-content">
          <p class="hero-eyebrow">Trusted mental health intelligence</p>
          <h1 id="home-hero-title">The questions you ask<br />when no one is looking.</h1>
          <p class="hero-subhead">
            A trusted library of expert-vetted mental health answers for the questions that feel too personal, too tangled, or too hard to ask out loud.
          </p>

          <HeroPopularLinks links={popularLinks} variant="c" />

          <form class="hero-search" action="/answers/" method="get" role="search" aria-label="Search mental health answers">
            <input
              id="ask"
              name="q"
              type="search"
              placeholder="Why do I shut down when someone is upset with me?"
              autocomplete="off"
            />
            <button type="submit" aria-label="Search answers">
              <span aria-hidden="true">⌕</span>
            </button>
          </form>

          <div class="hero-stats" aria-label="Deeper Global content coverage">
            {heroStats.map((stat) => (
              <div>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <div class="container">
      <HomepageBodyLayout sidebar={sidebar}>
        <section class="section discovery-surface homepage-feed-section">
          <div class="section-header">
            <div>
              <p class="eyebrow">What people are asking</p>
              <h2>Start with what matters to you.</h2>
            </div>
            <a class="text-link" href="/answers/">See all answers</a>
          </div>
          <div class="discovery-list">
            {
              recentQuestions.length ? (
                recentQuestions.map((question) => <DiscoveryRow question={question} summaryMaxLength={168} />)
              ) : (
                <EmptyState
                  title="Supabase content is ready to connect"
                  message="Add Supabase environment variables and this section will populate from questions_master at build time."
                />
              )
            }
          </div>
        </section>
      </HomepageBodyLayout>

      {
        featuredQuestion && featuredCategory && (
          <section class="section discovery-surface">
            <div class="featured-editorial featured-editorial--home">
              <div class="featured-editorial-intro">
                <p class="eyebrow">Editor's pick</p>
                <h2>{getAnswerDisplayTitle(featuredQuestion)}</h2>
              </div>
              <div class="featured-editorial-body">
                <p>{truncate(getAnswerSummary(featuredQuestion), 180)}</p>
                <div class="featured-editorial-footer">
                  <p class="editorial-meta discovery-meta">
                    {featuredCategory}
                    <span class="meta-sep" aria-hidden="true">·</span>
                    Updated {formatDate(featuredQuestion.updated_at || featuredQuestion.created_at)}
                  </p>
                  <a class="featured-editorial-cta" href={answerPath(featuredQuestion.slug)}>
                    Read the full answer<span aria-hidden="true"> →</span>
                  </a>
                </div>
              </div>
            </div>
          </section>
        )
      }

      <section class="section discovery-surface">
        <div class="section-header">
          <div>
            <p class="eyebrow">Browse by topic</p>
            <h2>What are you carrying right now?</h2>
          </div>
          <a class="text-link" href="/categories/">View all topics<span aria-hidden="true"> →</span></a>
        </div>
        {
          topicDirectory.length ? (
            <TopicDirectory groups={topicDirectory} variant="c" questionsLabel="people-often-ask" />
          ) : (
            <TopicDirectory
              groups={[
                {
                  name: 'Common concerns',
                  description: 'Everyday questions about mood, relationships, and finding support.',
                  topics: [
                    { name: 'Anxiety', slug: 'anxiety', count: 0, href: categoryPath('Anxiety') },
                    { name: 'Depression', slug: 'depression', count: 0, href: categoryPath('Depression') },
                    { name: 'Relationships', slug: 'relationships', count: 0, href: '/categories/' },
                  ],
                  discoveryLinks: [],
                },
              ]}
              variant="c"
            />
          )
        }
      </section>
    </div>
  </main>
</BaseLayout>
