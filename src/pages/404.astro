---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Deeper Global"
  description="The page you requested does not exist or may have moved."
  robots="noindex, nofollow"
>
  <section class="container" style="padding: 4rem 1rem; text-align: center; min-height: 50vh;">
    <p style="font-size: 4rem; margin: 0; opacity: 0.35;">404</p>
    <h1 style="margin-top: 1rem;">Page not found</h1>
    <p style="margin-top: 0.75rem;">
      The page you are looking for does not exist or may have moved.
    </p>
    <p style="margin-top: 1.5rem;">
      <a href="/">Return home</a>
      ·
      <a href="/answers/">Browse answers</a>
    </p>
  </section>
</BaseLayout>
