---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnswerDirectionDMock from '@/components/design-evolution/AnswerDirectionDMock.astro';
import '@/styles/direction-d3-optical.css';

const mock = {
  title: 'What does anxiety actually feel like?',
  topic: 'Anxiety',
  reviewer: 'David K. Gore, PhD',
  updated: 'June 2026',
  sources: 2,
  ref: 'ANX-042',
  lede:
    'Anxiety is not only worry in your thoughts. For many people it shows up in the body first — tight chest, restlessness, difficulty sleeping — before they have language for what is happening.',
  takeaways: [
    'Physical symptoms (racing heart, shallow breathing, muscle tension) are common and real.',
    'Anxiety and stress overlap, but anxiety often persists after the immediate trigger passes.',
    'Naming the sensation can reduce fear of the sensation itself — a core loop in many anxiety patterns.',
    'When symptoms interfere with sleep, work, or relationships for weeks, professional evaluation helps.',
  ],
  sections: [
    {
      id: 'experiencing',
      title: 'What you might be experiencing',
      body:
        'People often describe a sense of impending danger without a clear source. Your nervous system may feel switched on — hypervigilant, irritable, or unable to settle. Some notice gastrointestinal discomfort, headaches, or tingling. Others describe emotional numbness alternating with sudden fear.',
    },
    {
      id: 'help',
      title: 'What can help',
      body:
        'Grounding in the body (slow breathing, orienting to the room, reducing caffeine late in the day) can lower acute activation. Structured routines around sleep and movement often stabilize baseline arousal. Therapy approaches such as CBT can address the thought patterns that maintain anxiety over time.',
    },
  ],
  related: [
    'Why do I feel anxious for no reason?',
    'How do I know if I need therapy?',
    'What is the difference between stress and anxiety?',
  ],
  care:
    'This answer is for understanding, not crisis care. If you are in immediate danger or thinking about harming yourself, contact emergency services or 988 in the U.S.',
};

const variants = [
  {
    variant: 'baseline' as const,
    tag: 'Baseline · Direction D',
    note: 'Symmetric panel padding (2.5rem × 3rem). Full-width text. Mathematically even — optically left-heavy.',
  },
  {
    variant: 'd3-a' as const,
    tag: 'D3-A · Symmetric reading measure',
    note: '38rem measure block centered in panel. Headline, meta, lede, takeaways, and body share one width.',
  },
  {
    variant: 'd3-b' as const,
    tag: 'D3-B · Increased left padding',
    note: 'Asymmetric gutter: +1.25rem left padding vs right. Compensates for serif stem weight and bullet indent.',
  },
  {
    variant: 'd3-c' as const,
    tag: 'D3-C · Centered reading column',
    note: '34rem column centered independently within the panel. Publication-style optical centering.',
  },
];
---

<BaseLayout
  title="Direction D3 — Optical Alignment | Deeper Global"
  description="Optical alignment audit and D3-A/B/C variants for Direction D reading panel."
  canonicalPath="/design-evolution/direction-d3-optical"
  noindex={true}
>
  <main class="dd-page dd3-page">
    <p class="dd-eyebrow">Direction D3</p>
    <div class="dd-intro">
      <h1>Optical alignment audit</h1>
      <p class="dd-intro-lede">
        Reading panel may be mathematically centered but typography reads left-heavy. Compare four variants below.
      </p>
    </div>

    <div class="dd3-audit">
      <h2>Diagnosis</h2>
      <ul>
        <li>
          <strong>Panel padding</strong> — Current production uses equal horizontal padding (3rem). The white box is symmetric; the
          <em>text block</em> is not optically centered because content is full-bleed within the panel.
        </li>
        <li>
          <strong>Reading measure</strong> — No max-width on body copy. Long lines anchor hard to the left edge; ragged right
          creates uneven white space that reads as mass shifted left.
        </li>
        <li>
          <strong>Headline width</strong> — Serif display at 2rem spans nearly the full panel. Left vertical stems (W, h, l) add
          visual weight on the gutter side.
        </li>
        <li>
          <strong>Column alignment</strong> — Takeaway bullets use <code>padding-left</code>, pulling list mass left. Meta and
          breadcrumb are left-flush while the sidebar sits outside the panel, compounding page-level asymmetry.
        </li>
        <li>
          <strong>Optical centering</strong> — Mathematical center ≠ perceived center for serif headlines + indented lists.
          Premium publications center a <em>measure</em>, not a container.
        </li>
      </ul>

      <table class="dd3-compare-table">
        <thead>
          <tr>
            <th>Variant</th>
            <th>Panel padding</th>
            <th>Measure</th>
            <th>Optical strategy</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Baseline</td>
            <td>2.5rem × 3rem symmetric</td>
            <td>Full panel width</td>
            <td>Current Direction D</td>
          </tr>
          <tr>
            <td>D3-A</td>
            <td>2.5rem × 2rem; content centered</td>
            <td>38rem shared block</td>
            <td>Symmetric measure — all elements same width</td>
          </tr>
          <tr>
            <td>D3-B</td>
            <td>Left +5rem, right 2.5rem</td>
            <td>40rem max</td>
            <td>Gutter compensation for serif + bullets</td>
          </tr>
          <tr>
            <td>D3-C</td>
            <td>3rem × 2rem; flex center</td>
            <td>34rem column</td>
            <td>Independent column — Atlantic-style</td>
          </tr>
        </tbody>
      </table>
    </div>

    {
      variants.map((item) => (
        <AnswerDirectionDMock mock={mock} variant={item.variant} tag={item.tag} note={item.note} />
      ))
    }

    <p class="dd-intro-lede dd-footer-links">
      <a href="/design-evolution/direction-d/">← Direction D</a>
      ·
      <a href="/answers/how-do-i-handle-anxiety-without-using-substances/">Production answer</a>
    </p>
  </main>
</BaseLayout>
