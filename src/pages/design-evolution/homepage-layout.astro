---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/homepage-layout.css';

const mockRows = [
  {
    title: 'Can trauma look like ADHD',
    summary:
      'Trauma can produce symptoms that closely resemble ADHD, including difficulty concentrating, restlessness, and impulsivity.',
    meta: 'Neurodivergence & Attention · Updated June 19, 2026',
  },
  {
    title: 'How do I build routines with ADHD',
    summary:
      'Building routines with ADHD is harder than standard advice suggests, because the ADHD brain resists repetition once novelty fades.',
    meta: 'Neurodivergence & Attention · Updated June 19, 2026',
  },
];

const searchVariants = [
  { id: 'search-560', width: '560px', rec: true, note: 'Supports the headline; search reads as a tool, not the hero focal point.' },
  { id: 'search-620', width: '620px', rec: false, note: 'Current width. Reads heavier and competes with the headline block.' },
];

const containerVariants = [
  { id: 'body-1120', width: '1120px', rec: false, note: 'Current container. Body columns feel tight on wide screens.' },
  { id: 'body-1180', width: '1180px', rec: true, note: '+60px per side. Topic directory and featured answer breathe without feeling stretched.' },
];
---

<BaseLayout
  title="Homepage Layout Comparison | Deeper Global"
  description="Side-by-side comparison of homepage search width and body container options."
  canonicalPath="/design-evolution/homepage-layout"
  noindex={true}
>
  <main class="hl-page">
    <p class="eyebrow">Design evolution · homepage layout</p>
    <h1>Search width &amp; body container</h1>
    <p class="hl-lede">
      Refinement pass for a generous, calm, editorial homepage. Answer page widths unchanged.
      Production homepage applies the combined recommendation below.
    </p>

    <aside class="hl-verdict" aria-label="Recommendation">
      <h2>Recommended combination</h2>
      <p><strong>Search:</strong> 560px max-width — supports the headline without dominating the hero.</p>
      <p><strong>Body container:</strong> 1180px — answer list, featured answer, and topic directory use space more efficiently.</p>
      <p><strong>Supporting refinements:</strong> increased row rhythm, wider excerpt measure, lighter topic counts, larger category headings.</p>
    </aside>

    <section class="hl-section" id="search" aria-labelledby="search-heading">
      <div class="hl-section-head">
        <h2 id="search-heading">Hero search width</h2>
        <p>Same headline and subhead. Only search field width changes.</p>
      </div>
      <div class="hl-grid hl-grid--2">
        {
          searchVariants.map((variant) => (
            <div class={`hl-panel hl-${variant.id}`}>
              <div class="hl-panel-label">
                <strong>{variant.width}</strong>
                {variant.rec ? <span class="hl-rec">Recommended</span> : <span>Current</span>}
              </div>
              <div class="hl-panel-body">
                <div class="hl-hero-mock">
                  <h3>Answers to the questions you ask before you seek care.</h3>
                  <p>Evidence-informed, human-written answers for the real questions people carry.</p>
                  <form class="hero-search" action="/answers/" method="get" role="search" aria-label="Search preview">
                    <input type="search" placeholder="What does anxiety actually feel like?" readonly tabindex="-1" />
                    <button type="button" aria-hidden="true" tabindex="-1"><span aria-hidden="true">⌕</span></button>
                  </form>
                </div>
                <p style="margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--d-muted); line-height: 1.6;">
                  {variant.note}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="hl-section" id="container" aria-labelledby="container-heading">
      <div class="hl-section-head">
        <h2 id="container-heading">Body container width</h2>
        <p>Answer list and topic directory at 1120px vs 1180px. Hero alignment follows the same container.</p>
      </div>
      <div class="hl-grid hl-grid--2">
        {
          containerVariants.map((variant) => (
            <div class={`hl-panel hl-${variant.id}`}>
              <div class="hl-panel-label">
                <strong>{variant.width}</strong>
                {variant.rec ? <span class="hl-rec">Recommended</span> : <span>Current</span>}
              </div>
              <div class="hl-panel-body">
                <div class={`hl-body-mock ${variant.id === 'body-1180' ? 'hl-body-1180' : ''}`}>
                  <div class="hl-section-header">
                    <p class="eyebrow">What people are asking</p>
                    <h4>Start with what matters to you.</h4>
                  </div>
                  {
                    mockRows.map((row) => (
                      <article class="hl-mock-row">
                        <h5 class="hl-mock-row-title">{row.title}</h5>
                        <p class="hl-mock-row-summary">{row.summary}</p>
                        <p class="hl-mock-row-meta">{row.meta}</p>
                      </article>
                    ))
                  }
                  <div class="hl-mock-topic">
                    <div>
                      <h5>Mood &amp; emotional health</h5>
                      <div class="hl-mock-topic-item"><span>Anxiety &amp; Stress</span><span>146</span></div>
                      <div class="hl-mock-topic-item"><span>Depression</span><span>114</span></div>
                    </div>
                    <div>
                      <h5>Relationships &amp; family</h5>
                      <div class="hl-mock-topic-item"><span>Relationships &amp; Communication</span><span>158</span></div>
                      <div class="hl-mock-topic-item"><span>Family &amp; Parenting</span><span>49</span></div>
                    </div>
                  </div>
                </div>
                <p style="margin: var(--space-4) 0 0; font-size: var(--text-sm); color: var(--d-muted); line-height: 1.6;">
                  {variant.note}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="hl-section" id="combined" aria-labelledby="combined-heading">
      <div class="hl-section-head">
        <h2 id="combined-heading">Combined winner</h2>
        <p>560px search + 1180px body container — applied to the live homepage.</p>
      </div>
      <div class="hl-panel hl-combined">
        <div class="hl-panel-label">
          <strong>560px search · 1180px container</strong>
          <span class="hl-rec">Production target</span>
        </div>
        <div class="hl-panel-body">
          <div class="hl-hero-mock hl-search-560" style="margin-bottom: var(--space-6);">
            <h3>Answers to the questions you ask before you seek care.</h3>
            <p>Evidence-informed, human-written answers for the real questions people carry.</p>
            <form class="hero-search" action="/answers/" method="get" role="search" aria-label="Search preview">
              <input type="search" placeholder="What does anxiety actually feel like?" readonly tabindex="-1" />
              <button type="button" aria-hidden="true" tabindex="-1"><span aria-hidden="true">⌕</span></button>
            </form>
          </div>
          <div class="hl-body-mock hl-body-1180">
            <div class="hl-section-header">
              <p class="eyebrow">What people are asking</p>
              <h4>Start with what matters to you.</h4>
            </div>
            {
              mockRows.map((row) => (
                <article class="hl-mock-row">
                  <h5 class="hl-mock-row-title">{row.title}</h5>
                  <p class="hl-mock-row-summary">{row.summary}</p>
                  <p class="hl-mock-row-meta">{row.meta}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <p style="font-size: var(--text-sm); color: var(--d-muted);">
      <a href="/" style="color: var(--d-link);">← Live homepage</a>
    </p>
  </main>
</BaseLayout>
