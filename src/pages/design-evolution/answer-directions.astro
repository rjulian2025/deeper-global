---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/design-evolution.css';

const mock = {
  title: 'What does anxiety actually feel like?',
  topic: 'Anxiety',
  reviewer: 'Dr. Ken Christian',
  updated: 'June 2026',
  sources: 3,
  lede:
    'Anxiety is not only worry in your thoughts. For many people it shows up in the body first — tight chest, restlessness, difficulty sleeping — before they have language for what is happening.',
  takeaways: [
    'Physical symptoms (racing heart, shallow breathing, muscle tension) are common and real.',
    'Anxiety and stress overlap, but anxiety often persists after the immediate trigger passes.',
    'Naming the sensation can reduce fear of the sensation itself — a core loop in many anxiety patterns.',
    'When symptoms interfere with sleep, work, or relationships for weeks, professional evaluation helps.',
    'This answer describes patterns, not a diagnosis of your experience.',
  ],
  sections: [
    {
      id: 'experiencing',
      title: 'What you might be experiencing',
      body:
        'People often describe a sense of impending danger without a clear source. Your nervous system may feel switched on — hypervigilant, irritable, or unable to settle. Some notice gastrointestinal discomfort, headaches, or tingling. Others describe emotional numbness alternating with sudden fear.',
    },
    {
      id: 'help',
      title: 'What can help',
      body:
        'Grounding in the body (slow breathing, orienting to the room, reducing caffeine late in the day) can lower acute activation. Structured routines around sleep and movement often stabilize baseline arousal. Therapy approaches such as CBT can address the thought patterns that maintain anxiety over time.',
    },
  ],
  related: [
    'Why do I feel anxious for no reason?',
    'How do I know if I need therapy?',
    'What is the difference between stress and anxiety?',
  ],
  care:
    'This answer is for understanding, not crisis care. If you are in immediate danger or thinking about harming yourself, contact emergency services or 988 in the U.S.',
};
---

<BaseLayout
  title="Design Evolution — Answer Page Directions | Deeper Global"
  description="Three competing visual directions for Deeper answer pages: Editorial Institution, Mental Landscape, and Premium Knowledge Platform."
  canonicalPath="/design-evolution/answer-directions"
  noindex={true}
  noAnalytics={true}
>
  <main class="de-index">
    <p class="eyebrow">Design evolution</p>
    <h1>Answer page directions</h1>
    <p class="de-index-lede">
      Three visual directions applied to the same representative answer. Compare typography, metadata, sidebar IA,
      and landscape motifs. These are prototypes — not production pages.
    </p>

    <nav class="de-nav" aria-label="Jump to direction">
      <a href="#direction-a">Direction A — Editorial Institution</a>
      <a href="#direction-b">Direction B — Mental Landscape</a>
      <a href="#direction-c">Direction C — Premium Knowledge Platform</a>
      <a href="/design-evolution/typography-round/">Typography round →</a>
    </nav>

    <!-- Direction A -->
    <section class="de-comparison-section" id="direction-a">
      <div class="de-direction-label">
        <h2>Direction A</h2>
        <span class="de-ref">Editorial Institution</span>
        <p>New York Times + Mayo Clinic — gravitas, bylines, margin discipline</p>
      </div>

      <div class="de-frame de-a">
        <div class="de-frame-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          deeper.global/answers/what-does-anxiety-feel-like — Direction A
        </div>
        <article class="de-answer de-answer-inner de-graticule">
          <nav class="de-breadcrumb" aria-label="Breadcrumb">
            <a href="#">Deeper Global</a> / <a href="#">{mock.topic}</a> / {mock.title}
          </nav>

          <div class="de-main-col">
            <h1 class="de-title">{mock.title}</h1>
            <p class="de-meta">
              <a href="#">{mock.topic}</a>
              <span class="de-meta-sep">·</span>
              Reviewed by <a href="#">{mock.reviewer}</a>
              <span class="de-meta-sep">·</span>
              Updated {mock.updated}
              <span class="de-meta-sep">·</span>
              {mock.sources} sources
            </p>

            <p class="de-lede">{mock.lede}</p>

            <aside class="de-takeaways" aria-labelledby="a-takeaways">
              <p class="de-takeaways-label" id="a-takeaways">Key takeaways</p>
              <ul>
                {mock.takeaways.map((item) => <li>{item}</li>)}
              </ul>
            </aside>

            {
              mock.sections.map((section) => (
                <>
                  <h2 class="de-section-title">{section.title}</h2>
                  <div class="de-body">
                    <p>{section.body}</p>
                  </div>
                </>
              ))
            }
          </div>

          <aside class="de-sidebar" aria-label="Answer context">
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Review</p>
              <p class="de-care" style="color: var(--ink); margin-bottom: var(--space-2);">
                Clinically reviewed by <a href="#">{mock.reviewer}</a>
              </p>
              <p class="de-care">Last reviewed {mock.updated}</p>
            </div>
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Questions people ask next</p>
              <ul class="de-sidebar-list">
                {mock.related.map((q) => (
                  <li><a href="#">{q}</a></li>
                ))}
              </ul>
            </div>
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Not a substitute for care</p>
              <p class="de-care">{mock.care}</p>
            </div>
          </aside>
        </article>
      </div>
    </section>

    <!-- Direction B -->
    <section class="de-comparison-section" id="direction-b">
      <div class="de-direction-label">
        <h2>Direction B</h2>
        <span class="de-ref">Mental Landscape</span>
        <p>Topography + weather + human understanding — ownable Deeper territory</p>
      </div>

      <div class="de-frame de-b">
        <div class="de-frame-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          deeper.global/answers/what-does-anxiety-feel-like — Direction B
        </div>
        <article class="de-answer de-answer-inner">
          <nav class="de-breadcrumb" aria-label="Breadcrumb">
            <a href="#">Deeper Global</a> / <a href="#">{mock.topic}</a>
          </nav>
          <p class="de-conditions">
            Conditions in <strong>{mock.topic}</strong> · aggregate topic context · not a personal reading
          </p>

          <div class="de-main-col">
            <h1 class="de-title">{mock.title}</h1>
            <p class="de-meta">
              <a href="#">{mock.topic}</a>
              <span class="de-meta-sep">·</span>
              Reviewed by <a href="#">{mock.reviewer}</a>
              <span class="de-meta-sep">·</span>
              Updated {mock.updated}
            </p>

            <p class="de-lede">{mock.lede}</p>

            <aside class="de-takeaways" aria-labelledby="b-takeaways">
              <p class="de-takeaways-label" id="b-takeaways">Key takeaways</p>
              <ul>
                {mock.takeaways.slice(0, 4).map((item) => <li>{item}</li>)}
              </ul>
            </aside>

            {
              mock.sections.map((section) => (
                <>
                  <h2 class="de-section-title">{section.title}</h2>
                  <div class="de-body">
                    <p>{section.body}</p>
                  </div>
                </>
              ))
            }
          </div>

          <aside class="de-sidebar" aria-label="Answer context">
            <p class="de-pressure-note">
              Related questions in this concern cluster share similar language patterns — not identical experiences.
            </p>
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Continue reading</p>
              <ul class="de-sidebar-list">
                {mock.related.map((q) => (
                  <li><a href="#">{q}</a></li>
                ))}
              </ul>
            </div>
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Care note</p>
              <p class="de-care">{mock.care}</p>
            </div>
          </aside>
        </article>
      </div>
    </section>

    <!-- Direction C -->
    <section class="de-comparison-section" id="direction-c">
      <div class="de-direction-label">
        <h2>Direction C</h2>
        <span class="de-ref">Premium Knowledge Platform</span>
        <p>Notion + Linear + research institute — IA clarity, quiet UI</p>
      </div>

      <div class="de-frame de-c">
        <div class="de-frame-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          deeper.global/answers/what-does-anxiety-feel-like — Direction C
        </div>
        <article class="de-answer de-answer-inner">
          <nav class="de-toc" aria-label="On this page">
            <p class="de-toc-label">On this page</p>
            <ol>
              <li><a href="#" class="is-active">Overview</a></li>
              <li><a href="#">Key takeaways</a></li>
              {mock.sections.map((s) => (
                <li><a href="#">{s.title}</a></li>
              ))}
              <li><a href="#">Sources</a></li>
            </ol>
          </nav>

          <div class="de-main">
            <nav class="de-breadcrumb" aria-label="Breadcrumb">
              {mock.topic} / Answer
            </nav>
            <h1 class="de-title">{mock.title}</h1>
            <p class="de-meta">
              {mock.topic}
              <span class="de-meta-sep">·</span>
              {mock.reviewer}
              <span class="de-meta-sep">·</span>
              {mock.updated}
              <span class="de-meta-sep">·</span>
              Ref ANX-042
            </p>
            <p class="de-lede">{mock.lede}</p>

            <aside class="de-takeaways" aria-labelledby="c-takeaways">
              <p class="de-takeaways-label" id="c-takeaways">Key takeaways</p>
              <ul>
                {mock.takeaways.slice(0, 4).map((item) => <li>{item}</li>)}
              </ul>
            </aside>

            {
              mock.sections.map((section) => (
                <>
                  <h2 class="de-section-title">{section.title}</h2>
                  <div class="de-body">
                    <p>{section.body}</p>
                  </div>
                </>
              ))
            }
          </div>

          <aside class="de-sidebar" aria-label="Metadata">
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Trust</p>
              <p class="de-care" style="color: var(--ink);">
                Reviewed by {mock.reviewer}<br />
                Updated {mock.updated}<br />
                {mock.sources} cited sources
              </p>
            </div>
            <div class="de-sidebar-block">
              <p class="de-sidebar-heading">Related</p>
              <ul class="de-sidebar-list">
                {mock.related.map((q) => (
                  <li><a href="#">{q}</a></li>
                ))}
              </ul>
            </div>
            <div class="de-sidebar-block de-care-block">
              <p class="de-sidebar-heading">Care</p>
              <p class="de-care">{mock.care}</p>
            </div>
          </aside>
        </article>
      </div>
    </section>

    <section class="de-comparison-section">
      <h2 class="de-section-title" style="margin-top: 0;">Decision guide</h2>
      <div class="de-body" style="max-width: 42rem;">
        <p>
          <strong>Choose A</strong> if clinical credibility and publishing gravitas are the immediate priority — fastest
          evolution from today’s content with minimal visual risk.
        </p>
        <p>
          <strong>Choose B</strong> if differentiation and brand memory matter most — pairs with Psychology Weather Map
          and the Deeper name; requires strict contour discipline.
        </p>
        <p>
          <strong>Choose C</strong> if power-user navigation and citation density are primary — best for researchers,
          clinicians, and AI systems citing structured answers; warm up with paper tokens to avoid cold SaaS.
        </p>
        <p>
          <strong>Recommended hybrid:</strong> A’s metadata and typography + B’s 4% contour atmosphere + C’s sidebar
          section IA. See <code>DESIGN_REFACTOR_PLAN.md</code> Phase 1–4.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .de-index .eyebrow {
    margin-bottom: var(--space-4);
  }
</style>
