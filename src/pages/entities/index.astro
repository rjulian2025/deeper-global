---
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntitySummaries } from '@/lib/content';
import { siteUrl } from '@/lib/site';
import { getQuestions } from '@/lib/supabase';

const questions = await getQuestions();
const entities = getEntitySummaries(questions);
const jsonLd = {
  '@type': 'DefinedTermSet',
  name: 'Deeper Global Mental Health Topic Map',
  url: siteUrl('/entities'),
  hasDefinedTerm: entities.map((entity) => ({
    '@type': 'DefinedTerm',
    name: entity.name,
    url: siteUrl(`/entities/${entity.slug}`),
    alternateName: entity.sameAs,
  })),
};
---

<BaseLayout
  title="Mental Health Themes | Deeper Global"
  description="Mental health themes that organize Deeper Global answers into clearer paths for exploration and understanding."
  canonicalPath="/entities"
  jsonLd={jsonLd}
  noindex={true}
>
  <main class="discovery-surface hub-page">
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">Themes</p>
        <h1>Explore the patterns behind mental health questions</h1>
        <p class="lede">
          Themes connect related questions, language, and answers so you can keep exploring what feels relevant to you.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {
          entities.length ? (
            <div class="discovery-list category-directory">
              {
                entities.map((entity) => (
                  <article class="discovery-row category-directory-row">
                    <h2 class="discovery-row-title">
                      <a href={`/entities/${entity.slug}/`} data-ai-entity={entity.name}>{entity.name}</a>
                    </h2>
                    <p class="discovery-summary">
                      Explore answers about {entity.name.toLowerCase()}.
                    </p>
                  </article>
                ))
              }
            </div>
          ) : (
            <EmptyState
              title="No theme data available yet"
              message="Themes are generated from Supabase categories when corpus credentials are available."
            />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
