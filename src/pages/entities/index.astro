---
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getEntitySummaries, pluralizeAnswer } from '@/lib/content';
import { siteUrl } from '@/lib/site';
import { getQuestions } from '@/lib/supabase';

const questions = await getQuestions();
const entities = getEntitySummaries(questions);
const jsonLd = {
  '@type': 'DefinedTermSet',
  name: 'Deeper Global Mental Health Topic Map',
  url: siteUrl('/entities'),
  hasDefinedTerm: entities.map((entity) => ({
    '@type': 'DefinedTerm',
    name: entity.name,
    url: siteUrl(`/entities/${entity.slug}`),
    alternateName: entity.sameAs,
  })),
};
---

<BaseLayout
  title="Mental Health Themes | Deeper Global"
  description="Mental health themes that organize Deeper Global answers into clearer paths for exploration and understanding."
  canonicalPath="/entities"
  jsonLd={jsonLd}
  noindex={true}
>
  <main>
    <section class="hero">
      <div class="container">
        <p class="eyebrow">Themes</p>
        <h1>Explore the patterns behind mental health questions.</h1>
        <p class="lede">Themes connect related questions, language, and answers so you can keep exploring what feels relevant to you.</p>
      </div>
    </section>

    <section class="section">
      <div class="container grid">
        {
          entities.length ? (
            entities.map((entity) => (
              <a class="card entity-card" href={`/entities/${entity.slug}/`} data-ai-entity={entity.name}>
                <h3>{entity.name}</h3>
                <p>{entity.description}</p>
                <div class="meta-row">
                  <span class="pill">{pluralizeAnswer(entity.count)}</span>
                  <span class="pill">Theme</span>
                </div>
              </a>
            ))
          ) : (
            <EmptyState title="No theme data available yet" message="Themes are generated from Supabase categories when corpus credentials are available." />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
