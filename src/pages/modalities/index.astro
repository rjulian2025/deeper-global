---
import ModalityHubPage from '@/components/modality-hub/ModalityHubPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildModalityHubJsonLd } from '@/lib/modality-hub-jsonld';
import { buildModalityHubPageData } from '@/lib/modality-hub-page';
import { getModalityHubConfig } from '@/lib/topic-hubs/modalities';
import { getModalities, getQuestions } from '@/lib/supabase';

const config = getModalityHubConfig();
const [modalities, questions] = await Promise.all([getModalities(), getQuestions()]);
const hub = buildModalityHubPageData(config, modalities, questions);
const jsonLd = buildModalityHubJsonLd(config, hub);
---

<BaseLayout
  title="How Therapy Actually Works | Deeper Global"
  description={config.jsonLdDescription}
  canonicalPath={config.path}
  jsonLd={jsonLd}
>
  <ModalityHubPage hub={hub} />
</BaseLayout>
