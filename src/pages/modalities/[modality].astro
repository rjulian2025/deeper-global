---
import SourceRefsBlock from '@/components/sidebar/SourceRefsBlock.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { answerPath, getAnswerDisplayTitle } from '@/lib/content';
import {
  buildModalityDetailJsonLd,
  getRelatedModalities,
  getRelatedQuestionsForModality,
  modalityCategoryAnchor,
  modalityCategoryLabels,
  modalityPath,
} from '@/lib/modality-hub';
import type { SourceRef } from '@/lib/trust';
import { getModalities, getQuestions, type Modality } from '@/lib/supabase';

export async function getStaticPaths() {
  const modalities = await getModalities();
  return modalities.map((modality) => ({
    params: { modality: modality.slug },
    props: { modality },
  }));
}

const { modality } = Astro.props as { modality: Modality };

const [allModalities, questions] = await Promise.all([getModalities(), getQuestions()]);
const relatedModalities = getRelatedModalities(modality, allModalities);
const relatedQuestions = getRelatedQuestionsForModality(modality, questions);

const displayLede = modality.staging_lede ?? modality.lede ?? null;
const displayWhatItIs = modality.staging_what_it_is ?? modality.what_it_is ?? null;
const displaySession = modality.staging_what_a_session_looks_like ?? modality.what_a_session_looks_like ?? null;
const displayTreats = modality.staging_what_it_treats ?? modality.what_it_treats ?? null;
const displayEvidence = modality.staging_what_the_evidence_says ?? modality.what_the_evidence_says ?? null;
const displayWhoFor = modality.staging_who_it_is_for ?? modality.who_it_is_for ?? null;
const displayHowToFind = modality.staging_how_to_find_a_practitioner ?? modality.how_to_find_a_practitioner ?? null;
const displayTakeaways = modality.staging_key_takeaways ?? modality.key_takeaways ?? null;

const title = `${modality.name} | Deeper Global`;
const description = modality.meta_description ?? modality.schema_description ?? '';
const sourceRefs: SourceRef[] = (Array.isArray(modality.source_refs) ? modality.source_refs : [])
  .map((item) => {
    if (!item || typeof item !== 'object') return null;
    const record = item as Record<string, unknown>;
    const refTitle = typeof record.title === 'string' ? record.title.trim() : '';
    const url = typeof record.url === 'string' ? record.url.trim() : '';
    const publisher = typeof record.publisher === 'string' ? record.publisher.trim() : '';
    if (!refTitle && !url) return null;
    return { title: refTitle || url, url, publisher };
  })
  .filter((item): item is SourceRef => Boolean(item));
const categoryLabel = modalityCategoryLabels[modality.category] ?? modality.category;
const jsonLd = buildModalityDetailJsonLd({ modality, relatedModalities, relatedQuestions });
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={modalityPath(modality.slug)}
  noindex={modality.noindex}
  jsonLd={jsonLd}
>
  <main class="answer-page answer-page--direction-d modality-page">
    <nav class="answer-breadcrumbs container" aria-label="Breadcrumb">
      <a href="/">Deeper Global</a>
      <span aria-hidden="true">/</span>
      <a href="/modalities/">Modalities</a>
      <span aria-hidden="true">/</span>
      <span>{modality.name}</span>
    </nav>

    <article class="answer-layout answer-layout--direction-d container modality-page-layout">
      <div class="answer-reading-panel modality-page-main">
        <div class="answer-reading-column">
          <p class="editorial-meta">
            <a href={modalityCategoryAnchor(modality.category)}>{categoryLabel}</a>
            {
              modality.also_known_as?.length ? (
                <>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  Also known as: {modality.also_known_as.join(', ')}
                </>
              ) : null
            }
          </p>

          <h1>{modality.name}</h1>

          {displayLede ? <p class="answer-lede">{displayLede}</p> : null}

          {
            displayTakeaways?.length ? (
              <section class="takeaways-rule" aria-labelledby="modality-takeaways-title">
                <h2 class="takeaways-rule-label" id="modality-takeaways-title">Key takeaways</h2>
                <ul>
                  {displayTakeaways.map((takeaway) => <li>{takeaway}</li>)}
                </ul>
              </section>
            ) : null
          }

          {
            displayWhatItIs ? (
              <section class="answer-section modality-content-section" id="what-it-is">
                <h2>What it is</h2>
                {displayWhatItIs.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ) : null
          }

          {
            displaySession ? (
              <section class="answer-section modality-content-section" id="what-a-session-looks-like">
                <h2>What a session looks like</h2>
                {displaySession.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ) : null
          }

          {
            displayTreats ? (
              <section class="answer-section modality-content-section" id="what-it-treats">
                <h2>What it treats</h2>
                {displayTreats.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ) : null
          }

          {
            displayEvidence ? (
              <section class="answer-section modality-content-section" id="what-the-evidence-says">
                <h2>What the evidence says</h2>
                {displayEvidence.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ) : null
          }

          {
            displayWhoFor ? (
              <section class="answer-section modality-content-section" id="who-it-is-for">
                <h2>Who it is for</h2>
                {displayWhoFor.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ) : null
          }

          {
            displayHowToFind ? (
              <section class="answer-section modality-content-section" id="how-to-find-a-practitioner">
                <h2>How to find a practitioner</h2>
                {displayHowToFind.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
              </section>
            ) : null
          }
        </div>
      </div>

      <aside class="answer-sidebar modality-page-sidebar" aria-label="Modality context">
        <section class="sidebar-block">
          <p class="sidebar-block-heading">Browse cluster</p>
          <p class="sidebar-block-text">
            <a href="/modalities/">All therapy modalities</a>
          </p>
          <p class="sidebar-block-text">Explore evidence-based, somatic, integrative, and emerging approaches.</p>
          <p class="sidebar-block-text">
            <a href={modalityCategoryAnchor(modality.category)}>More {categoryLabel.toLowerCase()}</a>
          </p>
        </section>

        {
          relatedModalities.length ? (
            <section class="sidebar-block">
              <p class="sidebar-block-heading">Related modalities</p>
              <ul class="sidebar-block-list">
                {
                  relatedModalities.map((related) => (
                    <li>
                      <a href={`${modalityPath(related.slug)}/`}>{related.name}</a>
                    </li>
                  ))
                }
              </ul>
            </section>
          ) : null
        }

        {
          relatedQuestions.length ? (
            <section class="sidebar-block" data-ai-section="related-questions">
              <p class="sidebar-block-heading">Related questions</p>
              <ul class="sidebar-block-list">
                {
                  relatedQuestions.map((question) => (
                    <li>
                      <a href={answerPath(question.slug)}>{getAnswerDisplayTitle(question)}</a>
                    </li>
                  ))
                }
              </ul>
            </section>
          ) : null
        }

        <SourceRefsBlock sources={sourceRefs} />

        <section class="sidebar-block sidebar-block--care">
          <p class="sidebar-block-heading">Find a therapist</p>
          <p class="sidebar-block-text">Browse therapists on Deeper who list training in {modality.name}.</p>
          <p class="sidebar-block-text"><a href="/answers/">Browse on Deeper</a></p>
        </section>

        {
          modality.ymyl_flagged ? (
            <section class="sidebar-block sidebar-block--care modality-ymyl">
              <p class="sidebar-block-heading">Clinical guidance recommended</p>
              <p class="sidebar-block-text">
                This treatment involves medical or safety considerations. Consult a qualified professional before pursuing
                this approach.
              </p>
            </section>
          ) : null
        }
      </aside>
    </article>
  </main>
</BaseLayout>
