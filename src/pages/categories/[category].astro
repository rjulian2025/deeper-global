---
import DiscoveryRow from '@/components/DiscoveryRow.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { displayCategory, answerPath, getAnswerDisplayTitle, getCategoryMetaDescription, getCategorySummaries, slugify } from '@/lib/content';
import { getCategoryFeaturedAnswers, getCategoryHubSections } from '@/lib/category-hub-links';
import { filterPublishableQuestions } from '@/lib/indexing-policy';
import { siteUrl, websiteId } from '@/lib/site';
import { getQuestions, type Question } from '@/lib/supabase';

export async function getStaticPaths() {
  const questions = filterPublishableQuestions(await getQuestions());
  const categories = getCategorySummaries(questions);

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      categoryName: category.name,
      questions: questions.filter((question) => displayCategory(question) === category.name),
    },
  }));
}

const categoryName = Astro.props.categoryName as string | undefined;
const questions = (Astro.props.questions ?? []) as Question[];
const allQuestions = filterPublishableQuestions(await getQuestions());
const hubSections = categoryName ? getCategoryHubSections(categoryName, allQuestions) : [];
const featuredAnswers = categoryName ? getCategoryFeaturedAnswers(categoryName, questions) : questions;

if (!categoryName && !questions.length) {
  return Astro.redirect('/categories');
}

const resolvedCategory = categoryName ?? Astro.params.category ?? 'Topic';
const categoryUrl = siteUrl(`/categories/${slugify(resolvedCategory)}`);
const description = getCategoryMetaDescription(resolvedCategory, questions.length);
const jsonLd = {
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${categoryUrl}#collection`,
      url: categoryUrl,
      name: `${resolvedCategory} questions and answers`,
      description,
      isPartOf: {
        '@id': websiteId(),
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: questions.length,
        itemListElement: questions.slice(0, 24).map((question, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: siteUrl(`/answers/${question.slug}`),
          name: getAnswerDisplayTitle(question),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${categoryUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Deeper Global',
          item: siteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Topics',
          item: siteUrl('/categories'),
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: resolvedCategory,
          item: categoryUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${resolvedCategory} Questions and Answers | Deeper Global`}
  description={description}
  canonicalPath={`/categories/${slugify(resolvedCategory)}`}
  jsonLd={jsonLd}
  noindex={true}
>
  <main class="discovery-surface categories-page">
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">Topic hub</p>
        <h1>{resolvedCategory}</h1>
        <p class="lede">
          Common questions, patterns, and care-seeking language around {resolvedCategory.toLowerCase()}.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {
          hubSections.length ? (
            <div class="hub-sections">
              {hubSections.map((section) => (
                <section class="hub-section">
                  <p class="hub-section-eyebrow">
                    <a href={section.hubPath}>{section.hubTitle}</a>
                  </p>
                  <h2 class="hub-section-title">{section.clusterName}</h2>
                  <p class="hub-section-desc">{section.clusterDescription}</p>
                  <ul class="hub-section-questions">
                    {section.questions.map((question) => (
                      <li>
                        <a href={answerPath(question.slug)}>{getAnswerDisplayTitle(question)}</a>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          ) : null
        }

        <div class="discovery-list answer-list">
          {featuredAnswers.map((question) => <DiscoveryRow question={question} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
