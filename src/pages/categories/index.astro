---
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryPath, getCategorySummaries } from '@/lib/content';
import { getQuestions } from '@/lib/supabase';

const questions = await getQuestions();
const categories = getCategorySummaries(questions);
---

<BaseLayout
  title="Mental Health Topics | Deeper Global"
  description="Browse Deeper Global mental health topic hubs generated from the answer corpus."
  canonicalPath="/categories"
  noindex={true}
>
  <main class="discovery-surface categories-page">
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">Browse by topic</p>
        <h1>What are you carrying right now?</h1>
        <p class="lede">
          Every topic below is a territory — a place to start when you need language, context, or a clearer next step.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        {
          categories.length ? (
            <div class="discovery-list category-directory">
              {
                categories.map((category) => (
                  <article class="discovery-row category-directory-row">
                    <h2 class="discovery-row-title">
                      <a href={categoryPath(category.name)}>{category.name}</a>
                    </h2>
                    <p class="discovery-summary">
                      Explore answers about {category.name.toLowerCase()}.
                    </p>
                  </article>
                ))
              }
            </div>
          ) : (
            <EmptyState
              title="No topic data available yet"
              message="Topic hubs are generated from Supabase categories once content credentials are available during build."
            />
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
