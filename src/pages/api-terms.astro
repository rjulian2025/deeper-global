---
import EditorialStaticLayout from '@/components/editorial/EditorialStaticLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteUrl, websiteId } from '@/lib/site';

const title = 'Deeper API Terms | Deeper Global';
const description =
  'Terms and usage boundaries for Deeper API developer preview access, attribution, commercial use, and safety limits.';
const jsonLd = {
  '@type': 'WebPage',
  '@id': `${siteUrl('/api-terms/')}#webpage`,
  url: siteUrl('/api-terms/'),
  name: title,
  description,
  isPartOf: {
    '@id': websiteId(),
  },
};
---

<BaseLayout title={title} description={description} canonicalPath="/api-terms/" jsonLd={jsonLd}>
  <EditorialStaticLayout
    eyebrow="API terms"
    title="Developer preview terms for Deeper API."
    lede="Deeper API is public educational content infrastructure for retrieval, citation, topic mapping, and developer evaluation. It is not a clinical, diagnostic, crisis, emergency, or care-delivery system."
    class="editorial-static-page--terms"
    wide={true}
  >
    <div class="terms-grid">
      <article class="terms-panel">
        <h2>Permitted use</h2>
        <p>
          You may use public preview endpoints for evaluation, prototypes, search, retrieval,
          citation, and non-diagnostic educational summaries that preserve Deeper Global
          attribution and canonical URLs.
        </p>
      </article>

      <article class="terms-panel">
        <h2>Prohibited use</h2>
        <p>
          Do not use Deeper API to diagnose, treat, triage emergencies, replace professional
          care, imply a therapeutic relationship, remove crisis-routing language, or market a
          downstream product as clinical decision support.
        </p>
      </article>

      <article class="terms-panel">
        <h2>Attribution</h2>
        <p>
          When displaying or summarizing answer content, cite the canonical answer URL and
          preserve reviewer, source, and educational-boundary metadata when available.
        </p>
      </article>

      <article class="terms-panel">
        <h2>Commercial access</h2>
        <p>
          Public endpoints are a developer preview. Bulk use, redistribution, paid products,
          custom feeds, private support, or higher rate limits require separate commercial terms
          from Deeper Global.
        </p>
      </article>

      <article class="terms-panel">
        <h2>Rate limits</h2>
        <p>
          Public preview endpoints may enforce request limits and return <code>429</code> with
          rate-limit headers. Clients should cache responsibly and retry only after the reset
          time.
        </p>
      </article>

      <article class="terms-panel">
        <h2>No warranty</h2>
        <p>
          Deeper API is provided as-is during developer preview. Endpoint shape, availability,
          limits, and commercial terms may change before general availability.
        </p>
      </article>
    </div>
  </EditorialStaticLayout>
</BaseLayout>

<style>
  .editorial-static-page--terms .terms-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .editorial-static-page--terms .terms-panel {
    border: 1px solid var(--d-line);
    border-radius: 2px;
    padding: var(--space-5);
    background: var(--d-surface);
  }

  .editorial-static-page--terms .terms-panel h2 {
    margin-top: 0;
    border: none;
    padding: 0;
  }

  .editorial-static-page--terms .terms-panel p {
    margin-top: 0;
  }

  .editorial-static-page--terms .terms-panel code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
</style>
