---
import EditorialStaticLayout from '@/components/editorial/EditorialStaticLayout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN ?? '';
const API_BASE = import.meta.env.DEV ? 'http://127.0.0.1:3001' : '';
---

<BaseLayout
  title="Psychology Weather Map | Deeper Global"
  description="Explore aggregate mental health question demand by geography and topic across Deeper Global."
  canonicalPath="/weather-map"
>
  <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" />
  <EditorialStaticLayout
    eyebrow="Psychology Weather Map"
    title="Where mental health questions cluster."
    lede="Aggregate answer-view signals by city, state, and topic. No individual identification."
    class="editorial-static-page editorial-static-page--weather-map weather-map-page"
    wide={true}
  >
    <div class="weather-map-shell">
      <form class="weather-map-search" id="weather-map-search" role="search" aria-label="Search city or ZIP code">
        <label class="sr-only" for="weather-map-search-input">City or ZIP code</label>
        <input
          id="weather-map-search-input"
          name="q"
          type="search"
          placeholder="Search city or ZIP…"
          autocomplete="off"
        />
        <button type="submit">Go</button>
      </form>

      <div id="weather-map-root" class="weather-map-canvas" aria-label="Psychology weather map"></div>
      <div id="weather-map-tooltip" class="weather-map-tooltip" hidden></div>
      <aside
        id="weather-map-state-card"
        class="weather-map-state-card"
        hidden
        aria-live="polite"
        aria-label="State category summary"
      >
        <p class="weather-map-state-card-eyebrow">State</p>
        <h2 id="weather-map-state-card-title" class="weather-map-state-card-title"></h2>
        <ul id="weather-map-state-card-list" class="weather-map-state-card-list"></ul>
      </aside>
    </div>

    <div class="weather-map-legend" aria-label="Category legend">
      <span class="weather-map-legend-title">Categories</span>
      <ul>
        <li data-category="all" role="button" tabindex="0" aria-pressed="true" class="is-active"><span class="swatch swatch--all"></span>All</li>
        <li data-category="Anxiety &amp; Stress" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#F5A623"></span>Anxiety &amp; Stress</li>
        <li data-category="Depression" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#4A90D9"></span>Depression</li>
        <li data-category="Addiction &amp; Recovery" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#8E44AD"></span>Addiction &amp; Recovery</li>
        <li data-category="Trauma &amp; Safety" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#C0392B"></span>Trauma &amp; Safety</li>
        <li data-category="Therapy &amp; Care Navigation" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#27AE60"></span>Therapy &amp; Care Navigation</li>
        <li data-category="Identity &amp; Self-Worth" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#F39C12"></span>Identity &amp; Self-Worth</li>
        <li data-category="Relationships &amp; Communication" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#E91E63"></span>Relationships &amp; Communication</li>
        <li data-category="Family &amp; Parenting" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#FF9800"></span>Family &amp; Parenting</li>
        <li data-category="Grief &amp; Loss" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#9B59B6"></span>Grief &amp; Loss</li>
        <li data-category="Work &amp; Burnout" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#E8572A"></span>Work &amp; Burnout</li>
        <li data-category="Teens &amp; Identity" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#00BCD4"></span>Teens &amp; Identity</li>
        <li data-category="Loneliness &amp; Belonging" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#607D8B"></span>Loneliness &amp; Belonging</li>
        <li data-category="Neurodivergence &amp; Attention" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#2ECC71"></span>Neurodivergence &amp; Attention</li>
        <li data-category="Gender, Sexuality &amp; Intimacy" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#FF4081"></span>Gender, Sexuality &amp; Intimacy</li>
        <li data-category="Meaning, Faith &amp; Existential Questions" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#795548"></span>Meaning, Faith &amp; Existential Questions</li>
        <li data-category="General Mental Health" role="button" tabindex="0" aria-pressed="false"><span class="swatch" style="background:#546E7A"></span>General Mental Health</li>
      </ul>
    </div>

    <section class="weather-map-insights" aria-labelledby="weather-map-insights-heading">
      <h2 id="weather-map-insights-heading">This Week in American Mental Health</h2>
      <div class="weather-map-insights-card" id="weather-map-insights-card">
        <p class="weather-map-insights-loading">Loading insights…</p>
        <ul id="weather-map-insights-list" class="weather-map-insights-list" hidden></ul>
      </div>
    </section>
  </EditorialStaticLayout>

  <script is:inline src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>

  <script define:vars={{ MAPBOX_TOKEN, API_BASE }}>
    function initWeatherMap() {
      const CATEGORY_COLORS = {
        'Anxiety & Stress': '#F5A623',
        'Depression': '#4A90D9',
        'Addiction & Recovery': '#8E44AD',
        'Trauma & Safety': '#C0392B',
        'Therapy & Care Navigation': '#27AE60',
        'Identity & Self-Worth': '#F39C12',
        'Relationships & Communication': '#E91E63',
        'Family & Parenting': '#FF9800',
        'Grief & Loss': '#9B59B6',
        'Work & Burnout': '#E8572A',
        'Teens & Identity': '#00BCD4',
        'Loneliness & Belonging': '#607D8B',
        'Neurodivergence & Attention': '#2ECC71',
        'Gender, Sexuality & Intimacy': '#FF4081',
        'Meaning, Faith & Existential Questions': '#795548',
        'General Mental Health': '#546E7A',
      };

      const DEFAULT_COLOR = '#888888';

      const DEFAULT_THERMAL_RAMP = [
        'interpolate', ['linear'], ['heatmap-density'],
        0,   'rgba(10,14,22,0)',
        0.2, 'rgba(90,90,200,0.5)',
        0.4, 'rgba(80,160,220,0.7)',
        0.6, 'rgba(255,180,40,0.8)',
        0.8, 'rgba(255,120,40,0.9)',
        1,   'rgba(255,60,40,1)',
      ];

      const US_STATE_CENTROIDS = {
        AL: { lng: -86.9023, lat: 32.3182 },
        AK: { lng: -152.4044, lat: 61.3707 },
        AZ: { lng: -111.0937, lat: 34.0489 },
        AR: { lng: -92.3731, lat: 34.9697 },
        CA: { lng: -119.4179, lat: 36.7783 },
        CO: { lng: -105.7821, lat: 39.5501 },
        CT: { lng: -72.7554, lat: 41.6032 },
        DE: { lng: -75.5277, lat: 38.9108 },
        DC: { lng: -77.0369, lat: 38.9072 },
        FL: { lng: -81.5158, lat: 27.6648 },
        GA: { lng: -83.5007, lat: 32.1656 },
        HI: { lng: -155.5828, lat: 19.8968 },
        ID: { lng: -114.742, lat: 44.0682 },
        IL: { lng: -89.3985, lat: 40.6331 },
        IN: { lng: -86.1349, lat: 40.2672 },
        IA: { lng: -93.0977, lat: 41.878 },
        KS: { lng: -98.4842, lat: 39.0119 },
        KY: { lng: -84.27, lat: 37.8393 },
        LA: { lng: -91.8749, lat: 30.9843 },
        ME: { lng: -69.4455, lat: 45.2538 },
        MD: { lng: -76.6413, lat: 39.0458 },
        MA: { lng: -71.3824, lat: 42.4072 },
        MI: { lng: -84.5361, lat: 44.3148 },
        MN: { lng: -94.6859, lat: 46.7296 },
        MS: { lng: -89.3985, lat: 32.3547 },
        MO: { lng: -91.8318, lat: 37.9643 },
        MT: { lng: -110.3626, lat: 46.8797 },
        NE: { lng: -99.9018, lat: 41.4925 },
        NV: { lng: -116.4194, lat: 38.8026 },
        NH: { lng: -71.5724, lat: 43.1939 },
        NJ: { lng: -74.4057, lat: 40.0583 },
        NM: { lng: -105.8701, lat: 34.5199 },
        NY: { lng: -75.5268, lat: 43.2994 },
        NC: { lng: -79.0193, lat: 35.7596 },
        ND: { lng: -101.002, lat: 47.5515 },
        OH: { lng: -82.9071, lat: 40.4173 },
        OK: { lng: -97.0929, lat: 35.0078 },
        OR: { lng: -120.5542, lat: 43.8041 },
        PA: { lng: -77.1945, lat: 41.2033 },
        RI: { lng: -71.4774, lat: 41.5801 },
        SC: { lng: -81.1637, lat: 33.8361 },
        SD: { lng: -99.9018, lat: 43.9695 },
        TN: { lng: -86.5804, lat: 35.5175 },
        TX: { lng: -99.9018, lat: 31.9686 },
        UT: { lng: -111.0937, lat: 39.321 },
        VT: { lng: -72.5778, lat: 44.5588 },
        VA: { lng: -78.6569, lat: 37.4316 },
        WA: { lng: -120.7401, lat: 47.7511 },
        WV: { lng: -80.4549, lat: 38.5976 },
        WI: { lng: -89.6165, lat: 43.7844 },
        WY: { lng: -107.2903, lat: 43.076 },
      };

      const US_STATE_NAMES = {
        AL: 'Alabama',
        AK: 'Alaska',
        AZ: 'Arizona',
        AR: 'Arkansas',
        CA: 'California',
        CO: 'Colorado',
        CT: 'Connecticut',
        DE: 'Delaware',
        DC: 'District of Columbia',
        FL: 'Florida',
        GA: 'Georgia',
        HI: 'Hawaii',
        ID: 'Idaho',
        IL: 'Illinois',
        IN: 'Indiana',
        IA: 'Iowa',
        KS: 'Kansas',
        KY: 'Kentucky',
        LA: 'Louisiana',
        ME: 'Maine',
        MD: 'Maryland',
        MA: 'Massachusetts',
        MI: 'Michigan',
        MN: 'Minnesota',
        MS: 'Mississippi',
        MO: 'Missouri',
        MT: 'Montana',
        NE: 'Nebraska',
        NV: 'Nevada',
        NH: 'New Hampshire',
        NJ: 'New Jersey',
        NM: 'New Mexico',
        NY: 'New York',
        NC: 'North Carolina',
        ND: 'North Dakota',
        OH: 'Ohio',
        OK: 'Oklahoma',
        OR: 'Oregon',
        PA: 'Pennsylvania',
        RI: 'Rhode Island',
        SC: 'South Carolina',
        SD: 'South Dakota',
        TN: 'Tennessee',
        TX: 'Texas',
        UT: 'Utah',
        VT: 'Vermont',
        VA: 'Virginia',
        WA: 'Washington',
        WV: 'West Virginia',
        WI: 'Wisconsin',
        WY: 'Wyoming',
      };

      const mapRoot = document.getElementById('weather-map-root');
      const tooltip = document.getElementById('weather-map-tooltip');
      const stateCard = document.getElementById('weather-map-state-card');
      const stateCardTitle = document.getElementById('weather-map-state-card-title');
      const stateCardList = document.getElementById('weather-map-state-card-list');
      const searchForm = document.getElementById('weather-map-search');
      const searchInput = document.getElementById('weather-map-search-input');

      if (!mapRoot || !tooltip || !stateCard || !stateCardTitle || !stateCardList || !searchForm || !searchInput) return;

      function showMapError(message) {
        let banner = document.getElementById('weather-map-error');
        if (!banner) {
          banner = document.createElement('div');
          banner.id = 'weather-map-error';
          banner.className = 'weather-map-error';
          mapRoot.parentElement?.appendChild(banner);
        }
        banner.textContent = message;
        banner.hidden = false;
      }

      if (!MAPBOX_TOKEN) {
        showMapError('Map unavailable: missing PUBLIC_MAPBOX_TOKEN.');
        return;
      }

      mapboxgl.accessToken = MAPBOX_TOKEN;

      const map = new mapboxgl.Map({
        container: mapRoot,
        style: 'mapbox://styles/mapbox/dark-v11',
        center: [-98, 38],
        zoom: 3.5,
        projection: 'globe',
      });

      map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'bottom-right');

      map.on('error', (e) => {
        console.error('mapbox_error', e.error);
        showMapError('Map tiles failed to load. Please try again later.');
      });

      const geocodeCache = new Map();
      const reverseGeocodeCache = new Map();
      let signalRows = [];
      let stateSummaryRequestId = 0;

      function categoryColor(category) {
        return CATEGORY_COLORS[category] ?? DEFAULT_COLOR;
      }

      function hideStateCard() {
        stateCard.hidden = true;
        stateCardTitle.textContent = '';
        stateCardList.innerHTML = '';
      }

      function summarizeStateCategories(stateCode) {
        const grouped = new Map();

        for (const row of signalRows) {
          if (row.country !== 'US' || row.state !== stateCode) continue;

          const category = row.category ?? 'Unknown';
          const count = Number(row.event_count) || 0;
          grouped.set(category, (grouped.get(category) ?? 0) + count);
        }

        return Array.from(grouped.entries())
          .map(([category, event_count]) => ({ category, event_count }))
          .sort((a, b) => b.event_count - a.event_count);
      }

      function renderStateCard(stateCode, categories) {
        const stateName = US_STATE_NAMES[stateCode] ?? stateCode;
        stateCardTitle.textContent = `· ${stateName}`;
        stateCardList.replaceChildren();

        for (const { category, event_count } of categories) {
          const li = document.createElement('li');

          const dot = document.createElement('span');
          dot.className = 'weather-map-state-card-dot';
          dot.style.background = categoryColor(category);

          const label = document.createElement('span');
          label.className = 'weather-map-state-card-label';
          label.textContent = category;

          const count = document.createElement('span');
          count.className = 'weather-map-state-card-count';
          count.textContent = String(event_count);

          li.append(dot, label, count);
          stateCardList.append(li);
        }

        stateCard.hidden = false;
      }

      function extractUsStateCode(feature) {
        const shortCode = feature?.properties?.short_code;
        if (typeof shortCode === 'string' && /^US-[A-Z]{2}$/.test(shortCode)) {
          return shortCode.slice(3);
        }

        const context = Array.isArray(feature?.context) ? feature.context : [];
        for (const item of context) {
          if (item?.id?.startsWith('region.') && typeof item.short_code === 'string' && /^US-[A-Z]{2}$/.test(item.short_code)) {
            return item.short_code.slice(3);
          }
        }

        return null;
      }

      async function reverseGeocodeCenter(lng, lat) {
        const cacheKey = `${lng.toFixed(3)}|${lat.toFixed(3)}`;
        if (reverseGeocodeCache.has(cacheKey)) {
          return reverseGeocodeCache.get(cacheKey);
        }

        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${lng},${lat}.json?types=region&country=US&access_token=${MAPBOX_TOKEN}&limit=1`;
        const response = await fetch(url);
        if (!response.ok) return null;

        const payload = await response.json();
        const feature = payload.features?.[0];
        const stateCode = extractUsStateCode(feature);
        reverseGeocodeCache.set(cacheKey, stateCode);
        return stateCode;
      }

      async function updateStateSummary() {
        const requestId = ++stateSummaryRequestId;

        if (map.getZoom() < 4) {
          hideStateCard();
          return;
        }

        const center = map.getCenter();
        const stateCode = await reverseGeocodeCenter(center.lng, center.lat);
        if (requestId !== stateSummaryRequestId) return;

        if (!stateCode || !US_STATE_NAMES[stateCode]) {
          hideStateCard();
          return;
        }

        const categories = summarizeStateCategories(stateCode);
        if (!categories.length) {
          hideStateCard();
          return;
        }

        renderStateCard(stateCode, categories);
      }

      function buildRampFromAccent(hex) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return [
          'interpolate', ['linear'], ['heatmap-density'],
          0,    'rgba(0,0,0,0)',
          0.15, `rgba(${r},${g},${b},0.15)`,
          0.35, `rgba(${r},${g},${b},0.4)`,
          0.55, `rgba(${r},${g},${b},0.65)`,
          0.75, `rgba(${r},${g},${b},0.85)`,
          1,    `rgba(${r},${g},${b},1)`,
        ];
      }

      let activeCategory = 'all';

      function setCategory(categoryKey) {
        activeCategory = categoryKey;

        const filter = categoryKey === 'all'
          ? null
          : ['==', ['get', 'category'], categoryKey];

        if (map.getLayer('density-heat')) map.setFilter('density-heat', filter);
        if (map.getLayer('density-point')) map.setFilter('density-point', filter);

        const ramp = categoryKey !== 'all' && CATEGORY_COLORS[categoryKey]
          ? buildRampFromAccent(CATEGORY_COLORS[categoryKey])
          : DEFAULT_THERMAL_RAMP;

        if (map.getLayer('density-heat')) {
          map.setPaintProperty('density-heat', 'heatmap-color', ramp);
        }

        for (const li of document.querySelectorAll('.weather-map-legend [data-category]')) {
          const cat = li.dataset.category;
          li.classList.toggle('is-active', cat === categoryKey);
          li.setAttribute('aria-pressed', String(cat === categoryKey));
        }
      }

      function addDensityLayers(geojson) {
        // TODO: Move lat/lng aggregation server-side via a Supabase RPC that groups
        // intent_events by rounded coordinates + category and returns count as `weight`,
        // so the client isn't geocoding and aggregating all raw records on every load.

        if (map.getSource('density')) {
          map.getSource('density').setData(geojson);
          return;
        }

        map.addSource('density', { type: 'geojson', data: geojson });

        map.addLayer({
          id: 'density-heat',
          type: 'heatmap',
          source: 'density',
          maxzoom: 9,
          paint: {
            'heatmap-weight': [
              'interpolate', ['linear'], ['get', 'weight'],
              0, 0,
              10, 1,
            ],
            'heatmap-intensity': [
              'interpolate', ['linear'], ['zoom'],
              0, 1,
              9, 3,
            ],
            'heatmap-color': DEFAULT_THERMAL_RAMP,
            'heatmap-radius': [
              'interpolate', ['linear'], ['zoom'],
              0, 8,
              9, 30,
            ],
            'heatmap-opacity': [
              'interpolate', ['linear'], ['zoom'],
              7, 1,
              9, 0,
            ],
          },
        });

        map.addLayer({
          id: 'density-point',
          type: 'circle',
          source: 'density',
          minzoom: 7,
          paint: {
            'circle-radius': [
              'interpolate', ['linear'], ['zoom'],
              7, 2,
              16, 12,
            ],
            'circle-color': ['get', 'category_color'],
            'circle-stroke-color': 'white',
            'circle-stroke-width': 0.5,
            'circle-opacity': [
              'interpolate', ['linear'], ['zoom'],
              7, 0,
              9, 1,
            ],
          },
        });

        map.on('mouseenter', 'density-point', () => {
          map.getCanvas().style.cursor = 'pointer';
        });

        map.on('mouseleave', 'density-point', () => {
          map.getCanvas().style.cursor = '';
          hideTooltip();
        });

        map.on('click', 'density-point', (e) => {
          if (!e.features?.length) return;
          const props = e.features[0].properties;
          const location = props.location ?? 'Unknown location';
          tooltip.hidden = false;
          tooltip.innerHTML = `<strong>${location}</strong><br />${props.category ?? 'Unknown'} · ${props.event_count} views`;
          tooltip.style.left = `${e.originalEvent.clientX}px`;
          tooltip.style.top = `${e.originalEvent.clientY}px`;
        });
      }

      function locationKey(row) {
        return [row.country, row.state ?? '', row.city ?? ''].join('|');
      }

      function aggregateSignals(rows) {
        const grouped = new Map();

        for (const row of rows) {
          const key = [row.country, row.state ?? '', row.city ?? '', row.category ?? 'Unknown'].join('|');
          const existing = grouped.get(key);

          if (existing) {
            existing.event_count += Number(row.event_count) || 0;
          } else {
            grouped.set(key, {
              country: row.country,
              state: row.state ?? null,
              city: row.city ?? null,
              category: row.category ?? 'Unknown',
              event_count: Number(row.event_count) || 0,
            });
          }
        }

        return Array.from(grouped.values()).filter((row) => row.country);
      }

      function geocodeQuery(row) {
        const parts = [];
        if (row.city != null && row.city !== '') parts.push(row.city);
        if (row.state != null && row.state !== '') {
          if (row.country === 'US' && US_STATE_NAMES[row.state]) {
            parts.push(US_STATE_NAMES[row.state]);
          } else {
            parts.push(row.state);
          }
        }
        if (row.country != null && row.country !== '') parts.push(row.country);
        return parts.join(', ');
      }

      function resolveStaticCoords(row) {
        if (Number.isFinite(row.lat) && Number.isFinite(row.lng)) {
          return { lng: row.lng, lat: row.lat };
        }

        if (row.country === 'US' && row.state && US_STATE_CENTROIDS[row.state]) {
          return US_STATE_CENTROIDS[row.state];
        }

        return null;
      }

      async function geocodeLocation(row) {
        const cacheKey = locationKey(row);
        if (geocodeCache.has(cacheKey)) {
          return geocodeCache.get(cacheKey);
        }

        const staticCoords = resolveStaticCoords(row);
        if (staticCoords) {
          geocodeCache.set(cacheKey, staticCoords);
          return staticCoords;
        }

        const query = encodeURIComponent(geocodeQuery(row));
        const country = row.country ? `&country=${encodeURIComponent(row.country)}` : '';
        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${query}.json?access_token=${MAPBOX_TOKEN}&limit=1${country}`;

        const response = await fetch(url);
        if (!response.ok) {
          console.warn('weather_map_geocode_failed', geocodeQuery(row), response.status);
          return null;
        }

        const payload = await response.json();
        const feature = payload.features?.[0];
        if (!feature?.center) return null;

        const coords = { lng: feature.center[0], lat: feature.center[1] };
        geocodeCache.set(cacheKey, coords);
        return coords;
      }

      async function geocodeUniqueLocations(rows) {
        const locations = new Map();
        for (const row of rows) {
          const key = locationKey(row);
          if (!locations.has(key)) locations.set(key, row);
        }

        const coordsByKey = new Map();
        const pending = [...locations.entries()];
        const batchSize = 8;

        for (let index = 0; index < pending.length; index += batchSize) {
          const batch = pending.slice(index, index + batchSize);
          await Promise.all(
            batch.map(async ([key, row]) => {
              const coords = await geocodeLocation(row);
              if (coords) coordsByKey.set(key, coords);
            })
          );
        }

        return coordsByKey;
      }

      function hideTooltip() {
        tooltip.hidden = true;
      }

      async function renderSignals(rows) {
        const aggregated = aggregateSignals(rows);
        if (!aggregated.length) {
          mapRoot.insertAdjacentHTML(
            'afterend',
            '<p class="weather-map-empty">No map signals available yet.</p>'
          );
          return;
        }

        const coordsByKey = await geocodeUniqueLocations(aggregated);

        if (!coordsByKey.size) {
          showMapError('Unable to place map signals on the map.');
          return;
        }

        const features = [];

        for (const row of aggregated) {
          const coords = coordsByKey.get(locationKey(row));
          if (!coords) continue;

          features.push({
            type: 'Feature',
            geometry: { type: 'Point', coordinates: [coords.lng, coords.lat] },
            properties: {
              category: row.category,
              category_color: categoryColor(row.category),
              weight: row.event_count,
              location: row.city ?? row.state ?? 'Unknown location',
              event_count: row.event_count,
            },
          });
        }

        if (!features.length) {
          showMapError('Unable to place map signals on the map.');
          return;
        }

        addDensityLayers({ type: 'FeatureCollection', features });
      }

      async function loadSignals() {
        const response = await fetch(`${API_BASE}/api/map-signals`);
        if (!response.ok) throw new Error('Failed to load map signals');
        return response.json();
      }

      searchForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const query = searchInput.value.trim();
        if (!query) return;

        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(query)}.json?access_token=${MAPBOX_TOKEN}&types=place,postcode,locality&limit=1`;
        const response = await fetch(url);
        if (!response.ok) return;

        const payload = await response.json();
        const feature = payload.features?.[0];
        if (!feature?.center) return;

        map.flyTo({
          center: feature.center,
          zoom: 9,
          speed: 1.2,
          essential: true,
        });
      });

      map.on('load', async () => {
        map.resize();
        map.setFog({});

        for (const li of document.querySelectorAll('.weather-map-legend [data-category]')) {
          const handleSelect = () => setCategory(li.dataset.category);
          li.addEventListener('click', handleSelect);
          li.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              handleSelect();
            }
          });
        }

        try {
          const signals = await loadSignals();
          signalRows = Array.isArray(signals) ? signals : [];
          await renderSignals(signalRows);
          await updateStateSummary();
        } catch (error) {
          console.error('weather_map_load_error', error);
          showMapError('Unable to load weather map data.');
        }
      });

      map.on('moveend', () => {
        updateStateSummary();
      });

      map.on('zoomend', () => {
        updateStateSummary();
      });
    }

    if (typeof mapboxgl === 'undefined') {
      const mapRoot = document.getElementById('weather-map-root');
      if (mapRoot) {
        const banner = document.createElement('div');
        banner.className = 'weather-map-error';
        banner.textContent = 'Map unavailable: Mapbox GL failed to load.';
        mapRoot.parentElement?.appendChild(banner);
      }
    } else if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWeatherMap);
    } else {
      initWeatherMap();
    }
  </script>

  <script define:vars={{ API_BASE }} is:inline>
    (() => {
      const card = document.getElementById('weather-map-insights-card');
      const list = document.getElementById('weather-map-insights-list');
      const loading = card?.querySelector('.weather-map-insights-loading');
      if (!card || !list || !loading) return;

      async function loadInsights() {
        try {
          const response = await fetch(`${API_BASE}/api/insights`);
          if (!response.ok) throw new Error('insights_fetch_failed');

          const payload = await response.json();
          const bullets = Array.isArray(payload.insights) ? payload.insights : [];

          if (!bullets.length) throw new Error('insights_empty');

          list.replaceChildren();
          for (const text of bullets) {
            const li = document.createElement('li');
            li.textContent = text;
            list.append(li);
          }

          loading.hidden = true;
          list.hidden = false;
        } catch (error) {
          console.error('weather_map_insights_error', error);
          loading.textContent = 'Insights are unavailable right now.';
        }
      }

      loadInsights();
    })();
  </script>

