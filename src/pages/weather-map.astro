---
import BaseLayout from '@/layouts/BaseLayout.astro';

const MAPBOX_TOKEN = import.meta.env.PUBLIC_MAPBOX_TOKEN ?? '';
---

<BaseLayout
  title="Psychology Weather Map | Deeper Global"
  description="Explore aggregate mental health question demand by geography and topic across Deeper Global."
  canonicalPath="/weather-map"
>
  <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" />
  <main class="content weather-map-page">
    <p class="eyebrow">Psychology Weather Map</p>
    <h1>Where mental health questions cluster.</h1>
    <p class="summary">
      Aggregate answer-view signals by city, state, and topic. No individual identification.
    </p>

    <div class="weather-map-shell">
      <form class="weather-map-search" id="weather-map-search" role="search" aria-label="Search city or ZIP code">
        <label class="sr-only" for="weather-map-search-input">City or ZIP code</label>
        <input
          id="weather-map-search-input"
          name="q"
          type="search"
          placeholder="Search city or ZIP…"
          autocomplete="off"
        />
        <button type="submit">Go</button>
      </form>

      <div id="weather-map-root" class="weather-map-canvas" aria-label="Psychology weather map"></div>
      <div id="weather-map-tooltip" class="weather-map-tooltip" hidden></div>
      <aside
        id="weather-map-state-card"
        class="weather-map-state-card"
        hidden
        aria-live="polite"
        aria-label="State category summary"
      >
        <p class="weather-map-state-card-eyebrow">State</p>
        <h2 id="weather-map-state-card-title" class="weather-map-state-card-title"></h2>
        <ul id="weather-map-state-card-list" class="weather-map-state-card-list"></ul>
      </aside>
    </div>

    <div class="weather-map-legend" aria-label="Category legend">
      <span class="weather-map-legend-title">Categories</span>
      <ul>
        <li><span class="swatch" style="background:#F5A623"></span>Anxiety &amp; Stress</li>
        <li><span class="swatch" style="background:#4A90D9"></span>Depression</li>
        <li><span class="swatch" style="background:#8E44AD"></span>Addiction &amp; Recovery</li>
        <li><span class="swatch" style="background:#C0392B"></span>Trauma &amp; Safety</li>
        <li><span class="swatch" style="background:#27AE60"></span>Therapy &amp; Care Navigation</li>
        <li><span class="swatch" style="background:#F39C12"></span>Identity &amp; Self-Worth</li>
        <li><span class="swatch" style="background:#E91E63"></span>Relationships &amp; Communication</li>
        <li><span class="swatch" style="background:#FF9800"></span>Family &amp; Parenting</li>
        <li><span class="swatch" style="background:#9B59B6"></span>Grief &amp; Loss</li>
        <li><span class="swatch" style="background:#E8572A"></span>Work &amp; Burnout</li>
        <li><span class="swatch" style="background:#00BCD4"></span>Teens &amp; Identity</li>
        <li><span class="swatch" style="background:#607D8B"></span>Loneliness &amp; Belonging</li>
        <li><span class="swatch" style="background:#2ECC71"></span>Neurodivergence &amp; Attention</li>
        <li><span class="swatch" style="background:#FF4081"></span>Gender, Sexuality &amp; Intimacy</li>
        <li><span class="swatch" style="background:#795548"></span>Meaning, Faith &amp; Existential Questions</li>
        <li><span class="swatch" style="background:#546E7A"></span>General Mental Health</li>
      </ul>
    </div>

    <section class="weather-map-insights" aria-labelledby="weather-map-insights-heading">
      <h2 id="weather-map-insights-heading">This Week in American Mental Health</h2>
      <div class="weather-map-insights-card" id="weather-map-insights-card">
        <p class="weather-map-insights-loading">Loading insights…</p>
        <ul id="weather-map-insights-list" class="weather-map-insights-list" hidden></ul>
      </div>
    </section>
  </main>

  <script is:inline src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>

  <script define:vars={{ MAPBOX_TOKEN }}>
    function initWeatherMap() {
      const CATEGORY_COLORS = {
        'Anxiety & Stress': '#F5A623',
        'Depression': '#4A90D9',
        'Addiction & Recovery': '#8E44AD',
        'Trauma & Safety': '#C0392B',
        'Therapy & Care Navigation': '#27AE60',
        'Identity & Self-Worth': '#F39C12',
        'Relationships & Communication': '#E91E63',
        'Family & Parenting': '#FF9800',
        'Grief & Loss': '#9B59B6',
        'Work & Burnout': '#E8572A',
        'Teens & Identity': '#00BCD4',
        'Loneliness & Belonging': '#607D8B',
        'Neurodivergence & Attention': '#2ECC71',
        'Gender, Sexuality & Intimacy': '#FF4081',
        'Meaning, Faith & Existential Questions': '#795548',
        'General Mental Health': '#546E7A',
      };

      const DEFAULT_COLOR = '#888888';
      const MIN_RADIUS = 8;
      const MAX_RADIUS = 40;

      const US_STATE_NAMES = {
        AL: 'Alabama',
        AK: 'Alaska',
        AZ: 'Arizona',
        AR: 'Arkansas',
        CA: 'California',
        CO: 'Colorado',
        CT: 'Connecticut',
        DE: 'Delaware',
        DC: 'District of Columbia',
        FL: 'Florida',
        GA: 'Georgia',
        HI: 'Hawaii',
        ID: 'Idaho',
        IL: 'Illinois',
        IN: 'Indiana',
        IA: 'Iowa',
        KS: 'Kansas',
        KY: 'Kentucky',
        LA: 'Louisiana',
        ME: 'Maine',
        MD: 'Maryland',
        MA: 'Massachusetts',
        MI: 'Michigan',
        MN: 'Minnesota',
        MS: 'Mississippi',
        MO: 'Missouri',
        MT: 'Montana',
        NE: 'Nebraska',
        NV: 'Nevada',
        NH: 'New Hampshire',
        NJ: 'New Jersey',
        NM: 'New Mexico',
        NY: 'New York',
        NC: 'North Carolina',
        ND: 'North Dakota',
        OH: 'Ohio',
        OK: 'Oklahoma',
        OR: 'Oregon',
        PA: 'Pennsylvania',
        RI: 'Rhode Island',
        SC: 'South Carolina',
        SD: 'South Dakota',
        TN: 'Tennessee',
        TX: 'Texas',
        UT: 'Utah',
        VT: 'Vermont',
        VA: 'Virginia',
        WA: 'Washington',
        WV: 'West Virginia',
        WI: 'Wisconsin',
        WY: 'Wyoming',
      };

      const mapRoot = document.getElementById('weather-map-root');
      const tooltip = document.getElementById('weather-map-tooltip');
      const stateCard = document.getElementById('weather-map-state-card');
      const stateCardTitle = document.getElementById('weather-map-state-card-title');
      const stateCardList = document.getElementById('weather-map-state-card-list');
      const searchForm = document.getElementById('weather-map-search');
      const searchInput = document.getElementById('weather-map-search-input');

      if (!mapRoot || !tooltip || !stateCard || !stateCardTitle || !stateCardList || !searchForm || !searchInput) return;

      if (!MAPBOX_TOKEN) {
        mapRoot.textContent = 'Map unavailable: missing PUBLIC_MAPBOX_TOKEN.';
        return;
      }

      mapboxgl.accessToken = MAPBOX_TOKEN;

      const map = new mapboxgl.Map({
        container: mapRoot,
        style: 'mapbox://styles/mapbox/dark-v11',
        center: [-98, 38],
        zoom: 4,
        projection: 'globe',
      });

      map.addControl(new mapboxgl.NavigationControl({ showCompass: false }), 'bottom-right');

      map.on('error', (e) => {
        console.error('mapbox_error', e.error);
      });

      const geocodeCache = new Map();
      const reverseGeocodeCache = new Map();
      let signalRows = [];
      let stateSummaryRequestId = 0;

      function categoryColor(category) {
        return CATEGORY_COLORS[category] ?? DEFAULT_COLOR;
      }

      function hideStateCard() {
        stateCard.hidden = true;
        stateCardTitle.textContent = '';
        stateCardList.innerHTML = '';
      }

      function summarizeStateCategories(stateCode) {
        const grouped = new Map();

        for (const row of signalRows) {
          if (row.country !== 'US' || row.state !== stateCode) continue;

          const category = row.category ?? 'Unknown';
          const count = Number(row.event_count) || 0;
          grouped.set(category, (grouped.get(category) ?? 0) + count);
        }

        return Array.from(grouped.entries())
          .map(([category, event_count]) => ({ category, event_count }))
          .sort((a, b) => b.event_count - a.event_count);
      }

      function renderStateCard(stateCode, categories) {
        const stateName = US_STATE_NAMES[stateCode] ?? stateCode;
        stateCardTitle.textContent = `· ${stateName}`;
        stateCardList.replaceChildren();

        for (const { category, event_count } of categories) {
          const li = document.createElement('li');

          const dot = document.createElement('span');
          dot.className = 'weather-map-state-card-dot';
          dot.style.background = categoryColor(category);

          const label = document.createElement('span');
          label.className = 'weather-map-state-card-label';
          label.textContent = category;

          const count = document.createElement('span');
          count.className = 'weather-map-state-card-count';
          count.textContent = String(event_count);

          li.append(dot, label, count);
          stateCardList.append(li);
        }

        stateCard.hidden = false;
      }

      function extractUsStateCode(feature) {
        const shortCode = feature?.properties?.short_code;
        if (typeof shortCode === 'string' && /^US-[A-Z]{2}$/.test(shortCode)) {
          return shortCode.slice(3);
        }

        const context = Array.isArray(feature?.context) ? feature.context : [];
        for (const item of context) {
          if (item?.id?.startsWith('region.') && typeof item.short_code === 'string' && /^US-[A-Z]{2}$/.test(item.short_code)) {
            return item.short_code.slice(3);
          }
        }

        return null;
      }

      async function reverseGeocodeCenter(lng, lat) {
        const cacheKey = `${lng.toFixed(3)}|${lat.toFixed(3)}`;
        if (reverseGeocodeCache.has(cacheKey)) {
          return reverseGeocodeCache.get(cacheKey);
        }

        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${lng},${lat}.json?types=region&country=US&access_token=${MAPBOX_TOKEN}&limit=1`;
        const response = await fetch(url);
        if (!response.ok) return null;

        const payload = await response.json();
        const feature = payload.features?.[0];
        const stateCode = extractUsStateCode(feature);
        reverseGeocodeCache.set(cacheKey, stateCode);
        return stateCode;
      }

      async function updateStateSummary() {
        const requestId = ++stateSummaryRequestId;

        if (map.getZoom() < 4) {
          hideStateCard();
          return;
        }

        const center = map.getCenter();
        const stateCode = await reverseGeocodeCenter(center.lng, center.lat);
        if (requestId !== stateSummaryRequestId) return;

        if (!stateCode || !US_STATE_NAMES[stateCode]) {
          hideStateCard();
          return;
        }

        const categories = summarizeStateCategories(stateCode);
        if (!categories.length) {
          hideStateCard();
          return;
        }

        renderStateCard(stateCode, categories);
      }

      function logRadius(eventCount, minCount, maxCount) {
        if (!Number.isFinite(eventCount) || eventCount <= 0) return MIN_RADIUS;
        if (minCount === maxCount) return (MIN_RADIUS + MAX_RADIUS) / 2;

        const minLog = Math.log10(minCount + 1);
        const maxLog = Math.log10(maxCount + 1);
        const valueLog = Math.log10(eventCount + 1);
        const ratio = (valueLog - minLog) / (maxLog - minLog || 1);

        return MIN_RADIUS + ratio * (MAX_RADIUS - MIN_RADIUS);
      }

      function locationKey(row) {
        return [row.country, row.state ?? '', row.city ?? ''].join('|');
      }

      function aggregateSignals(rows) {
        const grouped = new Map();

        for (const row of rows) {
          const key = [row.country, row.state ?? '', row.city ?? '', row.category ?? 'Unknown'].join('|');
          const existing = grouped.get(key);

          if (existing) {
            existing.event_count += Number(row.event_count) || 0;
          } else {
            grouped.set(key, {
              country: row.country,
              state: row.state ?? null,
              city: row.city ?? null,
              category: row.category ?? 'Unknown',
              event_count: Number(row.event_count) || 0,
            });
          }
        }

        return Array.from(grouped.values()).filter((row) => row.country);
      }

      function geocodeQuery(row) {
        const parts = [];
        if (row.city != null && row.city !== '') parts.push(row.city);
        if (row.state != null && row.state !== '') parts.push(row.state);
        if (row.country != null && row.country !== '') parts.push(row.country);
        return parts.join(', ');
      }

      async function geocodeLocation(row) {
        const cacheKey = locationKey(row);
        if (geocodeCache.has(cacheKey)) {
          return geocodeCache.get(cacheKey);
        }

        const query = encodeURIComponent(geocodeQuery(row));
        const country = row.country ? `&country=${encodeURIComponent(row.country)}` : '';
        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${query}.json?access_token=${MAPBOX_TOKEN}&limit=1${country}`;

        const response = await fetch(url);
        if (!response.ok) throw new Error(`Geocoding failed for ${geocodeQuery(row)}`);

        const payload = await response.json();
        const feature = payload.features?.[0];
        if (!feature?.center) return null;

        const coords = { lng: feature.center[0], lat: feature.center[1] };
        geocodeCache.set(cacheKey, coords);
        return coords;
      }

      function showTooltip(marker, row) {
        tooltip.hidden = false;
        const location = row.city ?? row.state ?? 'Unknown location';
        tooltip.innerHTML = `
          <strong>${location}</strong><br />
          ${row.category ?? 'Unknown'} · ${row.event_count} views
        `;

        const rect = marker.getElement().getBoundingClientRect();
        tooltip.style.left = `${rect.left + rect.width / 2}px`;
        tooltip.style.top = `${rect.top}px`;
      }

      function hideTooltip() {
        tooltip.hidden = true;
      }

      function spreadCoords(coords, index, total) {
        if (total <= 1) return coords;

        const angle = (index / total) * 2 * Math.PI;
        const offsetRadius = 0.15;

        return {
          lng: coords.lng + offsetRadius * Math.cos(angle),
          lat: coords.lat + offsetRadius * Math.sin(angle),
        };
      }

      function createMarker(row, coords, diameter) {
        const element = document.createElement('div');
        element.className = 'weather-map-marker';
        element.style.width = `${diameter}px`;
        element.style.height = `${diameter}px`;
        element.style.borderRadius = '50%';
        element.style.overflow = 'hidden';
        element.style.backgroundColor = categoryColor(row.category);
        element.setAttribute('aria-label', `${row.city}, ${row.category}, ${row.event_count} views`);

        const marker = new mapboxgl.Marker({ element, anchor: 'center' })
          .setLngLat([coords.lng, coords.lat])
          .addTo(map);

        element.addEventListener('mouseenter', () => showTooltip(marker, row));
        element.addEventListener('mouseleave', hideTooltip);
        element.addEventListener('focus', () => showTooltip(marker, row));
        element.addEventListener('blur', hideTooltip);
        element.tabIndex = 0;

        return marker;
      }

      async function renderSignals(rows) {
        const aggregated = aggregateSignals(rows);
        if (!aggregated.length) {
          mapRoot.insertAdjacentHTML(
            'afterend',
            '<p class="weather-map-empty">No map signals available yet.</p>'
          );
          return;
        }

        const counts = aggregated.map((row) => row.event_count);
        const minCount = Math.min(...counts);
        const maxCount = Math.max(...counts);

        const located = await Promise.all(
          aggregated.map(async (row) => {
            if (Number.isFinite(row.lat) && Number.isFinite(row.lng)) {
              return { row, coords: { lat: row.lat, lng: row.lng } };
            }

            const coords = await geocodeLocation(row);
            return coords ? { row, coords } : null;
          })
        );

        const groups = new Map();

        for (const item of located) {
          if (!item) continue;
          const key = `${item.coords.lng}|${item.coords.lat}`;
          if (!groups.has(key)) groups.set(key, []);
          groups.get(key).push(item);
        }

        for (const group of groups.values()) {
          group.forEach((item, index) => {
            const diameter = logRadius(item.row.event_count, minCount, maxCount);
            const markerCoords = spreadCoords(item.coords, index, group.length);
            createMarker(item.row, markerCoords, diameter);
          });
        }
      }

      async function loadSignals() {
        const response = await fetch('/api/map-signals');
        if (!response.ok) throw new Error('Failed to load map signals');
        return response.json();
      }

      searchForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const query = searchInput.value.trim();
        if (!query) return;

        const url = `https://api.mapbox.com/geocoding/v5/mapbox.places/${encodeURIComponent(query)}.json?access_token=${MAPBOX_TOKEN}&types=place,postcode,locality&limit=1`;
        const response = await fetch(url);
        if (!response.ok) return;

        const payload = await response.json();
        const feature = payload.features?.[0];
        if (!feature?.center) return;

        map.flyTo({
          center: feature.center,
          zoom: 9,
          speed: 1.2,
          essential: true,
        });
      });

      map.on('load', async () => {
        map.setFog({});

        try {
          const signals = await loadSignals();
          signalRows = Array.isArray(signals) ? signals : [];
          await renderSignals(signalRows);
          await updateStateSummary();
        } catch (error) {
          console.error('weather_map_load_error', error);
          mapRoot.textContent = 'Unable to load weather map data.';
        }
      });

      map.on('moveend', () => {
        updateStateSummary();
      });

      map.on('zoomend', () => {
        updateStateSummary();
      });
    }

    if (typeof mapboxgl === 'undefined') {
      const mapRoot = document.getElementById('weather-map-root');
      if (mapRoot) mapRoot.textContent = 'Map unavailable: Mapbox GL failed to load.';
    } else if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWeatherMap);
    } else {
      initWeatherMap();
    }
  </script>

  <script is:inline>
    (() => {
      const card = document.getElementById('weather-map-insights-card');
      const list = document.getElementById('weather-map-insights-list');
      const loading = card?.querySelector('.weather-map-insights-loading');
      if (!card || !list || !loading) return;

      async function loadInsights() {
        try {
          const response = await fetch('/api/insights');
          if (!response.ok) throw new Error('insights_fetch_failed');

          const payload = await response.json();
          const bullets = Array.isArray(payload.insights) ? payload.insights : [];

          if (!bullets.length) throw new Error('insights_empty');

          list.replaceChildren();
          for (const text of bullets) {
            const li = document.createElement('li');
            li.textContent = text;
            list.append(li);
          }

          loading.hidden = true;
          list.hidden = false;
        } catch (error) {
          console.error('weather_map_insights_error', error);
          loading.textContent = 'Insights are unavailable right now.';
        }
      }

      loadInsights();
    })();
  </script>

  <style>
    .weather-map-page .weather-map-shell {
      position: relative;
      margin-top: var(--space-6);
    }

    .weather-map-canvas {
      width: 100%;
      height: 80vh;
      min-height: 420px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--line-strong);
      background: #0b1220;
    }

    .weather-map-search {
      position: absolute;
      top: var(--space-4);
      right: var(--space-4);
      z-index: 2;
      display: flex;
      gap: var(--space-2);
      padding: var(--space-2);
      border-radius: 999px;
      background: rgba(14, 31, 51, 0.88);
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: var(--shadow);
      backdrop-filter: blur(8px);
    }

    .weather-map-search input {
      width: min(52vw, 240px);
      border: 0;
      outline: none;
      background: transparent;
      color: #f8fafc;
      padding: 0.4rem 0.75rem;
    }

    .weather-map-search input::placeholder {
      color: rgba(248, 250, 252, 0.6);
    }

    .weather-map-search button {
      border: 0;
      border-radius: 999px;
      background: var(--ocean-bright);
      color: white;
      padding: 0.45rem 0.9rem;
      cursor: pointer;
      font-weight: 600;
    }

    .weather-map-marker {
      border-radius: 50% !important;
      opacity: 0.75;
      box-shadow: 0 0 18px rgba(255, 255, 255, 0.18);
      animation: weather-map-pulse 2.8s ease-in-out infinite;
      cursor: pointer;
    }

    @keyframes weather-map-pulse {
      0%,
      100% {
        opacity: 0.65;
      }
      50% {
        opacity: 0.88;
      }
    }

    .weather-map-tooltip {
      position: fixed;
      z-index: 20;
      transform: translate(-50%, calc(-100% - 12px));
      pointer-events: none;
      padding: 0.55rem 0.75rem;
      border-radius: 8px;
      background: rgba(14, 31, 51, 0.94);
      color: #f8fafc;
      font-size: var(--text-sm);
      line-height: 1.4;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: var(--shadow);
      white-space: nowrap;
    }

    .weather-map-state-card {
      position: absolute;
      left: var(--space-4);
      bottom: var(--space-4);
      z-index: 3;
      width: 220px;
      max-height: 60vh;
      overflow-y: auto;
      padding: 0.75rem 0.85rem;
      border-radius: 8px;
      background: rgba(14, 31, 51, 0.94);
      color: #f8fafc;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: var(--shadow);
      backdrop-filter: blur(8px);
      pointer-events: auto;
    }

    .weather-map-state-card-eyebrow {
      margin: 0;
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(248, 250, 252, 0.55);
    }

    .weather-map-state-card-title {
      margin: 0.15rem 0 0.65rem;
      font-size: var(--text-sm);
      font-weight: 600;
      line-height: 1.3;
      color: #f8fafc;
    }

    .weather-map-state-card-title::before {
      content: 'State ';
      color: rgba(248, 250, 252, 0.55);
      font-weight: 500;
    }

    .weather-map-state-card-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .weather-map-state-card :global(.weather-map-state-card-list li) {
      display: grid;
      grid-template-columns: 0.65rem 1fr auto;
      align-items: start;
      gap: 0.45rem;
      font-size: 0.78rem;
      line-height: 1.35;
      color: rgba(248, 250, 252, 0.92);
    }

    .weather-map-state-card :global(.weather-map-state-card-dot) {
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      margin-top: 0.2rem;
      flex-shrink: 0;
      color: transparent;
    }

    .weather-map-state-card :global(.weather-map-state-card-label) {
      color: rgba(248, 250, 252, 0.92);
    }

    .weather-map-state-card :global(.weather-map-state-card-count) {
      color: rgba(248, 250, 252, 0.65);
      font-variant-numeric: tabular-nums;
    }

    .weather-map-page .weather-map-state-card-eyebrow {
      color: rgba(248, 250, 252, 0.55);
    }

    .weather-map-page .weather-map-state-card-title,
    .weather-map-page .weather-map-state-card-title::before {
      color: #f8fafc;
    }

    .weather-map-page .weather-map-state-card-title::before {
