---
import AnswerCard from '@/components/AnswerCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  adhdFeaturedSlugs,
  ADHD_HUB_PATH,
  getAdhdHubClusterCards,
  getAdhdHubQuestions,
} from '@/lib/adhd-hub';
import { answerPath, getAnswerDisplayTitle, getAnswerSummary } from '@/lib/content';
import { siteUrl, websiteId } from '@/lib/site';
import { getQuestions, type Question } from '@/lib/supabase';

const questions = await getQuestions();
const hubQuestions = getAdhdHubQuestions(questions);
const questionsBySlug = new Map(hubQuestions.map((question) => [question.slug, question]));
const featuredQuestions = adhdFeaturedSlugs
  .map((slug) => questionsBySlug.get(slug))
  .filter((question): question is Question => Boolean(question));
const clusterCards = getAdhdHubClusterCards(questions);

const jsonLd = {
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl(ADHD_HUB_PATH)}#collection`,
      url: siteUrl(ADHD_HUB_PATH),
      name: 'ADHD hub: diagnosis, executive function, treatment, and daily life',
      description:
        'A curated Deeper Global hub for ADHD in adults—diagnosis, executive dysfunction, emotional overwhelm, medication, work accommodations, relationships, and daily coping.',
      isPartOf: {
        '@id': websiteId(),
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: hubQuestions.length,
        itemListElement: hubQuestions.slice(0, 24).map((question, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: siteUrl(`/answers/${question.slug}`),
          name: getAnswerDisplayTitle(question),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl(ADHD_HUB_PATH)}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Deeper Global',
          item: siteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'ADHD',
          item: siteUrl(ADHD_HUB_PATH),
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="ADHD Hub: Diagnosis, Focus, Treatment & Daily Life | Deeper Global"
  description="Explore evidence-informed answers about adult ADHD—signs, testing, executive dysfunction, emotional overwhelm, medication, work accommodations, relationships, and routines."
  canonicalPath={ADHD_HUB_PATH}
  jsonLd={jsonLd}
>
  <main>
    <section class="adhd-hero">
      <p class="eyebrow">ADHD HUB</p>
      <h1>ADHD, understood.</h1>
      <p class="hero-subhead">
        Most people who find this page already suspect something. Maybe you were just diagnosed. Maybe you've wondered for years. Either way — these answers are written for where you actually are, not where a brochure thinks you should be.
      </p>
      <p class="hero-trust-line">
        31 structured answers. Evidence-informed. Written for adults.
      </p>
      <div class="hub-actions">
        <a class="button" href="/answers/?q=ADHD">Search ADHD answers</a>
        <a class="button secondary" href="/categories/neurodivergence-and-attention">Topic hub</a>
      </div>
    </section>

    <section class="section">
      <div class="container hub-intro-grid">
        <article class="card hub-signal-card">
          <p class="eyebrow">Coverage</p>
          <h2>{hubQuestions.length} ADHD-related answers</h2>
          <p>
            Diagnosis and testing, executive dysfunction, time blindness, rejection sensitivity, medication, burnout, work accommodations, study skills, and relationship communication—organized for bingeable, calm reading.
          </p>
        </article>
        <article class="card hub-signal-card">
          <p class="eyebrow">Care boundary</p>
          <h2>Education, not diagnosis.</h2>
          <p>
            These answers explain patterns and options. Only a qualified clinician can determine whether ADHD or another condition fits your experience and what treatment is appropriate.
          </p>
        </article>
      </div>
    </section>

    {
      featuredQuestions.length ? (
        <section class="section featured-section">
          <div class="container">
            <div class="section-header">
              <div>
                <p class="eyebrow">Start here</p>
                <h2>Most searched ADHD concerns.</h2>
              </div>
            </div>
            <div class="question-grid adhd-answers">
              {featuredQuestions.map((question) => <AnswerCard question={question} />)}
            </div>
          </div>
        </section>
      ) : null
    }

    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Concern map</p>
            <h2>Browse the ADHD cluster.</h2>
          </div>
        </div>
        <div class="cluster-grid">
          {
            clusterCards.map((cluster) => (
              <article class="card hub-cluster-card">
                <h3>{cluster.name}</h3>
                <p>{cluster.description}</p>
                <ul>
                  {cluster.questions.map((question) => (
                    <li>
                      <a href={answerPath(question.slug)}>{getAnswerDisplayTitle(question)}</a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">All ADHD answers</p>
            <h2>Recently added and related pages.</h2>
          </div>
          <a class="text-link" href="/answers/?q=ADHD">Search the answer library</a>
        </div>
        <div class="answer-list hub-answer-list adhd-answers">
          {hubQuestions.slice(0, 24).map((question) => <AnswerCard question={question} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .adhd-hero {
    background: var(--navy);
    padding: var(--space-16) var(--space-6) var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .adhd-hero {
      padding: var(--space-20) var(--space-8) var(--space-16);
      max-width: var(--max);
      margin: 0 auto;
    }
  }

  .adhd-hero .eyebrow {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ocean-bright);
    margin: 0;
  }

  .adhd-hero h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--white);
    margin: 0;
  }

  @media (min-width: 768px) {
    .adhd-hero h1 {
      font-size: var(--text-4xl);
    }
  }

  .adhd-hero .hero-subhead {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    max-width: 36rem;
  }

  @media (min-width: 768px) {
    .adhd-hero .hero-subhead {
      font-size: var(--text-md);
    }
  }

  .adhd-hero .hero-trust-line {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.02em;
    margin: var(--space-2) 0 0;
  }
</style>

<style is:global>
  .adhd-answers .answer-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 3px solid var(--ocean);
    border-radius: 6px;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition:
      box-shadow 0.2s ease,
      border-left-color 0.2s ease;
    text-decoration: none;
  }

  .question-grid.adhd-answers .answer-card {
    border: 1px solid var(--line);
    border-left: 3px solid var(--ocean);
    border-radius: 6px;
  }

  .adhd-answers .answer-card:hover {
    box-shadow: var(--shadow);
    border-left-color: var(--brass);
    background: var(--white);
  }

  .adhd-answers .answer-card-title,
  .adhd-answers .answer-card h2,
  .adhd-answers .answer-card h3 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--navy);
    margin: 0;
    transition: color 0.15s ease;
  }

  .adhd-answers .answer-card:hover .answer-card-title,
  .adhd-answers .answer-card:hover h2,
  .adhd-answers .answer-card:hover h3 {
    color: var(--ocean);
  }

  .adhd-answers .answer-card-summary,
  .adhd-answers .answer-card p {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: var(--leading-relaxed);
    color: var(--stone);
    margin: 0;
  }

  .adhd-answers .pill--category {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    background: var(--mist);
    color: var(--ocean);
    border-radius: 100px;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    display: inline-block;
  }

  .adhd-answers .pill--date {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    color: var(--stone);
  }
</style>
