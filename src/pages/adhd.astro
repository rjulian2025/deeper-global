---
import TopicHubPage from '@/components/topic-hub/TopicHubPage.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildTopicHubPageData } from '@/lib/topic-hub';
import { buildTopicHubJsonLd } from '@/lib/topic-hub-jsonld';
import { getAdhdTopicHubConfig } from '@/lib/topic-hubs/adhd';
import { getQuestions } from '@/lib/supabase';

const config = getAdhdTopicHubConfig();
const questions = await getQuestions();
const hub = buildTopicHubPageData(config, questions);
const jsonLd = buildTopicHubJsonLd(config, hub);
---

<BaseLayout
  title="ADHD Hub: Diagnosis, Focus, Treatment & Daily Life | Deeper Global"
  description={config.jsonLdDescription}
  canonicalPath={config.path}
  jsonLd={jsonLd}
>
  <TopicHubPage config={config} hub={hub} />
</BaseLayout>
