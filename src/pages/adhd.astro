---
import AnswerCard from '@/components/AnswerCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  adhdFeaturedSlugs,
  ADHD_HUB_PATH,
  getAdhdHubClusterCards,
  getAdhdHubQuestions,
} from '@/lib/adhd-hub';
import { answerPath, getAnswerDisplayTitle, getAnswerSummary } from '@/lib/content';
import { siteUrl, websiteId } from '@/lib/site';
import { getQuestions, type Question } from '@/lib/supabase';

const questions = await getQuestions();
const hubQuestions = getAdhdHubQuestions(questions);
const questionsBySlug = new Map(hubQuestions.map((question) => [question.slug, question]));
const featuredQuestions = adhdFeaturedSlugs
  .map((slug) => questionsBySlug.get(slug))
  .filter((question): question is Question => Boolean(question));
const clusterCards = getAdhdHubClusterCards(questions);

const jsonLd = {
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl(ADHD_HUB_PATH)}#collection`,
      url: siteUrl(ADHD_HUB_PATH),
      name: 'ADHD hub: diagnosis, executive function, treatment, and daily life',
      description:
        'A curated Deeper Global hub for ADHD in adults—diagnosis, executive dysfunction, emotional overwhelm, medication, work accommodations, relationships, and daily coping.',
      isPartOf: {
        '@id': websiteId(),
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: hubQuestions.length,
        itemListElement: hubQuestions.slice(0, 24).map((question, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: siteUrl(`/answers/${question.slug}`),
          name: getAnswerDisplayTitle(question),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl(ADHD_HUB_PATH)}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Deeper Global',
          item: siteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'ADHD',
          item: siteUrl(ADHD_HUB_PATH),
        },
      ],
    },
  ],
};
---

<BaseLayout
  title="ADHD Hub: Diagnosis, Focus, Treatment & Daily Life | Deeper Global"
  description="Explore evidence-informed answers about adult ADHD—signs, testing, executive dysfunction, emotional overwhelm, medication, work accommodations, relationships, and routines."
  canonicalPath={ADHD_HUB_PATH}
  jsonLd={jsonLd}
>
  <main>
    <section class="hero ai-hub-hero">
      <div class="container">
        <p class="eyebrow">ADHD hub</p>
        <h1>ADHD questions and answers.</h1>
        <p class="lede">
          A curated hub for adults navigating attention, executive function, emotional intensity, treatment decisions, work, and relationships—with structured answers built for mobile reading and responsible care navigation.
        </p>
        <div class="hub-actions">
          <a class="button" href="/answers/?q=ADHD">Search ADHD answers</a>
          <a class="button secondary" href="/categories/neurodivergence-and-attention">Topic hub</a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container hub-intro-grid">
        <article class="card hub-signal-card">
          <p class="eyebrow">Coverage</p>
          <h2>{hubQuestions.length} ADHD-related answers</h2>
          <p>
            Diagnosis and testing, executive dysfunction, time blindness, rejection sensitivity, medication, burnout, work accommodations, study skills, and relationship communication—organized for bingeable, calm reading.
          </p>
        </article>
        <article class="card hub-signal-card">
          <p class="eyebrow">Care boundary</p>
          <h2>Education, not diagnosis.</h2>
          <p>
            These answers explain patterns and options. Only a qualified clinician can determine whether ADHD or another condition fits your experience and what treatment is appropriate.
          </p>
        </article>
      </div>
    </section>

    {
      featuredQuestions.length ? (
        <section class="section featured-section">
          <div class="container">
            <div class="section-header">
              <div>
                <p class="eyebrow">Start here</p>
                <h2>Most searched ADHD concerns.</h2>
              </div>
            </div>
            <div class="question-grid">
              {featuredQuestions.map((question) => <AnswerCard question={question} />)}
            </div>
          </div>
        </section>
      ) : null
    }

    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">Concern map</p>
            <h2>Browse the ADHD cluster.</h2>
          </div>
        </div>
        <div class="cluster-grid">
          {
            clusterCards.map((cluster) => (
              <article class="card hub-cluster-card">
                <h3>{cluster.name}</h3>
                <p>{cluster.description}</p>
                <ul>
                  {cluster.questions.map((question) => (
                    <li>
                      <a href={answerPath(question.slug)}>{getAnswerDisplayTitle(question)}</a>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <p class="eyebrow">All ADHD answers</p>
            <h2>Recently added and related pages.</h2>
          </div>
          <a class="text-link" href="/answers/?q=ADHD">Search the answer library</a>
        </div>
        <div class="answer-list hub-answer-list">
          {hubQuestions.slice(0, 24).map((question) => <AnswerCard question={question} />)}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
