---
import AnswersLibraryLayout from '@/components/answers-library/AnswersLibraryLayout.astro';
import DiscoveryRow from '@/components/DiscoveryRow.astro';
import EmptyState from '@/components/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildAnswersSidebarData } from '@/lib/answers-sidebar';
import { orderAnswersLibrary } from '@/lib/answers-library-order';
import { getQuestions } from '@/lib/supabase';
import { filterPublishableQuestions } from '@/lib/indexing-policy';

const questions = orderAnswersLibrary(filterPublishableQuestions(await getQuestions()));
const sidebar = buildAnswersSidebarData(questions);
const pageSize = 48;
const visibleQuestions = questions.slice(0, pageSize);
const totalPages = Math.ceil(questions.length / pageSize);
---

<BaseLayout
  title="Mental Health Questions and Answers | Deeper Global"
  description="Browse Deeper Global's evidence-informed mental health answer library, organized for people seeking clear language before, during, or after care."
  canonicalPath="/answers"
>
  <main class="discovery-surface">
    <section class="catalog-hero">
      <div class="container">
        <p class="eyebrow">Answer library</p>
        <h1>Mental health questions and answers.</h1>
        <p class="lede">A structured library of clear, vetted answers for people seeking context before, during, or after care.</p>
        <form class="catalog-search answer-search" action="/answers/" method="get" role="search" aria-label="Search mental health answers">
          <input
            id="answer-search-input"
            name="q"
            type="search"
            placeholder="Search the answer library"
            autocomplete="off"
          />
        </form>
      </div>
    </section>

    <section class="section answers-library-body">
      <div class="container">
        <AnswersLibraryLayout sidebar={sidebar}>
          <p class="search-status" id="answer-search-status" hidden></p>
          <div class="discovery-list answer-list" id="answer-results">
            {
              visibleQuestions.length ? (
                visibleQuestions.map((question) => <DiscoveryRow question={question} />)
              ) : (
                <EmptyState
                  title="No live answers available yet"
                  message="This build did not have Supabase credentials. Configure the environment and rebuild to generate the answer library."
                />
              )
            }
          </div>
          {
            totalPages > 1 && (
              <nav class="pagination" aria-label="Answer library pages" id="answer-pagination">
                <span>Page 1 of {totalPages}</span>
                <a href="/answers/page/2/">Next</a>
              </nav>
            )
          }
        </AnswersLibraryLayout>
      </div>
    </section>
  </main>

  <script>
    const SEARCH_INDEX_URL = '/answers/search-index.json';
    const searchInput = document.querySelector<HTMLInputElement>('#answer-search-input');
    const resultsElement = document.querySelector<HTMLElement>('#answer-results');
    const statusElement = document.querySelector<HTMLElement>('#answer-search-status');
    const paginationElement = document.querySelector<HTMLElement>('#answer-pagination');

    const queryExpansions: Record<string, string[]> = {
      sex: ['sexual', 'intimacy', 'porn', 'pornography', 'compulsive'],
      addiction: ['addictive', 'substance', 'sobriety', 'recovery', 'relapse', 'compulsive'],
      anxious: ['anxiety', 'stress', 'worry', 'panic'],
      anxiety: ['anxious', 'stress', 'worry', 'panic'],
      depressed: ['depression', 'sad', 'numb', 'mood'],
      depression: ['depressed', 'sad', 'numb', 'mood'],
      therapy: ['therapist', 'counseling', 'treatment', 'support'],
    };

    function normalize(value: string) {
      return value
        .toLowerCase()
        .replace(/[’']/g, '')
        .replace(/[^a-z0-9]+/g, ' ')
        .trim();
    }

    function escapeHtml(value: string) {
      return value
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function queryTokens(query: string) {
      const baseTokens = normalize(query)
        .split(' ')
        .filter((token) => token.length > 1);
      const expandedTokens = baseTokens.flatMap((token) => [token, ...(queryExpansions[token] ?? [])]);
      return Array.from(new Set(expandedTokens));
    }

    function scoreResult(item: { title: string; category: string; searchableText: string }, query: string) {
      const normalizedQuery = normalize(query);
      const normalizedTitle = normalize(item.title);
      const normalizedCategory = normalize(item.category);
      const normalizedText = normalize(item.searchableText);
      const originalTokens = normalize(query)
        .split(' ')
        .filter((token) => token.length > 1);
      const expandedTokens = queryTokens(query).filter((token) => !originalTokens.includes(token));
      let score = 0;

      if (normalizedTitle.includes(normalizedQuery)) score += 80;
      if (normalizedCategory.includes(normalizedQuery)) score += 60;
      if (normalizedText.includes(normalizedQuery)) score += 40;

      if (originalTokens.length > 1 && originalTokens.every((token) => normalizedTitle.includes(token))) score += 70;
      if (originalTokens.length > 1 && originalTokens.every((token) => normalizedText.includes(token))) score += 35;

      if (originalTokens.includes('sex') && originalTokens.includes('addiction')) {
        if (/process addiction|porn|pornography|compulsive sexual/.test(normalizedTitle)) score += 90;
        if (/process addiction|porn|pornography|compulsive sexual/.test(normalizedText)) score += 90;
      }

      for (const token of originalTokens) {
        if (normalizedTitle.includes(token)) score += 30;
        if (normalizedCategory.includes(token)) score += 18;
        if (normalizedText.includes(token)) score += 8;
      }

      for (const token of expandedTokens) {
        if (normalizedTitle.includes(token)) score += 10;
        if (normalizedCategory.includes(token)) score += 8;
        if (normalizedText.includes(token)) score += 3;
      }

      return score;
    }

    function safeSearchTerm(value: string) {
      return normalize(value)
        .replace(/\b[\w.%+-]+@[\w.-]+\.[a-z]{2,}\b/g, '[email]')
        .replace(/\b(?:\+?1[-.\s]?)?(?:\(?\d{3}\)?[-.\s]?)?\d{3}[-.\s]?\d{4}\b/g, '[phone]')
        .slice(0, 80);
    }

    function searchIntentStage(value: string) {
      const text = normalize(value);
      if (/suicide|self harm|overdose|crisis|unsafe|danger/.test(text)) return 'risk_support';
      if (/therapy|therapist|counseling|treatment|professional help|support/.test(text)) return 'care_navigation';
      if (/partner|relationship|conflict|parent|family|friend|co parent/.test(text)) return 'relationship_navigation';
      if (/identity|self worth|belong|meaning|purpose|esteem/.test(text)) return 'identity_meaning';
      if (/cope|calm|manage|stop|what should i do|how can i/.test(text)) return 'self_management';
      return 'understanding_symptom';
    }

    function searchSensitivity(value: string) {
      const text = normalize(value);
      if (/suicide|self harm|overdose|crisis|unsafe|danger/.test(text)) return 'crisis-sensitive';
      if (/addiction|substance|sobriety|relapse|withdrawal|porn/.test(text)) return 'addiction';
      if (/trauma|ptsd|flashback|grief/.test(text)) return 'trauma';
      if (/abuse|violence|coercion|stalking/.test(text)) return 'abuse';
      if (/teen|child|parenting|minor/.test(text)) return 'minor';
      if (/medication|antidepressant|ssri|snri|prescription/.test(text)) return 'medication';
      return 'standard';
    }

    function resultTemplate(
      item: { title: string; summary: string; category: string; categoryUrl: string; url: string; updated: string },
      index: number
    ) {
      return `
      <article class="discovery-row">
        <h2 class="discovery-row-title">
          <a href="${escapeHtml(item.url)}" data-search-result="true" data-search-result-position="${index + 1}" data-search-result-category="${escapeHtml(item.category)}">${escapeHtml(item.title)}</a>
        </h2>
        <p class="discovery-summary">${escapeHtml(item.summary)}</p>
        <p class="editorial-meta discovery-meta">
          ${escapeHtml(item.category)}
          <span class="meta-sep" aria-hidden="true">·</span>
          Updated ${escapeHtml(item.updated)}
        </p>
      </article>
    `;
    }

    type SearchIndexEntry = {
      title: string;
      summary: string;
      category: string;
      categoryUrl: string;
      url: string;
      updated: string;
      searchableText: string;
    };

    // The index is fetched lazily (only when a search runs) and cached for
    // subsequent searches on the same page view.
    let searchIndexPromise: Promise<SearchIndexEntry[]> | null = null;

    function loadSearchIndex() {
      if (!searchIndexPromise) {
        searchIndexPromise = fetch(SEARCH_INDEX_URL)
          .then((response) => {
            if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
            return response.json() as Promise<SearchIndexEntry[]>;
          })
          .catch((error) => {
            // Allow a retry on the next search instead of caching the failure.
            searchIndexPromise = null;
            throw error;
          });
      }

      return searchIndexPromise;
    }

    async function runSearch(query: string) {
      if (!resultsElement || !statusElement) return;

      const trimmedQuery = query.trim();
      if (!trimmedQuery) return;

      let index: SearchIndexEntry[];
      try {
        index = await loadSearchIndex();
      } catch {
        // Graceful failure: keep the server-rendered library usable.
        statusElement.hidden = false;
        statusElement.textContent = 'Search is temporarily unavailable. Browse the library below or try again shortly.';
        return;
      }

      const results = index
        .map((item) => ({
          item,
          score: scoreResult(item, trimmedQuery),
        }))
        .filter((result) => result.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 48)
        .map((result) => result.item);

      if (searchInput) searchInput.value = trimmedQuery;
      if (paginationElement) paginationElement.hidden = true;
      statusElement.hidden = false;
      statusElement.textContent = results.length
        ? `Showing ${results.length} result${results.length === 1 ? '' : 's'} for "${trimmedQuery}".`
        : `No direct matches for "${trimmedQuery}" yet. Try a broader phrase like anxiety, addiction, therapy, grief, or relationship.`;

      const topResult = results[0];

      window.deeperTrackEvent?.('site_search_performed', {
        content_type: 'search',
        category: topResult?.category,
        search_topic: topResult?.category,
        search_term: safeSearchTerm(trimmedQuery),
        search_token_count: normalize(trimmedQuery).split(' ').filter(Boolean).length,
        search_result_count: results.length,
        search_has_results: results.length > 0,
        intent_stage: searchIntentStage(trimmedQuery),
        sensitivity: searchSensitivity(trimmedQuery),
      });

      resultsElement.innerHTML = results.length
        ? results.map(resultTemplate).join('')
        : '<article class="discovery-row"><h2 class="discovery-row-title">No matching answers found</h2><p class="discovery-summary">Try a broader search term or browse the full answer library.</p></article>';
    }

    const initialQuery = new URLSearchParams(window.location.search).get('q') ?? '';
    void runSearch(initialQuery);

    resultsElement?.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-search-result="true"]') : null;
      if (!link) return;

      window.deeperTrackEvent?.('site_search_result_clicked', {
        content_type: 'search',
        search_term: safeSearchTerm(searchInput?.value ?? initialQuery),
        search_result_position: Number(link.dataset.searchResultPosition ?? 0),
        category: link.dataset.searchResultCategory,
        search_topic: link.dataset.searchResultCategory,
        target_path: link.getAttribute('href') ?? undefined,
      });
    });
  </script>
</BaseLayout>
