---
import CrisisBanner from '@/components/CrisisBanner.astro';
import DiscoveryRow from '@/components/DiscoveryRow.astro';
import QuestionContextPanel from '@/components/QuestionContextPanel.astro';
import RelatedTrail from '@/components/RelatedTrail.astro';
import PractitionerCallout from '@/components/PractitionerCallout.astro';
import SourceRefsBlock from '@/components/sidebar/SourceRefsBlock.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isAdhdHubSlug } from '@/lib/adhd-hub';
import { isAiMentalHealthSprintQuestion } from '@/lib/ai-mental-health-hub';
import { isAnxietyHubSlug } from '@/lib/anxiety-hub';
import { getModalityCardsForAnswer, modalityPath } from '@/lib/modality-hub';
import {
  answerPath,
  bodyTextToParagraphHtml,
  buildRelatedContentContext,
  categoryPath,
  displayCategory,
  formatAnswerHtml,
  formatDate,
  getAnswerMetaDescription,
  getAnswerPlainText,
  getAnswerDisplayTitle,
  getAnswerSchemaAnswer,
  getAnswerSchemaQuestion,
  getAnswerSummary,
  getCareNote,
  getDisplayKeyTakeaways,
  getDisplayLede,
  getPrimaryTheme,
  getQuestionCitation,
  getRelatedQuestions,
  resolveFollowUpQuestions,
  isCrisisSensitive,
  shouldIndexQuestion,
  slugify,
  truncate,
  type RelatedContentContext,
} from '@/lib/content';
import { getAnswerPractitionerLink } from '@/lib/practitioner-links';
import { resolveSemanticEnrichmentSync, getPilotEnrichmentBySlug } from '@/lib/semantic-enrichment';
import { CONTENT_LICENSE_URL, organizationId, siteUrl, websiteId } from '@/lib/site';
import { qaPageNode } from '@/lib/schema';
import { getCanonicalTopic } from '@/lib/taxonomy';
import {
  getReviewedAt,
  getReviewedByLabel,
  getReviewerDisplayLabel,
  getReviewerProfile,
  getReviewerSchemaNode,
  getReviewStatusLabel,
  getSourceRefs,
  isInternalReviewerLabel,
} from '@/lib/trust';
import AnswerAttributionBlock from '@/components/attribution/AnswerAttributionBlock.astro';
import { resolveAttribution } from '@/lib/attribution/resolve-attribution';
import { getQuestionBySlug, getQuestions, getModalities, type Question } from '@/lib/supabase';
import { filterPublishableQuestions } from '@/lib/indexing-policy';
import { answerOgImagePath } from '@/lib/og-answer-image';

export async function getStaticPaths() {
  const questions = filterPublishableQuestions(await getQuestions());
  // Built once per build and shared by every answer page via props; without
  // this each page rebuilds the full-corpus matching indexes.
  const relatedContext = buildRelatedContentContext(questions);

  return questions.map((question) => ({
    params: { slug: question.slug },
    props: {
      question,
      allQuestions: questions,
      relatedContext,
    },
  }));
}

const {
  question: suppliedQuestion,
  allQuestions: suppliedQuestions,
  relatedContext: suppliedRelatedContext,
} = Astro.props as {
  question?: Question;
  allQuestions?: Question[];
  relatedContext?: RelatedContentContext;
};

const question = suppliedQuestion ?? (await getQuestionBySlug(Astro.params.slug ?? ''));

if (!question) {
  return Astro.redirect('/answers');
}

const allQuestions = suppliedQuestions ?? (await getQuestions());
const relatedContext = suppliedRelatedContext ?? buildRelatedContentContext(allQuestions);
const allModalities = await getModalities();
const relatedQuestions = getRelatedQuestions(question, allQuestions, 4, relatedContext);
const relatedModalities = getModalityCardsForAnswer(question.slug, allModalities);
const category = displayCategory(question);
const displayTitle = getAnswerDisplayTitle(question);
const summary = getAnswerSummary(question);
const schemaQuestion = getAnswerSchemaQuestion(question);
const schemaAnswerText = getAnswerSchemaAnswer(question);
const keyTakeaways = getDisplayKeyTakeaways(question);
const followUpQuestions = resolveFollowUpQuestions(question, allQuestions, relatedContext);
const primaryTheme = getPrimaryTheme(question);
const updatedAt = question.updated_at || question.created_at;
const crisisSensitive = isCrisisSensitive(question);
const careNote = getCareNote(question, crisisSensitive);
const title = `${displayTitle} | Deeper Global`;
const description = getAnswerMetaDescription(question);
const citation = getQuestionCitation(question);
const stagedExperiencing = question.staging_what_you_might_be_experiencing?.trim() ?? '';
const stagedCanHelp = question.staging_what_can_help?.trim() ?? '';
const stagedReachOut = question.staging_when_to_reach_out?.trim() ?? '';
const stagedExperiencingHtml = stagedExperiencing ? bodyTextToParagraphHtml(stagedExperiencing) : null;
const stagedCanHelpHtml = stagedCanHelp ? bodyTextToParagraphHtml(stagedCanHelp) : null;
const stagedReachOutHtml = stagedReachOut ? bodyTextToParagraphHtml(stagedReachOut) : null;
const answerHtml = formatAnswerHtml(question);
const answerText = getAnswerPlainText(question);
const extractableAnswer = truncate(schemaAnswerText || answerText, 700);
const answerUrl = siteUrl(`/answers/${question.slug}`);
const categoryUrl = siteUrl(categoryPath(category));
const entityUrl = siteUrl(`/entities/${slugify(category)}`);
// Canonical 16-topic taxonomy (src/lib/taxonomy.ts) — the same mapping used to
// build /topics/[topic].astro, so this @id always matches an actually-built
// page. `entityUrl` above stays intact as a secondary `mentions` relationship
// to the raw-category entity page.
const canonicalTopic = getCanonicalTopic(question.category || question.raw_category || question.primary_theme);
const topicUrl = siteUrl(`/topics/${canonicalTopic.slug}`);
const topicId = `${topicUrl}#topic`;
const questionId = `${answerUrl}#question`;
const answerId = `${answerUrl}#accepted-answer`;
const articleId = `${answerUrl}#article`;
const pageId = `${answerUrl}#webpage`;
const qaPageId = `${answerUrl}#qapage`;
const shouldIndex = shouldIndexQuestion(question);
const practitionerLink = getAnswerPractitionerLink(question.slug);
const isAiMentalHealthAnswer = isAiMentalHealthSprintQuestion(question);
const isAdhdHubAnswer = isAdhdHubSlug(question.slug);
const isAnxietyHubAnswer = isAnxietyHubSlug(question.slug);
const semanticEnrichment = resolveSemanticEnrichmentSync(question, getPilotEnrichmentBySlug());
const reviewedBy = getReviewedByLabel(question);
const reviewerDisplayLabel = getReviewerDisplayLabel(question);
const reviewerProfile = getReviewerProfile(question);
const reviewedAt = getReviewedAt(question);
const reviewStatus = getReviewStatusLabel(question);
const reviewStatusDisplay = reviewStatus
  ? reviewStatus.replace(/[-_]+/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase())
  : '';
const sourceRefs = getSourceRefs(question);
const sourceCitationUrls = sourceRefs.map((source) => source.url).filter(Boolean);
const displayLede = getDisplayLede(question);
const reviewerSchemaNode = getReviewerSchemaNode(question);
const attribution = resolveAttribution({ question, reviewerProfile });
const trustUpdatedLabel = attribution.updatedAt ? formatDate(attribution.updatedAt) : formatDate(updatedAt);
const hasTrustSidebar = Boolean(
  attribution.state !== 'none' || reviewedBy || reviewedAt || reviewStatusDisplay || sourceRefs.length > 0
);

type RelatedSidebarLink = { href: string; label: string };

const relatedSidebarLinks: RelatedSidebarLink[] = [
  ...followUpQuestions.map((q) => ({
    href: answerPath(q.slug),
    label: q.improved_title ?? q.question,
  })),
  ...relatedModalities.map((modality) => ({
    href: `${modalityPath(modality.slug)}/`,
    label: modality.name,
  })),
  ...(isAdhdHubAnswer ? [{ href: '/adhd/', label: 'ADHD hub' }] : []),
  ...(isAiMentalHealthAnswer ? [{ href: '/ai-mental-health/', label: 'AI mental health hub' }] : []),
  ...(isAnxietyHubAnswer ? [{ href: '/anxiety/', label: 'Anxiety hub' }] : []),
  { href: categoryPath(category), label: `${category} topic hub` },
];

// Schema accuracy: only true clinical reviewers use reviewedBy.
// Specialty contributors are linked as contributor / mentions Person entities.
const reviewedBySchema =
  attribution.schemaRole === 'reviewedBy' && reviewerSchemaNode
    ? { reviewedBy: { '@id': reviewerSchemaNode['@id'] } }
    : attribution.schemaRole === 'reviewedBy' && reviewedBy
      ? {
          reviewedBy: {
            '@type': isInternalReviewerLabel(reviewedBy) ? 'Organization' : 'Person',
            name: reviewerDisplayLabel || attribution.personName,
          },
        }
      : {};
const contributorSchema =
  attribution.schemaRole === 'contributor' && reviewerSchemaNode
    ? {
        contributor: { '@id': reviewerSchemaNode['@id'] },
      }
    : {};
const sourceCitationSchema =
  sourceCitationUrls.length > 0
    ? {
        citation: sourceCitationUrls,
      }
    : {};
const licenseSchema = {
  license: CONTENT_LICENSE_URL,
  isAccessibleForFree: true,
};
const jsonLd = {
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': pageId,
      url: answerUrl,
      name: displayTitle,
      description,
      datePublished: question.created_at,
      dateModified: updatedAt,
      isPartOf: {
        '@id': websiteId(),
      },
      publisher: {
        '@id': organizationId(),
      },
      about: {
        '@id': topicId,
      },
      mentions: {
        '@id': `${entityUrl}#entity`,
      },
      mainEntity: {
        '@id': qaPageId,
      },
      ...reviewedBySchema,
      ...contributorSchema,
      ...sourceCitationSchema,
      ...licenseSchema,
    },
    qaPageNode({
      pageUrl: answerUrl,
      pageId: qaPageId,
      questionId,
      answerId,
    }),
    {
      '@type': 'Article',
      '@id': articleId,
      headline: displayTitle,
      description,
      articleBody: answerText,
      datePublished: question.created_at,
      dateModified: updatedAt,
      author: {
        '@id': organizationId(),
      },
      publisher: {
        '@id': organizationId(),
      },
      mainEntityOfPage: {
        '@id': pageId,
      },
      about: {
        '@id': topicId,
      },
      mentions: {
        '@id': `${entityUrl}#entity`,
      },
      ...reviewedBySchema,
      ...contributorSchema,
      ...sourceCitationSchema,
      ...licenseSchema,
    },
    {
      '@type': 'Question',
      '@id': questionId,
      name: schemaQuestion,
      text: schemaQuestion,
      dateCreated: question.created_at,
      about: {
        '@id': topicId,
      },
      mentions: {
        '@id': `${entityUrl}#entity`,
      },
      author: {
        '@id': organizationId(),
      },
      acceptedAnswer: {
        '@id': answerId,
      },
    },
    {
      '@type': 'Answer',
      '@id': answerId,
      url: `${answerUrl}#accepted-answer`,
      text: schemaAnswerText,
      dateCreated: question.created_at,
      dateModified: updatedAt,
      citation: citation.url,
      author: {
        '@id': organizationId(),
      },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${entityUrl}#entity`,
      name: primaryTheme,
      inDefinedTermSet: 'Deeper Global Mental Health Topic Map',
      url: entityUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${answerUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Deeper Global',
          item: siteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category,
          item: categoryUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: displayTitle,
          item: answerUrl,
        },
      ],
    },
    ...(reviewerSchemaNode ? [reviewerSchemaNode] : []),
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={`/answers/${question.slug}`}
  ogType="article"
  jsonLd={jsonLd}
  noindex={!shouldIndex}
  imagePath={answerOgImagePath(question.slug, updatedAt)}
  imageAlt={`Deeper Global — ${displayTitle}`}
>
  {crisisSensitive && <CrisisBanner />}
  <main class="answer-page answer-page--direction-d">
    <nav class="answer-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Deeper Global</a>
      <span aria-hidden="true">/</span>
      <a href={categoryPath(category)}>{category}</a>
      <span aria-hidden="true">/</span>
      <span>{truncate(displayTitle, 54)}</span>
    </nav>

    <article
      class="answer-layout answer-layout--direction-d"
      data-ai-content-type="mental-health-answer"
      data-ai-citable="true"
      data-question-id={question.id}
      data-question-slug={question.slug}
      data-primary-entity={primaryTheme}
      data-risk-class={crisisSensitive ? 'crisis-sensitive' : 'standard'}
      itemscope
      itemtype="https://schema.org/Article"
    >
      <meta itemprop="datePublished" content={question.created_at} />
      <meta itemprop="dateModified" content={updatedAt} />
      <meta itemprop="author" content="Deeper Global" />

      <div class="answer-reading-panel">
        <div class="answer-reading-column">
          <nav class="answer-breadcrumb-inline" aria-label="Answer context">
            {category} / Answer
          </nav>

          <h1 itemprop="headline">{displayTitle}</h1>

          <p class="editorial-meta">
            {category}
            {
              attribution.publicRoleLabel && (
                <>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  {attribution.state === 'clinical_reviewer'
                    ? 'Clinical reviewer'
                    : attribution.state === 'editorial_named' || attribution.state === 'editorial_deeper'
                      ? 'Editorial review'
                      : 'Clinical contributor'}
                </>
              )
            }
            {
              attribution.showUpdatedDate && (
                <>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  Updated {trustUpdatedLabel}
                </>
              )
            }
            {
              sourceRefs.length > 0 && (
                <>
                  <span class="meta-sep" aria-hidden="true">·</span>
                  {sourceRefs.length} cited source{sourceRefs.length === 1 ? '' : 's'}
                </>
              )
            }
          </p>

          <p
            class="answer-lede"
            id="answer-summary"
            data-ai-section="answer-summary"
          >
            {displayLede}
          </p>

          {
            keyTakeaways.length > 0 && (
              <section
                class="takeaways-rule"
                aria-labelledby="key-takeaways-title"
                data-ai-section="key-takeaways"
              >
                <h2 class="takeaways-rule-label" id="key-takeaways-title">Key takeaways</h2>
                <ul>
                  {keyTakeaways.map((takeaway) => (
                    <li>{takeaway}</li>
                  ))}
                </ul>
              </section>
            )
          }

          <section
            id="accepted-answer"
            class="accepted-answer"
            aria-label="Accepted answer"
            data-ai-section="accepted-answer"
            data-ai-extract={extractableAnswer}
            itemprop="articleBody"
          >
            {
              stagedExperiencingHtml && stagedCanHelpHtml && stagedReachOutHtml ? (
                <div class="enriched-answer">
                  <section class="answer-section" data-ai-section="experiencing">
                    <h2>What you might be experiencing</h2>
                    <div set:html={stagedExperiencingHtml} />
                  </section>
                  <section class="answer-section" data-ai-section="can-help">
                    <h2>What can help</h2>
                    <div set:html={stagedCanHelpHtml} />
                  </section>
                  <section class="answer-section" data-ai-section="reach-out">
                    <h2>When to reach out</h2>
                    <div set:html={stagedReachOutHtml} />
                  </section>
                </div>
              ) : (
                <div set:html={answerHtml} />
              )
            }
          </section>

          {
            practitionerLink && (
              <div class="answer-supplement">
                <PractitionerCallout
                  title={practitionerLink.title}
                  body={practitionerLink.body}
                  href={practitionerLink.href}
                  label={practitionerLink.label}
                />
              </div>
            )
          }

          {semanticEnrichment ? (
            <div class="answer-supplement">
              <QuestionContextPanel enrichment={semanticEnrichment} />
            </div>
          ) : null}

          <section class="answer-citation" id="citation" aria-label="Citation metadata" data-ai-section="citation">
            <h2>How to cite this answer</h2>
            <dl>
              <div>
                <dt>Title</dt>
                <dd>{citation.title}</dd>
              </div>
              <div>
                <dt>Publisher</dt>
                <dd>{citation.publisher}</dd>
              </div>
              <div>
                <dt>Canonical URL</dt>
                <dd><a href={citation.url}>{citation.url}</a></dd>
              </div>
              <div>
                <dt>Updated</dt>
                <dd>{formatDate(citation.dateModified)}</dd>
              </div>
            </dl>
          </section>

          <RelatedTrail related={relatedQuestions} />
        </div>
      </div>

      <aside class="answer-sidebar" aria-label="Answer context">
        {
          hasTrustSidebar && (
            <section class="sidebar-block answer-trust-panel" aria-label="Editorial review information" data-ai-section="editorial-trust">
              <p class="sidebar-block-heading">Trust</p>

              <AnswerAttributionBlock attribution={attribution} />

              <ul class="trust-facts">
                {
                  sourceRefs.length > 0 && (
                    <li>
                      {sourceRefs.length} cited source{sourceRefs.length === 1 ? '' : 's'}
                    </li>
                  )
                }
              </ul>

              <nav class="trust-links-stack" aria-label="Editorial policies">
                <a href="/editorial-policy/">Editorial policy</a>
                <a href="/protocol/">Trust protocol</a>
              </nav>

              <div class="trust-disclaimer">
                <p>Educational content only.</p>
                <p>This answer does not create a therapist-client relationship.</p>
              </div>
            </section>
          )
        }

        {
          relatedSidebarLinks.length > 0 && (
            <section class="sidebar-block" aria-label="Related questions" data-ai-section="related-questions">
              <p class="sidebar-block-heading">Related</p>
              <ul class="sidebar-block-list">
                {relatedSidebarLinks.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </section>
          )
        }

        <SourceRefsBlock sources={sourceRefs} />

        <section class="sidebar-block sidebar-block--care" aria-label="Care guidance">
          <p class="sidebar-block-heading">Care</p>
          <p class="sidebar-block-text">{careNote}</p>
        </section>
      </aside>
    </article>

    {
      relatedQuestions.length > 0 && (
        <section
          class="section answer-related-section"
          aria-labelledby="answer-related-heading"
          data-ai-section="related-questions-bottom"
        >
          <div class="container">
            <p class="tier-index">Related questions</p>
            <h2 class="tier-heading" id="answer-related-heading">More answers in {category}</h2>
            <div class="discovery-list answer-related-list">
              {relatedQuestions.map((related) => (
                <DiscoveryRow question={related} headingLevel={3} summaryMaxLength={168} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
