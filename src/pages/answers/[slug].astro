---
import AnswerTrustPanel from '@/components/AnswerTrustPanel.astro';
import AnswerTrustStrip from '@/components/AnswerTrustStrip.astro';
import CrisisBanner from '@/components/CrisisBanner.astro';
import PractitionerCallout from '@/components/PractitionerCallout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isAdhdHubSlug } from '@/lib/adhd-hub';
import { getModalityCardsForAnswer, modalityPath } from '@/lib/modality-hub';
import {
  answerPath,
  categoryPath,
  displayCategory,
  formatDate,
  getAnswerMetaDescription,
  getAnswerPlainText,
  getAnswerDisplayTitle,
  getAnswerSchemaAnswer,
  getAnswerSchemaQuestion,
  getAnswerSummary,
  getCareNote,
  getDisplayAnswerHtml,
  getDisplayKeyTakeaways,
  getDisplayLede,
  getPrimaryTheme,
  getQuestionCitation,
  getRelatedQuestions,
  resolveFollowUpQuestionLinks,
  isCrisisSensitive,
  shouldIndexQuestion,
  slugify,
  truncate,
} from '@/lib/content';
import { getAnswerPractitionerLink } from '@/lib/practitioner-links';
import { organizationId, siteUrl, websiteId } from '@/lib/site';
import {
  getReviewedByLabel,
  getReviewerDisplayLabel,
  getReviewerSchemaNode,
  getSourceRefs,
  isInternalReviewerLabel,
} from '@/lib/trust';
import { getQuestionBySlug, getQuestions, getModalities, type Question } from '@/lib/supabase';

export async function getStaticPaths() {
  const questions = await getQuestions();
  return questions.map((question) => ({
    params: { slug: question.slug },
    props: { question },
  }));
}

const suppliedQuestion = Astro.props.question as Question | undefined;
const question = suppliedQuestion ?? (await getQuestionBySlug(Astro.params.slug ?? ''));

if (!question) {
  return Astro.redirect('/answers');
}

const allQuestions = await getQuestions();
const allModalities = await getModalities();
const relatedQuestions = getRelatedQuestions(question, allQuestions);
const relatedModalities = getModalityCardsForAnswer(question.slug, allModalities);
const category = displayCategory(question);
const displayTitle = getAnswerDisplayTitle(question);
const summary = getAnswerSummary(question);
const schemaQuestion = getAnswerSchemaQuestion(question);
const schemaAnswerText = getAnswerSchemaAnswer(question);
const keyTakeaways = getDisplayKeyTakeaways(question);
const followUpLinks = resolveFollowUpQuestionLinks(question, allQuestions);
const primaryTheme = getPrimaryTheme(question);
const updatedAt = question.updated_at || question.created_at;
const crisisSensitive = isCrisisSensitive(question);
const careNote = getCareNote(question, crisisSensitive);
const title = `${displayTitle} | Deeper Global`;
const description = getAnswerMetaDescription(question);
const citation = getQuestionCitation(question);
const answerHtml = getDisplayAnswerHtml(question);
const answerText = getAnswerPlainText(question);
const extractableAnswer = truncate(schemaAnswerText || answerText, 700);
const answerUrl = siteUrl(`/answers/${question.slug}`);
const categoryUrl = siteUrl(categoryPath(category));
const entityUrl = siteUrl(`/entities/${slugify(category)}`);
const questionId = `${answerUrl}#question`;
const answerId = `${answerUrl}#accepted-answer`;
const articleId = `${answerUrl}#article`;
const pageId = `${answerUrl}#webpage`;
const shouldIndex = shouldIndexQuestion(question);
const practitionerLink = getAnswerPractitionerLink(question.slug);
const isAiMentalHealthAnswer = question.content_prompt_version === 'deeper-ai-concerns-sprint-v1';
const isAdhdHubAnswer = isAdhdHubSlug(question.slug);
const reviewedBy = getReviewedByLabel(question);
const reviewerDisplayLabel = getReviewerDisplayLabel(question);
const reviewerSchemaNode = getReviewerSchemaNode(question);
const sourceRefs = getSourceRefs(question);
const sourceCitationUrls = sourceRefs.map((source) => source.url).filter(Boolean);
const displayLede = getDisplayLede(question);
const reviewedBySchema = reviewedBy
  ? {
      reviewedBy: reviewerSchemaNode ?? {
        '@type': isInternalReviewerLabel(reviewedBy) ? 'Organization' : 'Person',
        name: reviewerDisplayLabel,
      },
    }
  : {};
const sourceCitationSchema =
  sourceCitationUrls.length > 0
    ? {
        citation: sourceCitationUrls,
      }
    : {};
const jsonLd = {
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': pageId,
      url: answerUrl,
      name: displayTitle,
      description,
      datePublished: question.created_at,
      dateModified: updatedAt,
      isPartOf: {
        '@id': websiteId(),
      },
      publisher: {
        '@id': organizationId(),
      },
      about: {
        '@id': `${entityUrl}#entity`,
      },
      mainEntity: {
        '@id': articleId,
      },
      ...reviewedBySchema,
      ...sourceCitationSchema,
    },
    {
      '@type': 'Article',
      '@id': articleId,
      headline: displayTitle,
      description,
      articleBody: answerText,
      datePublished: question.created_at,
      dateModified: updatedAt,
      author: {
        '@id': organizationId(),
      },
      publisher: {
        '@id': organizationId(),
      },
      mainEntityOfPage: {
        '@id': pageId,
      },
      about: {
        '@id': `${entityUrl}#entity`,
      },
      ...reviewedBySchema,
      ...sourceCitationSchema,
    },
    {
      '@type': 'Question',
      '@id': questionId,
      name: schemaQuestion,
      text: schemaQuestion,
      dateCreated: question.created_at,
      about: {
        '@id': `${entityUrl}#entity`,
        name: primaryTheme,
      },
      author: {
        '@id': organizationId(),
      },
      acceptedAnswer: {
        '@id': answerId,
      },
    },
    {
      '@type': 'Answer',
      '@id': answerId,
      url: `${answerUrl}#accepted-answer`,
      text: schemaAnswerText,
      dateCreated: question.created_at,
      dateModified: updatedAt,
      citation: citation.url,
      author: {
        '@id': organizationId(),
      },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${entityUrl}#entity`,
      name: primaryTheme,
      inDefinedTermSet: 'Deeper Global Mental Health Topic Map',
      url: entityUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${answerUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Deeper Global',
          item: siteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category,
          item: categoryUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: displayTitle,
          item: answerUrl,
        },
      ],
    },
    ...(reviewerSchemaNode ? [reviewerSchemaNode] : []),
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath={`/answers/${question.slug}`} ogType="article" jsonLd={jsonLd} noindex={!shouldIndex}>
  {crisisSensitive && <CrisisBanner />}
  <main>
    <nav class="answer-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Deeper Global</a>
      <span aria-hidden="true">/</span>
      <a href={categoryPath(category)}>{category}</a>
      <span aria-hidden="true">/</span>
      <span>{truncate(displayTitle, 54)}</span>
    </nav>

    <article
      class="answer-layout"
      data-ai-content-type="mental-health-answer"
      data-ai-citable="true"
      data-question-id={question.id}
      data-question-slug={question.slug}
      data-primary-entity={primaryTheme}
      data-risk-class={crisisSensitive ? 'crisis-sensitive' : 'standard'}
      itemscope
      itemtype="https://schema.org/Article"
    >
      <meta itemprop="datePublished" content={question.created_at} />
      <meta itemprop="dateModified" content={updatedAt} />
      <meta itemprop="author" content="Deeper Global" />
      <div class="answer-main">
        <a class="answer-topic-badge" href={categoryPath(category)}>{category}</a>
        <h1 itemprop="headline">{displayTitle}</h1>
        <AnswerTrustStrip question={question} updatedAt={updatedAt} />
        <section
          class="ai-answer-summary"
          id="answer-summary"
          aria-label="Structured answer summary"
          data-ai-section="answer-summary"
        >
          <p class="summary">{displayLede}</p>
        </section>
        {
          keyTakeaways.length > 0 && (
            <section class="key-takeaways" aria-labelledby="key-takeaways-title" data-ai-section="key-takeaways">
              <h2 id="key-takeaways-title">Key takeaways</h2>
              <ul>
                {keyTakeaways.map((takeaway) => (
                  <li>
                    <span class="takeaway-mark" aria-hidden="true">—</span>
                    {takeaway}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <section
          id="accepted-answer"
          class="accepted-answer"
          aria-label="Accepted answer"
          data-ai-section="accepted-answer"
          data-ai-extract={extractableAnswer}
          itemprop="articleBody"
        >
          <div set:html={answerHtml} />
        </section>
      </div>

      <aside class="answer-sidebar" aria-label="Answer context">
        <AnswerTrustPanel question={question} updatedAt={updatedAt} />
        <section class="sidebar-card">
          <p class="sidebar-label">Related theme</p>
          <a class="sidebar-entity" href={categoryPath(category)}>{category}</a>
          <p>Browse the topic hub for more {category.toLowerCase()} answers.</p>
          <a class="text-link" href={categoryPath(category)}>Open topic hub</a>
        </section>

        {
          relatedModalities.length ? (
            <section class="sidebar-card">
              <p class="sidebar-label">Therapy modalities</p>
              <ul class="sidebar-link-list">
                {
                  relatedModalities.map((modality) => (
                    <li>
                      <a href={`${modalityPath(modality.slug)}/`}>{modality.name}</a>
                    </li>
                  ))
                }
              </ul>
              <a class="text-link" href="/modalities/">Browse all modalities</a>
            </section>
          ) : null
        }

        {
          isAdhdHubAnswer && (
            <section class="sidebar-card">
              <p class="sidebar-label">ADHD hub</p>
              <a class="sidebar-entity" href="/adhd/">ADHD</a>
              <p>Explore the full cluster on diagnosis, executive dysfunction, emotional overwhelm, medication, work accommodations, and daily coping.</p>
              <a class="text-link" href="/adhd/">Open ADHD hub</a>
            </section>
          )
        }

        {
          isAiMentalHealthAnswer && (
            <section class="sidebar-card">
              <p class="sidebar-label">AI concern hub</p>
              <a class="sidebar-entity" href="/ai-mental-health/">AI mental health</a>
              <p>Explore the full cluster on AI psychosis, chatbot dependency, AI companions, privacy, work anxiety, and safety boundaries.</p>
              <a class="text-link" href="/ai-mental-health/">Open AI mental health hub</a>
            </section>
          )
        }

        {
          practitionerLink && (
            <PractitionerCallout
              title={practitionerLink.title}
              body={practitionerLink.body}
              href={practitionerLink.href}
              label={practitionerLink.label}
            />
          )
        }

        {
          followUpLinks.length > 0 && (
            <section class="sidebar-card follow-up-card" data-ai-section="follow-up-questions">
              <p class="sidebar-label">Questions people ask next</p>
              <ul class="sidebar-link-list">
                {followUpLinks.map((followUp) => (
                  <li>
                    <a href={followUp.href}>{followUp.label}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section class="citation-panel" id="citation" aria-label="Citation metadata" data-ai-section="citation">
          <h2>How to cite this answer</h2>
          <dl>
            <div>
              <dt>Title</dt>
              <dd>{citation.title}</dd>
            </div>
            <div>
              <dt>Publisher</dt>
              <dd>{citation.publisher}</dd>
            </div>
            <div>
              <dt>Canonical URL</dt>
              <dd><a href={citation.url}>{citation.url}</a></dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{formatDate(citation.dateModified)}</dd>
            </div>
          </dl>
        </section>

        <section class="care-card">
          <p class="sidebar-label">Not a substitute for care</p>
          <p>{careNote}</p>
        </section>
      </aside>
    </article>

    {
      relatedQuestions.length > 0 && (
        <section class="section related-section">
          <div class="container">
            <p class="eyebrow">Related questions</p>
            <h2>More answers in {category}</h2>
            <div class="rabbit-grid">
              {relatedQuestions.map((related) => (
                <a class="rabbit-card" href={answerPath(related.slug)}>
                  <span>{displayCategory(related)}</span>
                  <strong>{related.question}</strong>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .answer-breadcrumbs {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-sm);
    color: var(--stone);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }

  .answer-breadcrumbs a {
    color: var(--ocean);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .answer-breadcrumbs a:hover {
    color: var(--ocean-bright);
    text-decoration: underline;
  }

  .answer-breadcrumbs span[aria-hidden] {
    color: var(--line-strong);
  }

  .answer-topic-badge {
    display: inline-block;
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--mist);
    color: var(--ocean);
    border: 1px solid transparent;
    border-radius: 100px;
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    margin-bottom: var(--space-4);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .answer-topic-badge:hover {
    background: var(--white);
    border-color: var(--ocean);
  }

  .answer-main h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--navy);
    margin: var(--space-4) 0 var(--space-6);
    max-width: 100%;
  }

  .answer-main .ai-answer-summary {
    border: none !important;
    background: none !important;
    padding: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
    margin: 0 0 var(--space-6);
  }

  .answer-main .ai-answer-summary .summary,
  .answer-main .summary {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-md);
    line-height: var(--leading-loose);
    color: var(--ink);
    font-style: normal !important;
    font-weight: 400;
    max-width: 36rem;
    margin: 0 0 var(--space-8);
    border: none !important;
    background: none !important;
    padding: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  .key-takeaways {
    background: var(--paper-deep);
    border: none;
    border-left: 3px solid var(--brass);
    border-radius: 6px;
    padding: var(--space-6) var(--space-8);
    margin: var(--space-8) 0;
  }

  .key-takeaways h2,
  #key-takeaways-title {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stone);
    margin: 0 0 var(--space-4);
    border: none;
    padding: 0;
  }

  .answer-main .key-takeaways ul {
    list-style: none !important;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .answer-main .key-takeaways ul li {
    list-style: none !important;
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: 1rem;
    line-height: var(--leading-relaxed);
    color: var(--ink);
    padding-left: 0;
  }

  @media (max-width: 640px) {
    .key-takeaways {
      padding: var(--space-5) var(--space-4);
    }
  }

  .answer-main .key-takeaways .takeaway-mark {
    color: var(--brass);
    margin-right: var(--space-3);
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 600;
  }

  .answer-main .key-takeaways ul li::before,
  .answer-main .key-takeaways ul li::marker {
    content: none;
  }

  .accepted-answer h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--navy);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .accepted-answer p {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-base);
    line-height: var(--leading-loose);
    color: var(--ink);
    max-width: 38rem;
    margin-bottom: var(--space-5);
  }

  .sidebar-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-card:has(.sidebar-entity) {
    background: var(--mist);
    border: none;
  }

  .care-card {
    background: var(--clay-soft);
    border: none;
    border-left: 3px solid var(--clay);
    border-radius: 6px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .care-card .sidebar-label {
    color: var(--clay);
  }

  .care-card p {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--ink);
    margin: 0;
  }

  .citation-panel {
    background: transparent;
    border: none;
    border-top: 1px solid var(--line);
    padding-top: var(--space-6);
  }

  .citation-panel h2 {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stone);
    margin: 0 0 var(--space-4);
    border: none;
    padding: 0;
  }

  .citation-panel dl {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .citation-panel dt {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--stone);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .citation-panel dd {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-sm);
    color: var(--stone);
    margin: 0;
    word-break: break-word;
  }

  .citation-panel a {
    color: var(--ocean);
    text-decoration: none;
    font-size: var(--text-xs);
  }

  .citation-panel a:hover {
    text-decoration: underline;
  }

  .sidebar-label {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stone);
    margin: 0;
  }

  .rabbit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  @media (min-width: 640px) {
    .rabbit-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .rabbit-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 3px solid var(--ocean);
    border-radius: 6px;
    padding: var(--space-6) var(--space-8);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: box-shadow 0.2s ease, border-left-color 0.2s ease;
  }

  .rabbit-card:hover {
    box-shadow: var(--shadow);
    border-left-color: var(--brass);
  }

  .rabbit-card span {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    background: var(--mist);
    color: var(--ocean);
    border-radius: 100px;
    padding: var(--space-2) var(--space-3);
    display: inline-block;
    width: fit-content;
  }

  .rabbit-card strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--navy);
    line-height: var(--leading-snug);
  }

  .related-section {
    background: var(--paper-deep);
    padding: var(--space-16) 0;
  }

  .related-section .eyebrow {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--stone);
    margin: 0 0 var(--space-3);
  }

  .related-section h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--navy);
    margin: 0 0 var(--space-8);
    border: none;
    padding: 0;
  }
</style>
