---
import AnswerTrustPanel from '@/components/AnswerTrustPanel.astro';
import CrisisBanner from '@/components/CrisisBanner.astro';
import PractitionerCallout from '@/components/PractitionerCallout.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  answerPath,
  categoryPath,
  displayCategory,
  formatAnswerHtml,
  formatDate,
  getAnswerMetaDescription,
  getAnswerPlainText,
  getAnswerDisplayTitle,
  getAnswerSchemaAnswer,
  getAnswerSchemaQuestion,
  getAnswerSummary,
  getCareNote,
  getFollowUpQuestions,
  getKeyTakeaways,
  getPrimaryTheme,
  getQuestionCitation,
  getRelatedQuestions,
  isCrisisSensitive,
  shouldIndexQuestion,
  slugify,
  truncate,
} from '@/lib/content';
import { getAnswerPractitionerLink } from '@/lib/practitioner-links';
import { organizationId, siteUrl, websiteId } from '@/lib/site';
import { getReviewedByLabel, getReviewerDisplayLabel, getSourceRefs, isInternalReviewerLabel } from '@/lib/trust';
import { getQuestionBySlug, getQuestions, type Question } from '@/lib/supabase';

export async function getStaticPaths() {
  const questions = await getQuestions();
  return questions.map((question) => ({
    params: { slug: question.slug },
    props: { question },
  }));
}

const suppliedQuestion = Astro.props.question as Question | undefined;
const question = suppliedQuestion ?? (await getQuestionBySlug(Astro.params.slug ?? ''));

if (!question) {
  return Astro.redirect('/answers');
}

const allQuestions = await getQuestions();
const relatedQuestions = getRelatedQuestions(question, allQuestions);
const category = displayCategory(question);
const displayTitle = getAnswerDisplayTitle(question);
const summary = getAnswerSummary(question);
const schemaQuestion = getAnswerSchemaQuestion(question);
const schemaAnswerText = getAnswerSchemaAnswer(question);
const keyTakeaways = getKeyTakeaways(question);
const followUpQuestions = getFollowUpQuestions(question);
const primaryTheme = getPrimaryTheme(question);
const updatedAt = question.updated_at || question.created_at;
const crisisSensitive = isCrisisSensitive(question);
const careNote = getCareNote(question, crisisSensitive);
const title = `${displayTitle} | Deeper Global`;
const description = getAnswerMetaDescription(question);
const citation = getQuestionCitation(question);
const answerHtml = formatAnswerHtml(question);
const answerText = getAnswerPlainText(question);
const extractableAnswer = truncate(schemaAnswerText || answerText, 700);
const answerUrl = siteUrl(`/answers/${question.slug}`);
const categoryUrl = siteUrl(categoryPath(category));
const entityUrl = siteUrl(`/entities/${slugify(category)}`);
const questionId = `${answerUrl}#question`;
const answerId = `${answerUrl}#accepted-answer`;
const articleId = `${answerUrl}#article`;
const pageId = `${answerUrl}#webpage`;
const shouldIndex = shouldIndexQuestion(question);
const practitionerLink = getAnswerPractitionerLink(question.slug);
const reviewedBy = getReviewedByLabel(question);
const reviewerDisplayLabel = getReviewerDisplayLabel(question);
const sourceRefs = getSourceRefs(question);
const sourceCitationUrls = sourceRefs.map((source) => source.url).filter(Boolean);
const reviewedBySchema = reviewedBy
  ? {
      reviewedBy: {
        '@type': isInternalReviewerLabel(reviewedBy) ? 'Organization' : 'Person',
        name: reviewerDisplayLabel,
      },
    }
  : {};
const sourceCitationSchema =
  sourceCitationUrls.length > 0
    ? {
        citation: sourceCitationUrls,
      }
    : {};
const jsonLd = {
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': pageId,
      url: answerUrl,
      name: displayTitle,
      description,
      datePublished: question.created_at,
      dateModified: updatedAt,
      isPartOf: {
        '@id': websiteId(),
      },
      publisher: {
        '@id': organizationId(),
      },
      about: {
        '@id': `${entityUrl}#entity`,
      },
      mainEntity: {
        '@id': articleId,
      },
      ...reviewedBySchema,
      ...sourceCitationSchema,
    },
    {
      '@type': 'Article',
      '@id': articleId,
      headline: displayTitle,
      description,
      articleBody: answerText,
      datePublished: question.created_at,
      dateModified: updatedAt,
      author: {
        '@id': organizationId(),
      },
      publisher: {
        '@id': organizationId(),
      },
      mainEntityOfPage: {
        '@id': pageId,
      },
      about: {
        '@id': `${entityUrl}#entity`,
      },
      ...reviewedBySchema,
      ...sourceCitationSchema,
    },
    {
      '@type': 'Question',
      '@id': questionId,
      name: schemaQuestion,
      text: schemaQuestion,
      dateCreated: question.created_at,
      about: {
        '@id': `${entityUrl}#entity`,
        name: primaryTheme,
      },
      author: {
        '@id': organizationId(),
      },
      acceptedAnswer: {
        '@id': answerId,
      },
    },
    {
      '@type': 'Answer',
      '@id': answerId,
      url: `${answerUrl}#accepted-answer`,
      text: schemaAnswerText,
      dateCreated: question.created_at,
      dateModified: updatedAt,
      citation: citation.url,
      author: {
        '@id': organizationId(),
      },
    },
    {
      '@type': 'DefinedTerm',
      '@id': `${entityUrl}#entity`,
      name: primaryTheme,
      inDefinedTermSet: 'Deeper Global Mental Health Topic Map',
      url: entityUrl,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${answerUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Deeper Global',
          item: siteUrl(),
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category,
          item: categoryUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: displayTitle,
          item: answerUrl,
        },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} canonicalPath={`/answers/${question.slug}`} ogType="article" jsonLd={jsonLd} noindex={!shouldIndex}>
  {crisisSensitive && <CrisisBanner />}
  <main>
    <nav class="answer-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Deeper Global</a>
      <span aria-hidden="true">/</span>
      <a href={categoryPath(category)}>{category}</a>
      <span aria-hidden="true">/</span>
      <span>{truncate(displayTitle, 54)}</span>
    </nav>

    <article
      class="answer-layout"
      data-ai-content-type="mental-health-answer"
      data-ai-citable="true"
      data-question-id={question.id}
      data-question-slug={question.slug}
      data-primary-entity={primaryTheme}
      data-risk-class={crisisSensitive ? 'crisis-sensitive' : 'standard'}
      itemscope
      itemtype="https://schema.org/Article"
    >
      <meta itemprop="datePublished" content={question.created_at} />
      <meta itemprop="dateModified" content={updatedAt} />
      <meta itemprop="author" content="Deeper Global" />
      <div class="answer-main">
        <a class="answer-topic-badge" href={categoryPath(category)}>{category}</a>
        <h1 itemprop="headline">{displayTitle}</h1>
        <section
          class="ai-answer-summary"
          id="answer-summary"
          aria-label="Structured answer summary"
          data-ai-section="answer-summary"
        >
          <p class="summary">{summary}</p>
        </section>
        {
          keyTakeaways.length > 0 && (
            <section class="key-takeaways" aria-labelledby="key-takeaways-title" data-ai-section="key-takeaways">
              <h2 id="key-takeaways-title">Key takeaways</h2>
              <ul>
                {keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}
              </ul>
            </section>
          )
        }
        <section
          id="accepted-answer"
          class="accepted-answer"
          aria-label="Accepted answer"
          data-ai-section="accepted-answer"
          data-ai-extract={extractableAnswer}
          itemprop="articleBody"
        >
          <div set:html={answerHtml} />
        </section>
      </div>

      <aside class="answer-sidebar" aria-label="Answer context">
        <AnswerTrustPanel question={question} updatedAt={updatedAt} />

        <section class="sidebar-card">
          <p class="sidebar-label">Related theme</p>
          <a class="sidebar-entity" href={categoryPath(category)}>{category}</a>
          <p>Browse the topic hub for more {category.toLowerCase()} answers.</p>
          <a class="text-link" href={categoryPath(category)}>Open topic hub</a>
        </section>

        {
          practitionerLink && (
            <PractitionerCallout
              title={practitionerLink.title}
              body={practitionerLink.body}
              href={practitionerLink.href}
              label={practitionerLink.label}
            />
          )
        }

        {
          followUpQuestions.length > 0 && (
            <section class="sidebar-card follow-up-card" data-ai-section="related-questions">
              <p class="sidebar-label">Questions people ask next</p>
              <ul>
                {followUpQuestions.map((relatedQuestion) => <li>{relatedQuestion}</li>)}
              </ul>
            </section>
          )
        }

        <section class="citation-panel" id="citation" aria-label="Citation metadata" data-ai-section="citation">
          <h2>How to cite this answer</h2>
          <dl>
            <div>
              <dt>Title</dt>
              <dd>{citation.title}</dd>
            </div>
            <div>
              <dt>Publisher</dt>
              <dd>{citation.publisher}</dd>
            </div>
            <div>
              <dt>Canonical URL</dt>
              <dd><a href={citation.url}>{citation.url}</a></dd>
            </div>
            <div>
              <dt>Updated</dt>
              <dd>{formatDate(citation.dateModified)}</dd>
            </div>
          </dl>
        </section>

        <section class="care-card">
          <p class="sidebar-label">Not a substitute for care</p>
          <p>{careNote}</p>
        </section>
      </aside>
    </article>

    {
      relatedQuestions.length > 0 && (
        <section class="section related-section">
          <div class="container">
            <p class="eyebrow">Related questions</p>
            <h2>More answers in {category}</h2>
            <div class="rabbit-grid">
              {relatedQuestions.map((related) => (
                <a class="rabbit-card" href={answerPath(related.slug)}>
                  <span>{displayCategory(related)}</span>
                  <strong>{related.question}</strong>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
