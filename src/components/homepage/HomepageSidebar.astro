---
import type { HomepageSidebarData } from '@/lib/homepage-sidebar';

type Props = {
  sidebar: HomepageSidebarData;
};

const { sidebar } = Astro.props;
---

<aside class="homepage-sidebar-wrap" aria-label="Explore Deeper Global">
  <div class="homepage-sidebar">
    {
      sidebar.askingNow.length > 0 && (
        <section class="homepage-sidebar-block" aria-labelledby="homepage-sidebar-asking">
          <p class="homepage-sidebar-label" id="homepage-sidebar-asking">Right now, people are asking</p>
          <ul class="homepage-sidebar-featured-list">
            {
              sidebar.askingNow.map((link) => (
                <li>
                  <a href={link.href}>{link.title}</a>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    {
      sidebar.startingPoints.length > 0 && (
        <nav class="homepage-sidebar-block" aria-labelledby="homepage-sidebar-start">
          <p class="homepage-sidebar-label" id="homepage-sidebar-start">Start where you are</p>
          <ul class="homepage-sidebar-start-list">
            {
              sidebar.startingPoints.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      )
    }

    {
      sidebar.newThisWeek.length > 0 && (
        <section class="homepage-sidebar-block" aria-labelledby="homepage-sidebar-new">
          <p class="homepage-sidebar-label" id="homepage-sidebar-new">New this week</p>
          <ul class="homepage-sidebar-recent-list">
            {
              sidebar.newThisWeek.map((link) => (
                <li>
                  <span class="sidebar-new-tag" aria-hidden="true">New</span>
                  <a href={link.href}>{link.title}</a>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    <section class="homepage-sidebar-block">
      <a class="homepage-sidebar-random-link" href={sidebar.randomAnswerHref}>
        Read a random answer<span class="cta-arrow" aria-hidden="true"> →</span>
      </a>
    </section>
  </div>
</aside>
