---
export type HeroPopularLink = {
  href: string;
  label: string;
};

type AsideVariant = 'a' | 'b' | 'c';

type Props = {
  links: HeroPopularLink[];
  variant?: 'before' | 'a' | 'b' | 'c';
};

const { links, variant = 'c' } = Astro.props;
const fallbackLinks: HeroPopularLink[] = [
  { href: '/answers/', label: 'Anxiety at work' },
  { href: '/answers/', label: 'Panic attacks' },
  { href: '/answers/', label: 'Do I need therapy?' },
  { href: '/answers/', label: 'Relationship anxiety' },
];
const items = links.length ? links : fallbackLinks;

const asideVariants: Record<AsideVariant, { ariaLabel: string; label: string; labelClass: string; listClass: string }> = {
  a: { ariaLabel: "Editor's reading recommendations", label: "Editor's picks", labelClass: 'hero-popular-eyebrow', listClass: 'hero-popular-list' },
  b: { ariaLabel: 'Common starting points', label: 'People often start with', labelClass: 'hero-popular-eyebrow', listClass: 'hero-popular-grid' },
  c: { ariaLabel: 'Start here recommendations', label: 'Start here', labelClass: 'hero-popular-heading', listClass: 'hero-popular-start-list' },
};

const asideConfig = variant === 'before' ? null : asideVariants[variant];
---

{
  variant === 'before' ? (
    <div class="discovery-links" aria-label="Popular answers">
      <span class="discovery-links-label">Popular</span>
      {items.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </div>
  ) : asideConfig && (
    <aside class={`hero-popular hero-popular--${variant}`} aria-label={asideConfig.ariaLabel}>
      <p class={asideConfig.labelClass}>{asideConfig.label}</p>
      <ul class={asideConfig.listClass}>
        {items.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
