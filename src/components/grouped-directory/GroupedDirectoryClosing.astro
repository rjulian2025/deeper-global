---
export type GroupedDirectoryClosingLink = {
  label: string;
  href: string;
};

type Props = {
  prompt: string;
  links: GroupedDirectoryClosingLink[];
};

const { prompt, links } = Astro.props;
---

<section class="grouped-directory-closing" aria-labelledby="grouped-directory-closing-title">
  <p class="grouped-directory-closing-prompt" id="grouped-directory-closing-title">{prompt}</p>
  {
    links.length > 0 && (
      <ul class="grouped-directory-closing-links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    )
  }
</section>
