---
import type { UnexpectedOverlapLink } from '@/lib/unexpected-overlaps';
import type { GroupedThemeCluster, ThemeDirectoryEntry } from '@/lib/theme-directory';
import { themeClusterJumpHref } from '@/lib/theme-directory';

type Props = {
  clusters: GroupedThemeCluster[];
  trendingThemes: ThemeDirectoryEntry[];
  searchInputId?: string;
  searchPlaceholder?: string;
  searchLabel?: string;
  unexpectedOverlaps?: UnexpectedOverlapLink[];
  askAnything?: {
    lead: string;
    href: string;
    label: string;
  };
};

const {
  clusters,
  trendingThemes,
  searchInputId = 'grouped-directory-search',
  searchPlaceholder = 'Search themes',
  searchLabel = 'Search themes',
  unexpectedOverlaps = [],
  askAnything,
} = Astro.props;
---

<aside class="grouped-directory-sidebar-wrap" aria-label="Directory navigation">
  <div class="grouped-directory-sidebar">
    <div class="grouped-directory-sidebar-block grouped-directory-search">
      <label class="visually-hidden" for={searchInputId}>{searchLabel}</label>
      <input
        id={searchInputId}
        type="search"
        placeholder={searchPlaceholder}
        autocomplete="off"
        data-grouped-directory-search
      />
    </div>

    {
      clusters.length > 0 && (
        <nav class="grouped-directory-sidebar-block" aria-label="Jump to category">
          <p class="grouped-directory-sidebar-label">Jump to category</p>
          <ul class="grouped-directory-jump-list">
            {
              clusters.map((cluster) => (
                <li>
                  <a href={themeClusterJumpHref(cluster.anchorId)} data-cluster-jump>
                    {cluster.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      )
    }

    {
      unexpectedOverlaps.length > 0 && (
        <section class="grouped-directory-sidebar-block" aria-labelledby={`${searchInputId}-overlaps`}>
          <p class="grouped-directory-sidebar-label" id={`${searchInputId}-overlaps`}>Unexpected overlaps</p>
          <ul class="grouped-directory-overlap-list">
            {
              unexpectedOverlaps.map((link) => (
                <li>
                  <a href={link.href}>{link.title}</a>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    {
      trendingThemes.length > 0 && (
        <div class="grouped-directory-sidebar-block">
          <p class="grouped-directory-sidebar-label">Trending this week</p>
          <ul class="grouped-directory-trending-list">
            {
              trendingThemes.map((theme) => (
                <li>
                  <a href={theme.href} data-ai-entity={theme.name}>{theme.name}</a>
                </li>
              ))
            }
          </ul>
        </div>
      )
    }

    {
      askAnything && (
        <section class="grouped-directory-sidebar-block" aria-labelledby={`${searchInputId}-ask`}>
          <p class="grouped-directory-ask-lead" id={`${searchInputId}-ask`}>{askAnything.lead}</p>
          <a class="grouped-directory-ask-link" href={askAnything.href}>{askAnything.label}</a>
        </section>
      )
    }
  </div>
</aside>
