---
import {
  formatModalityHubRecentMeta,
  getModalityHubRecentHref,
  type ModalityHubPageData,
} from '@/lib/modality-hub-page';

type Props = {
  hub: ModalityHubPageData;
};

const { hub } = Astro.props;
const { config, recentModalities } = hub;
---

<aside class="topic-hub-sidebar-wrap" aria-label="Modality hub navigation">
  <div class="topic-hub-sidebar">
    <div class="topic-hub-sidebar-block topic-hub-sidebar-search">
      <form class="topic-hub-search" action="/answers/" method="get" role="search" aria-label={config.searchPlaceholder}>
        <label class="visually-hidden" for={`modality-hub-search-${config.id}`}>{config.searchPlaceholder}</label>
        <input
          id={`modality-hub-search-${config.id}`}
          type="search"
          name="q"
          placeholder={config.searchPlaceholder}
        />
      </form>
    </div>

    {
      config.relatedHubs.length > 0 && (
        <nav class="topic-hub-sidebar-block" aria-label="Related hubs">
          <p class="topic-hub-sidebar-label">Related hubs</p>
          <ul class="topic-hub-related-list">
            {config.relatedHubs.map((hubLink) => (
              <li>
                <a class="tier-link" href={hubLink.href}>{hubLink.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      recentModalities.length > 0 && (
        <div class="topic-hub-sidebar-block">
          <p class="topic-hub-sidebar-label">Recently updated</p>
          <ul class="topic-hub-recent-list">
            {
              recentModalities.map((modality) => (
                <li>
                  <a class="tier-link" href={getModalityHubRecentHref(modality)} title={modality.name}>
                    {modality.name}
                  </a>
                  <span class="topic-hub-recent-date">{formatModalityHubRecentMeta(modality)}</span>
                </li>
              ))
            }
          </ul>
        </div>
      )
    }
  </div>
</aside>
