---
import type { ReviewerProfile } from '@/data/reviewers';
import { getVideoMetaLabel, isVideoInteractive } from '@/lib/reviewer-video';

type Props = {
  reviewer: ReviewerProfile;
};

const { reviewer } = Astro.props;
const video = reviewer.videoModule;
if (!video) return null;

const poster = video.poster ?? reviewer.image;
const metaLabel = getVideoMetaLabel(video);
const interactive = isVideoInteractive(video);
const playLabel = `${video.title}. ${video.statusLabel ?? 'Not yet available'}.`;

// Live videos: embed only (no custom poster above the player).
// Coming-soon: poster placeholder until an embed URL exists.
if (interactive && !video.embedUrl) return null;
if (!interactive && !poster) return null;
---

<div class="reviewer-video-card" data-video-status={video.status}>
  <div class="reviewer-video-stage-wrap">
    {
      interactive ? (
        <div class="reviewer-video-embed">
          <iframe
            title={video.title}
            src={video.embedUrl}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      ) : (
        <div class="reviewer-video-thumb reviewer-video-thumb--pending" aria-label={playLabel}>
          <img
            src={poster}
            alt=""
            class="reviewer-video-poster"
            width="960"
            height="540"
            loading="lazy"
            aria-hidden="true"
          />
          <div class="reviewer-video-gradient" aria-hidden="true"></div>
          <span class="reviewer-video-play reviewer-video-play--pending" aria-hidden="true">
            <svg class="reviewer-video-play-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <polygon points="9,6 18,12 9,18" fill="rgba(255,255,255,0.88)"></polygon>
            </svg>
          </span>
          <span class="reviewer-video-title">{video.title}</span>
        </div>
      )
    }
  </div>

  <p class="reviewer-video-meta-label">{metaLabel}</p>
  <p class="reviewer-video-caption">{video.caption}</p>
</div>
