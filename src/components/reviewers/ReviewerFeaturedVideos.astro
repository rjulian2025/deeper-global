---
import type { ReviewerProfile } from '@/data/reviewers';

type Props = {
  reviewer: ReviewerProfile;
};

const { reviewer } = Astro.props;
const links = reviewer.featuredVideoLinks ?? [];
if (links.length === 0) return null;
---

<section class="reviewer-featured-videos" aria-labelledby="reviewer-featured-videos-title">
  <p class="profile-main-label">Featured videos</p>
  <h2 id="reviewer-featured-videos-title">Watch on Peachtree Psychology</h2>
  <p class="reviewer-section-intro">
    Short clinician videos with full summaries and transcripts on Peachtree, the canonical home for detailed content and consultation.
  </p>
  <ul class="reviewer-featured-video-list">
    {
      links.map((video) => (
        <li>
          <a class="reviewer-featured-video-card" href={video.href} rel="noopener noreferrer">
            <img
              src={video.thumbnailUrl}
              alt=""
              width="320"
              height="180"
              loading="lazy"
              aria-hidden="true"
            />
            <span class="reviewer-featured-video-copy">
              <span class="reviewer-featured-video-title">{video.title}</span>
              <span class="reviewer-featured-video-caption">{video.caption}</span>
              <span class="reviewer-featured-video-meta">{video.durationLabel} · Peachtree</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
