---
import type { AuthorityProfile } from '@/lib/authorities';

type Props = {
  authority: AuthorityProfile;
};

const { authority } = Astro.props;
const { videoModule } = authority;
---

<section class="section authority-video-section" aria-labelledby="authority-video-title">
  <div class="container">
    <div class="video-feature">
      <button
        type="button"
        class="video-stage"
        data-authority-event="video_placeholder_click"
        data-cta-label={videoModule.statusLabel}
        aria-label={`${videoModule.title}. ${videoModule.statusLabel}`}
      >
        <div class="video-stage-backdrop" aria-hidden="true">
          <img
            src={authority.image}
            alt=""
            class="video-stage-photo"
            width="640"
            height="360"
            loading="lazy"
          />
          <div class="video-stage-overlay"></div>
        </div>
        <span class="video-status">{videoModule.statusLabel}</span>
        <span class="video-play" aria-hidden="true">▶</span>
        <div class="video-stage-copy">
          <h2 id="authority-video-title">{videoModule.title}</h2>
          <p>{videoModule.subtitle}</p>
        </div>
      </button>

      <div class="video-side">
        <p class="video-side-label">Introduction preview</p>
        <ul class="video-preview-list">
          {videoModule.previewBullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <p class="video-side-note">
          A forthcoming clinical introduction — not a recording. No playback yet.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .authority-video-section {
    padding-top: var(--space-8);
    padding-bottom: var(--space-4);
  }

  .video-feature {
    display: grid;
    gap: var(--space-6);
    align-items: stretch;
  }

  @media (min-width: 960px) {
    .video-feature {
      grid-template-columns: minmax(0, 1.45fr) minmax(260px, 0.75fr);
    }
  }

  .video-stage {
    position: relative;
    min-height: 22rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    font: inherit;
    text-align: left;
    background: var(--navy);
    box-shadow: 0 24px 60px rgba(14, 31, 51, 0.18);
  }

  @media (min-width: 768px) {
    .video-stage {
      min-height: 26rem;
    }
  }

  .video-stage:hover {
    box-shadow: 0 28px 70px rgba(14, 31, 51, 0.24);
  }

  .video-stage-backdrop {
    position: absolute;
    inset: 0;
  }

  .video-stage-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    opacity: 0.34;
    filter: grayscale(12%);
  }

  .video-stage-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(14, 31, 51, 0.92) 0%,
      rgba(14, 31, 51, 0.72) 45%,
      rgba(31, 92, 139, 0.55) 100%
    );
  }

  .video-status {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    z-index: 2;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: var(--space-2) var(--space-4);
  }

  .video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.96);
    color: var(--navy);
    font-size: 1.5rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  }

  .video-stage-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: var(--space-8);
    background: linear-gradient(to top, rgba(14, 31, 51, 0.92), rgba(14, 31, 51, 0));
  }

  .video-stage-copy h2 {
    margin: 0 0 var(--space-3);
    color: var(--white);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    max-width: 18ch;
  }

  .video-stage-copy p {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    max-width: 38rem;
  }

  .video-side {
    display: grid;
    gap: var(--space-4);
    align-content: center;
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-left: 4px solid var(--ocean);
    border-radius: 8px;
    background: var(--white);
  }

  .video-side-label {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ocean);
  }

  .video-preview-list {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: var(--space-3);
    color: var(--ink);
    line-height: var(--leading-relaxed);
  }

  .video-side-note {
    margin: 0;
    color: var(--stone);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }
</style>

<script>
  document.querySelectorAll('.video-stage').forEach((button) => {
    button.addEventListener('click', () => {
      window.deeperTrackEvent?.('video_placeholder_click', {
        content_type: 'authority',
        cta_label: button.getAttribute('data-cta-label') ?? 'Video Coming Soon',
      });
    });
  });
</script>
