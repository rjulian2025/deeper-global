---
import type { AuthorityProfile } from '@/lib/authorities';

type Props = {
  authority: AuthorityProfile;
};

const { authority } = Astro.props;
const { videoCarousel } = authority;
---

<section class="section authority-video-section" aria-labelledby="authority-video-title">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="eyebrow">{videoCarousel.eyebrow}</p>
        <h2 id="authority-video-title">{videoCarousel.title}</h2>
      </div>
    </div>
    <p class="video-section-lede">{videoCarousel.description}</p>

    <div class="video-carousel" data-video-carousel>
      <div class="video-carousel-viewport">
        <div class="video-carousel-track" data-carousel-track>
          {
            videoCarousel.slides.map((slide, index) => (
              <article
                class="video-slide"
                data-carousel-slide
                data-slide-index={index}
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <button
                  type="button"
                  class="video-slide-button"
                  data-authority-event="video_placeholder_click"
                  data-cta-label={slide.topic}
                  data-specialty={slide.topic}
                  aria-label={`${slide.headline}. ${slide.statusLabel}`}
                >
                  <div class:list={['video-thumbnail', `video-thumbnail--${slide.thumbnailAccent}`]}>
                    <span class="video-thumbnail-topic">{slide.topic}</span>
                    <span class="video-thumbnail-fpo">FPO thumbnail</span>
                    <span class="video-play" aria-hidden="true">▶</span>
                  </div>
                  <div class="video-slide-copy">
                    <strong>{slide.headline}</strong>
                    <span>{slide.subtitle}</span>
                    <em>{slide.statusLabel}</em>
                  </div>
                </button>
              </article>
            ))
          }
        </div>
      </div>

      <div class="video-carousel-controls">
        <button type="button" class="carousel-nav" data-carousel-prev aria-label="Previous video topic">
          ←
        </button>
        <div class="carousel-dots" role="tablist" aria-label="Video topic slides">
          {
            videoCarousel.slides.map((slide, index) => (
              <button
                type="button"
                class:list={['carousel-dot', index === 0 && 'is-active']}
                data-carousel-dot={index}
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-label={slide.topic}
              />
            ))
          }
        </div>
        <button type="button" class="carousel-nav" data-carousel-next aria-label="Next video topic">
          →
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .authority-video-section {
    padding-top: var(--space-10);
  }

  .video-section-lede {
    margin: 0 0 var(--space-6);
    color: var(--stone);
    font-size: var(--text-sm);
    max-width: 42rem;
    line-height: var(--leading-relaxed);
  }

  .video-carousel {
    display: grid;
    gap: var(--space-5);
  }

  .video-carousel-viewport {
    overflow: hidden;
    border-radius: 8px;
  }

  .video-carousel-track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }

  .video-slide {
    flex: 0 0 100%;
    min-width: 100%;
  }

  .video-slide-button {
    width: 100%;
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-left: 4px solid var(--ocean);
    border-radius: 8px;
    background: linear-gradient(135deg, var(--white), var(--mist));
    cursor: pointer;
    text-align: left;
    font: inherit;
  }

  .video-slide-button:hover {
    border-left-color: var(--brass);
    box-shadow: var(--shadow);
  }

  @media (min-width: 768px) {
    .video-slide-button {
      grid-template-columns: minmax(220px, 0.95fr) 1fr;
      align-items: center;
      padding: var(--space-8);
    }
  }

  .video-thumbnail {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: var(--space-5);
  }

  .video-thumbnail--navy {
    background: linear-gradient(145deg, var(--navy) 0%, #16324a 55%, var(--ocean) 100%);
  }

  .video-thumbnail--ocean {
    background: linear-gradient(145deg, var(--ocean) 0%, var(--ocean-bright) 60%, var(--mist) 100%);
  }

  .video-thumbnail--clay {
    background: linear-gradient(145deg, #8f4f3d 0%, var(--clay) 50%, var(--clay-soft) 100%);
  }

  .video-thumbnail-topic {
    position: absolute;
    top: var(--space-4);
    left: var(--space-4);
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  .video-thumbnail-fpo {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .video-play {
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.94);
    color: var(--navy);
    font-size: 1.25rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }

  .video-slide-copy {
    display: grid;
    gap: var(--space-2);
  }

  .video-slide-copy strong {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-xl);
    color: var(--navy);
  }

  .video-slide-copy span {
    color: var(--stone);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .video-slide-copy em {
    color: var(--ocean);
    font-style: normal;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .video-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .carousel-nav {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    font: inherit;
    line-height: 1;
  }

  .carousel-nav:hover {
    border-color: var(--ocean);
    color: var(--ocean);
  }

  .carousel-dots {
    display: flex;
    gap: var(--space-2);
  }

  .carousel-dot {
    width: 0.65rem;
    height: 0.65rem;
    border: 0;
    border-radius: 999px;
    background: var(--line);
    cursor: pointer;
    padding: 0;
  }

  .carousel-dot.is-active {
    background: var(--ocean);
    transform: scale(1.15);
  }
</style>

<script>
  document.querySelectorAll('[data-video-carousel]').forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    const slides = Array.from(carousel.querySelectorAll('[data-carousel-slide]'));
    const dots = Array.from(carousel.querySelectorAll('[data-carousel-dot]'));
    const prev = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    if (!track || slides.length === 0) return;

    let index = 0;

    const goTo = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((slide, i) => {
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
      });
    };

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = Number(dot.getAttribute('data-carousel-dot'));
        if (!Number.isNaN(target)) goTo(target);
      });
    });

    carousel.querySelectorAll('.video-slide-button').forEach((button) => {
      button.addEventListener('click', () => {
        window.deeperTrackEvent?.('video_placeholder_click', {
          content_type: 'authority',
          cta_label: button.getAttribute('data-cta-label') ?? 'Video Coming Soon',
          specialty: button.getAttribute('data-specialty') ?? undefined,
        });
      });
    });
  });
</script>
