---
import type { AuthorityProfile } from '@/lib/authorities';

type Props = {
  authority: AuthorityProfile;
};

const { authority } = Astro.props;
const { whyDrCrenshaw } = authority;
---

<section class="section why-section" aria-labelledby="why-dr-crenshaw-title">
  <div class="container">
    <div class="why-header">
      <p class="eyebrow">Clinical credibility</p>
      <h2 id="why-dr-crenshaw-title">{whyDrCrenshaw.title}</h2>
      <p class="why-lede">{whyDrCrenshaw.lede}</p>
    </div>
    <div class="why-cards">
      {
        whyDrCrenshaw.cards.map((card) => (
          <article class="why-card card">
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why-section {
    background: var(--paper);
  }

  .why-header {
    max-width: 40rem;
    margin-bottom: var(--space-8);
  }

  .why-lede {
    margin: var(--space-4) 0 0;
    color: var(--stone);
    line-height: var(--leading-relaxed);
  }

  .why-cards {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .why-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .why-card {
    padding: var(--space-6) var(--space-6) var(--space-6) var(--accent-inset);
    border-left: var(--accent-bar-width) solid var(--brass);
    display: grid;
    gap: var(--space-3);
  }

  .why-card h3 {
    margin: 0;
    font-size: var(--text-lg);
    color: var(--navy);
  }

  .why-card p {
    margin: 0;
    color: var(--stone);
    line-height: var(--leading-relaxed);
    font-size: 0.9375rem;
  }

  @media (max-width: 640px) {
    .why-card {
      padding-left: calc(var(--space-5) + var(--accent-bar-gap));
    }
  }
</style>
