---
import AccentCallout from '@/components/authority/AccentCallout.astro';

type Props = {
  text: string;
};

const { text } = Astro.props;
---

<aside class="clinical-perspective" aria-label="Clinical perspective">
  <div class="container">
    <AccentCallout tone="brass" padded tinted class="clinical-perspective-callout">
      <p class="clinical-perspective-label">Clinical perspective</p>
      <p class="clinical-perspective-text">{text}</p>
    </AccentCallout>
  </div>
</aside>

<style>
  .clinical-perspective {
    padding: var(--space-6) 0;
  }

  .clinical-perspective-callout {
    max-width: 46rem;
  }

  .clinical-perspective-label {
    margin: 0 0 var(--space-4);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ocean);
  }

  .clinical-perspective-text {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    line-height: var(--leading-relaxed);
    color: var(--navy);
  }
</style>
