---
type Props = {
  text: string;
};

const { text } = Astro.props;
---

<aside class="clinical-perspective" aria-label="Clinical perspective">
  <div class="container">
    <div class="clinical-perspective-inner">
      <p class="clinical-perspective-label">Clinical perspective</p>
      <p class="clinical-perspective-text">{text}</p>
    </div>
  </div>
</aside>

<style>
  .clinical-perspective {
    padding: var(--space-6) 0;
  }

  .clinical-perspective-inner {
    max-width: 46rem;
    padding: var(--space-6) var(--space-7);
    border-left: 4px solid var(--brass);
    background: linear-gradient(90deg, rgba(169, 130, 59, 0.08), rgba(255, 255, 255, 0));
    border-radius: 0 8px 8px 0;
  }

  .clinical-perspective-label {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ocean);
  }

  .clinical-perspective-text {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.25rem, 2.2vw, 1.55rem);
    line-height: var(--leading-relaxed);
    color: var(--navy);
  }
</style>
