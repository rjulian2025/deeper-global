---
import type { AuthorityProfile } from '@/lib/authorities';

type Props = {
  authority: AuthorityProfile;
};

const { authority } = Astro.props;
---

<section class="authority-hero">
  <div class="container authority-hero-grid">
    <div class="authority-hero-copy">
      <p class="eyebrow">Clinical Authority</p>
      <h1>{authority.displayName}</h1>
      <p class="authority-designation">{authority.designation}</p>
      <div class="authority-credentials">
        <p class="authority-meta">
          {authority.role} · {authority.practiceName} · {authority.location.city}, {authority.location.state}
        </p>
        <p class="authority-meta subtle">{authority.academicAffiliation}</p>
      </div>
      <div class="authority-hero-actions">
        <a
          class="button"
          href={authority.referralPrimaryCta.href}
          data-authority-event="clinical_authority_cta_click"
          data-cta-label={authority.referralPrimaryCta.label}
          data-destination={authority.referralPrimaryCta.href}
          rel="noopener noreferrer"
          target="_blank"
        >
          {authority.referralPrimaryCta.label}
        </a>
        <a
          class="button secondary"
          href="#reviewed-knowledge"
          data-authority-event="clinical_authority_cta_click"
          data-cta-label="View Reviewed ADHD Answers"
          data-destination="#reviewed-knowledge"
        >
          View Reviewed ADHD Answers
        </a>
        <a
          class="button secondary"
          href={authority.phoneTel}
          data-authority-event="phone_click"
          data-cta-label="Call Peachtree Psychology"
          data-destination={authority.phoneTel}
        >
          Call Peachtree Psychology
        </a>
      </div>
    </div>
    <figure class="authority-hero-photo">
      <img src={authority.image} alt={authority.imageAlt} width="480" height="600" loading="eager" />
    </figure>
  </div>
</section>

<style>
  .authority-hero {
    background: var(--navy);
    padding: var(--space-20) var(--space-6) var(--space-16);
  }

  .authority-hero-grid {
    display: grid;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 900px) {
    .authority-hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-12);
    }
  }

  .authority-hero .eyebrow {
    color: var(--ocean-bright);
    margin-bottom: var(--space-4);
  }

  .authority-hero h1 {
    color: var(--white);
    margin: 0 0 var(--space-5);
    font-size: clamp(2.25rem, 4.5vw, var(--text-4xl));
    line-height: var(--leading-tight);
  }

  .authority-designation {
    color: rgba(255, 255, 255, 0.94);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-6);
    max-width: 36rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
  }

  .authority-credentials {
    margin-bottom: var(--space-10);
  }

  .authority-meta {
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .authority-meta.subtle {
    color: rgba(255, 255, 255, 0.58);
    margin-bottom: 0;
  }

  .authority-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .authority-hero-photo {
    margin: 0;
    justify-self: center;
    max-width: 22rem;
  }

  .authority-hero-photo img {
    width: 100%;
    border-radius: 8px;
    box-shadow: var(--shadow);
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 640px) {
    .authority-hero {
      padding-top: var(--space-16);
      padding-bottom: var(--space-12);
    }

    .authority-credentials {
      margin-bottom: var(--space-8);
    }
  }
</style>
