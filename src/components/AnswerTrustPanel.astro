---
import { formatDate } from '@/lib/content';
import {
  getReviewedAt,
  getReviewedByLabel,
  getReviewerProfile,
  getReviewerDisplayLabel,
  getReviewStatusLabel,
  getSourceRefs,
} from '@/lib/trust';

type Props = {
  question: import('@/lib/supabase').Question;
  updatedAt: string;
};

const { question, updatedAt } = Astro.props;
const reviewedBy = getReviewedByLabel(question);
const reviewedAt = getReviewedAt(question);
const reviewerProfile = getReviewerProfile(question);
const reviewerDisplayLabel = getReviewerDisplayLabel(question);
const reviewStatus = getReviewStatusLabel(question);
const reviewStatusDisplay = reviewStatus
  ? reviewStatus.replace(/[-_]+/g, ' ').replace(/\b\w/g, (letter) => letter.toUpperCase())
  : '';
const sourceRefs = getSourceRefs(question);
const showReviewerName = reviewerDisplayLabel === reviewedBy;
const hasMeaningfulTrustContent = Boolean(reviewedBy || reviewedAt || reviewStatusDisplay || sourceRefs.length > 0);
---

{
  hasMeaningfulTrustContent ? (
    <section class="sidebar-card answer-trust-panel" aria-label="Editorial review information" data-ai-section="editorial-trust">
      <p class="sidebar-label">How this answer was reviewed</p>

      {reviewerProfile ? (
        <div class="trust-reviewer">
          <p class="trust-reviewed-by">
            Clinically reviewed by <a href={reviewerProfile.url}><strong>{reviewerProfile.name}</strong></a>
          </p>
          <p class="trust-credentials">{reviewerProfile.credentialLine}</p>
        </div>
      ) : reviewerDisplayLabel ? (
        <p class="trust-reviewed-by">
          {showReviewerName ? 'Reviewed by ' : ''}
          <strong>{reviewerDisplayLabel}</strong>
        </p>
      ) : null}

      <ul class="trust-meta">
        {reviewStatusDisplay ? <li>Review status: {reviewStatusDisplay}</li> : null}
        {reviewedAt ? <li>Last reviewed: {formatDate(reviewedAt)}</li> : null}
        <li>Updated {formatDate(updatedAt)}</li>
      </ul>

      <p class="trust-links">
        <a href="/editorial-policy/">Editorial policy</a>
        <span aria-hidden="true"> · </span>
        <a href="/protocol/">Trust protocol</a>
      </p>

      {sourceRefs.length > 0 ? (
        <div class="trust-sources">
          <p class="sidebar-label">Sources</p>
          <ul>
            {sourceRefs.map((source) => (
              <li>
                {source.url ? (
                  <a href={source.url} rel="noopener noreferrer">
                    {source.title}
                  </a>
                ) : (
                  <span>{source.title}</span>
                )}
                {source.publisher ? <span class="trust-source-publisher"> — {source.publisher}</span> : null}
              </li>
            ))}
          </ul>
        </div>
      ) : null}
    </section>
  ) : null
}

<style>
  .answer-trust-panel {
    margin: 0;
  }

  .answer-trust-panel .trust-reviewed-by,
  .answer-trust-panel .trust-credentials {
    margin: 0 0 10px;
    color: var(--ink);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .answer-trust-panel .trust-reviewed-by a {
    color: var(--ocean);
    text-decoration: none;
  }

  .answer-trust-panel .trust-reviewed-by a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .answer-trust-panel .trust-credentials {
    margin-top: -4px;
    color: var(--stone);
    font-size: 0.82rem;
  }

  .trust-meta {
    display: grid;
    gap: 6px;
    padding: 0;
    margin: 0 0 12px;
    list-style: none;
  }

  .trust-meta li {
    color: var(--stone);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .trust-links {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .trust-links a {
    color: var(--ocean);
    text-decoration: none;
  }

  .trust-links a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trust-sources {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .trust-sources ul {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .trust-sources li {
    color: var(--ink);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .trust-sources a {
    color: var(--ocean);
    text-decoration: none;
  }

  .trust-sources a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trust-source-publisher {
    color: var(--stone);
  }
</style>
