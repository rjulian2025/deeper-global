---
import { answerPath, categoryPath, displayCategory, formatDate, getAnswerDisplayTitle, getAnswerSummary } from '@/lib/content';
import type { Question } from '@/lib/supabase';

type Props = {
  question: Question;
  headingLevel?: 2 | 3;
};

const { question, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const category = displayCategory(question);
const title = getAnswerDisplayTitle(question);
const summary = getAnswerSummary(question);
---

<article class="answer-card">
  <a class="answer-card-link" href={answerPath(question.slug)}>
    <Heading class="answer-card-title">{title}</Heading>
  </a>
  <p class="answer-card-summary">{summary}</p>
  <div class="meta-row">
    <a class="pill pill--category" href={categoryPath(category)}>
      {category}
    </a>
    <span class="pill pill--date">
      Updated {formatDate(question.updated_at || question.created_at)}
    </span>
  </div>
</article>

<style>
  .answer-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 3px solid var(--ocean);
    border-radius: 6px;
    padding: var(--space-6) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    transition: box-shadow 0.2s ease, border-left-color 0.2s ease;
  }

  .answer-card:hover {
    box-shadow: var(--shadow);
    border-left-color: var(--brass);
  }

  .answer-card-link {
    text-decoration: none;
    color: inherit;
  }

  .answer-card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
    color: var(--navy);
    margin: 0;
    transition: color 0.15s ease;
  }

  .answer-card-link:hover .answer-card-title {
    color: var(--ocean);
  }

  .answer-card-summary {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.9375rem;
    line-height: var(--leading-relaxed);
    color: var(--stone);
    margin: 0;
    max-width: 34rem;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .pill {
    font-family: 'Jost', ui-sans-serif, system-ui, sans-serif;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: var(--space-2) var(--space-3);
    border-radius: 100px;
    text-decoration: none;
    line-height: var(--leading-normal);
    display: inline-block;
  }

  .pill--category {
    background: var(--mist);
    color: var(--ocean);
    border: 1px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .pill--category:hover {
    background: var(--white);
    border-color: var(--ocean);
  }

  .pill--date {
    color: var(--stone);
    background: transparent;
    font-weight: 400;
  }

  .answer-card:focus-within .answer-card-link:focus {
    outline: 2px solid var(--ocean);
    outline-offset: 3px;
  }
</style>
