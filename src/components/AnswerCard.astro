---
import { answerPath, categoryPath, displayCategory, formatDate, getAnswerDisplayTitle, getAnswerSummary } from '@/lib/content';
import type { Question } from '@/lib/supabase';

type Props = {
  question: Question;
  headingLevel?: 2 | 3;
};

const { question, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const category = displayCategory(question);
const title = getAnswerDisplayTitle(question);
const summary = getAnswerSummary(question);
---

<article class="answer-card">
  <a class="answer-card-link" href={answerPath(question.slug)}>
    <Heading>{title}</Heading>
  </a>
  <p>{summary}</p>
  <div class="meta-row">
    <a class="pill" href={categoryPath(category)}>{category}</a>
    <span class="pill">Updated {formatDate(question.updated_at || question.created_at)}</span>
  </div>
</article>
