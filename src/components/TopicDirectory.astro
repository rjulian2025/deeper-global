---
import {
  TOPIC_QUESTIONS_LABELS,
  type EditorialTopicGroup,
  type TopicQuestionsLabel,
} from '@/lib/topic-directory';

type Props = {
  groups: EditorialTopicGroup[];
  variant?: 'baseline' | 'a' | 'b' | 'c';
  questionsLabel?: TopicQuestionsLabel;
};

const { groups, variant = 'c', questionsLabel = 'people-often-ask' } = Astro.props;
const showDescriptor = variant === 'a' || variant === 'c';
const showDiscovery = variant === 'b' || variant === 'c';
const questionsLabelText = TOPIC_QUESTIONS_LABELS[questionsLabel];
---

<div class={`topic-directory topic-directory--${variant}`}>
  {
    groups.map((group, index) => {
      const moduleNumber = String(index + 1).padStart(2, '0');
      const groupId = `topic-group-${group.name.replace(/\s+/g, '-').toLowerCase()}`;

      return (
        <section class="topic-directory-group tier-module" aria-labelledby={groupId}>
          <p class="tier-index" aria-hidden="true">{moduleNumber}</p>
          <h3 class="tier-heading" id={groupId}>{group.name}</h3>
          {
            showDescriptor && group.description && (
              <p class="tier-description">{group.description}</p>
            )
          }
          <ul class="tier-link-list">
            {
              group.topics.map((topic) => (
                <li>
                  <a
                    class="tier-link"
                    href={topic.href}
                    title={topic.count > 0 ? `${topic.count.toLocaleString()} answers in ${topic.name}` : undefined}
                  >
                    {topic.name}
                  </a>
                </li>
              ))
            }
          </ul>
          {
            showDiscovery && group.discoveryLinks.length > 0 && (
              <div class="tier-discovery-block">
                <p class="tier-utility">{questionsLabelText}</p>
                <ul class="tier-link-list">
                  {
                    group.discoveryLinks.map((link) => (
                      <li>
                        <a class="tier-link" href={link.href}>{link.title}</a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            )
          }
        </section>
      );
    })
  }
</div>
