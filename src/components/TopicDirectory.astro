---
import {
  TOPIC_QUESTIONS_LABELS,
  type EditorialTopicGroup,
  type TopicQuestionsLabel,
} from '@/lib/topic-directory';

type Props = {
  groups: EditorialTopicGroup[];
  variant?: 'baseline' | 'a' | 'b' | 'c';
  questionsLabel?: TopicQuestionsLabel;
};

const { groups, variant = 'c', questionsLabel = 'people-often-ask' } = Astro.props;
const showDescriptor = variant === 'a' || variant === 'c';
const showDiscovery = variant === 'b' || variant === 'c';
const questionsLabelText = TOPIC_QUESTIONS_LABELS[questionsLabel];
---

<div class={`topic-directory topic-directory--${variant}`}>
  {
    groups.map((group) => (
      <section class="topic-directory-group" aria-labelledby={`topic-group-${group.name.replace(/\s+/g, '-').toLowerCase()}`}>
        <div class="topic-directory-group-head">
          <h3 class="topic-directory-group-title" id={`topic-group-${group.name.replace(/\s+/g, '-').toLowerCase()}`}>
            {group.name}
          </h3>
          {
            showDescriptor && group.description && (
              <p class="topic-directory-descriptor">{group.description}</p>
            )
          }
        </div>
        <ul class="topic-directory-list">
          {
            group.topics.map((topic) => (
              <li>
                <a
                  class="topic-directory-link"
                  href={topic.href}
                  title={topic.count > 0 ? `${topic.count.toLocaleString()} answers in ${topic.name}` : undefined}
                >
                  {topic.name}
                </a>
              </li>
            ))
          }
        </ul>
        {
          showDiscovery && group.discoveryLinks.length > 0 && (
            <div class="topic-directory-questions" aria-label={`${questionsLabelText} in ${group.name}`}>
              <p class="topic-directory-questions-label">{questionsLabelText}</p>
              <ul class="topic-directory-questions-list">
                {
                  group.discoveryLinks.map((link) => (
                    <li>
                      <a class="topic-directory-question-link" href={link.href}>
                        {link.title}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          )
        }
      </section>
    ))
  }
</div>
