---
import '../styles/global.css';
import { organizationId, siteUrl, SITE_NAME, websiteId } from '@/lib/site';

const DEFAULT_OG_IMAGE_PATH = '/og/deeper-global-og-v2.png';
const DEFAULT_OG_IMAGE_ALT =
  'Deeper Global — mental health answers for the questions you ask when no one is looking';
const DEFAULT_OG_IMAGE_WIDTH = 1200;
const DEFAULT_OG_IMAGE_HEIGHT = 630;

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  imagePath?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
};

const {
  title = `${SITE_NAME} | Mental health answers worth asking`,
  description = 'Expert-vetted answers for the questions you ask when no one is looking — too personal, too tangled, or too hard to ask out loud.',
  canonicalPath = Astro.url.pathname,
  ogType = 'website',
  jsonLd,
  noindex = false,
  imagePath = DEFAULT_OG_IMAGE_PATH,
  imageAlt = DEFAULT_OG_IMAGE_ALT,
  imageWidth = DEFAULT_OG_IMAGE_WIDTH,
  imageHeight = DEFAULT_OG_IMAGE_HEIGHT,
} = Astro.props;

const canonicalUrl = siteUrl(canonicalPath);
const imageUrl = /^https?:\/\//i.test(imagePath) ? imagePath : siteUrl(imagePath);
const GA_MEASUREMENT_ID = import.meta.env.NEXT_PUBLIC_GA_ID ?? 'G-7431WR2PB3';
const INTENT_EVENT_ENDPOINT = import.meta.env.PUBLIC_INTENT_EVENT_ENDPOINT ?? '/api/intent-event';
const siteGraph = [
  {
    '@type': 'Organization',
    '@id': organizationId(),
    name: SITE_NAME,
    url: siteUrl(),
    logo: siteUrl('/favicon.svg'),
  },
  {
    '@type': 'WebSite',
    '@id': websiteId(),
    name: SITE_NAME,
    url: siteUrl(),
    publisher: {
      '@id': organizationId(),
    },
  },
];
const pageGraph = jsonLd
  ? Array.isArray(jsonLd['@graph']) ? jsonLd['@graph'] : [jsonLd]
  : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [...siteGraph, ...pageGraph],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e1f33" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    <meta property="og:image:width" content={imageWidth} />
    <meta property="og:image:height" content={imageHeight} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/agents.txt" title="agents.txt" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){window.dataLayer.push(arguments);}
      window.gtag('js', new Date());
      window.gtag('config', GA_MEASUREMENT_ID, {
        page_location: `${window.location.origin}${window.location.pathname}`,
        page_path: window.location.pathname,
      });
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Serif+Display:ital,wght@0,500;0,600;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <nav class="container nav" aria-label="Primary navigation">
          <a class="brand" href="/" aria-label="Deeper Global home">
            <span class="brand-word">Deeper</span><span class="brand-dot">.</span>
          </a>
          <button
            type="button"
            class="nav-hamburger"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="nav-drawer"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
          <div class="site-nav-links">
            <a href="/answers/">Answers</a>
            <a href="/modalities/">Modalities</a>
            <a href="/adhd/">ADHD</a>
            <a href="/ai-mental-health/">AI mental health</a>
            <a href="/categories/">Topics</a>
            <a href="/themes/">Themes</a>
            <a href="/protocol/">Protocol</a>
            <a href="/about/">About</a>
          </div>
          <a class="nav-cta" href="/answers/">
            <span class="nav-cta-full">Ask anything</span>
            <span class="nav-cta-short" aria-hidden="true">Ask</span>
          </a>
        </nav>
      </header>
      <nav id="nav-drawer" class="nav-drawer" aria-label="Site navigation" aria-hidden="true">
        <div class="nav-drawer-inner">
          <a href="/answers/">Answers</a>
          <a href="/modalities/">Modalities</a>
          <a href="/adhd/">ADHD</a>
          <a href="/categories/">Topics</a>
          <a href="/themes/">Themes</a>
          <a href="/protocol/">Protocol</a>
          <a href="/about/">About</a>
          <a href="/ai-mental-health/">AI mental health</a>
        </div>
      </nav>
      <div class="nav-overlay" aria-hidden="true"></div>
      <slot />
      <footer class="footer">
        <div class="container footer-row">
          <span>Evidence-informed mental health answers. Not a substitute for care.</span>
          <span>
            <a href="/protocol/">Trust protocol</a>
            <a href="/editorial-policy/">Editorial policy</a>
            <a href="/ai-use/">AI use</a>
            <a href="/llms.txt">llms.txt</a>
            <a href="/developers/">Developers</a>
            <a href="/api-terms/">API terms</a>
            <a href="/privacy/">Privacy</a>
          </span>
        </div>
      </footer>
    </div>
    <script is:inline define:vars={{ INTENT_EVENT_ENDPOINT }}>
      (() => {
        const MAX_PARAM_LENGTH = 100;
        const sameHost = window.location.hostname;
        const path = window.location.pathname;

        const clean = (value, maxLength = MAX_PARAM_LENGTH) => {
          if (typeof value !== 'string') return undefined;
          const normalized = value.replace(/\s+/g, ' ').trim();
          return normalized ? normalized.slice(0, maxLength) : undefined;
        };

        const slugFromPath = (prefix) => {
          const match = path.match(new RegExp(`^/${prefix}/([^/]+)/?$`));
          return match ? match[1] : undefined;
        };

        const referrerDomain = () => {
          if (!document.referrer) return undefined;
          try {
            return new URL(document.referrer).hostname;
          } catch {
            return undefined;
          }
        };

        const deviceType = () => {
          const width = window.innerWidth;
          if (width < 768) return 'mobile';
          if (width < 1024) return 'tablet';
          return 'desktop';
        };

        const inferContentType = () => {
          if (document.querySelector('.answer-layout')) return 'answer';
          if (path.startsWith('/answers/')) return path === '/answers/' ? 'search' : 'answer';
          if (path.startsWith('/categories/')) return 'category';
          if (path.startsWith('/entities/') || path.startsWith('/themes/')) return 'entity';
          if (path === '/editorial-policy/') return 'policy';
          return 'hub';
        };

        const intentStageFromText = (value) => {
          const text = (value || '').toLowerCase();
          if (/suicide|self-harm|overdose|crisis|danger|unsafe/.test(text)) return 'risk_support';
          if (/therapy|therapist|counseling|treatment|professional help|support/.test(text)) return 'care_navigation';
          if (/partner|relationship|conflict|parent|family|friend|co-parent/.test(text)) return 'relationship_navigation';
          if (/identity|self-worth|belong|meaning|purpose|esteem/.test(text)) return 'identity_meaning';
          if (/cope|calm|manage|stop|support|what should i do|how can i/.test(text)) return 'self_management';
          return 'understanding_symptom';
        };

        const sensitivityFromText = (value) => {
          const text = (value || '').toLowerCase();
          if (/suicide|self-harm|overdose|crisis|danger|unsafe/.test(text)) return 'crisis-sensitive';
          if (/addiction|substance|sobriety|relapse|withdrawal|porn/.test(text)) return 'addiction';
          if (/trauma|ptsd|flashback|grief/.test(text)) return 'trauma';
          if (/abuse|violence|coercion|stalking/.test(text)) return 'abuse';
          if (/teen|child|parenting|minor/.test(text)) return 'minor';
          if (/medication|antidepressant|ssri|snri|prescription/.test(text)) return 'medication';
          return 'standard';
        };

        const commonParams = () => {
          const answerLayout = document.querySelector('.answer-layout');
          const categorySlug = slugFromPath('categories');
          const entitySlug = slugFromPath('entities');
          const answerSlug = answerLayout?.getAttribute('data-question-slug') ?? slugFromPath('answers');
          const primaryEntity = answerLayout?.getAttribute('data-primary-entity');
          const pageContext = `${path} ${document.title} ${primaryEntity ?? ''} ${categorySlug ?? ''} ${entitySlug ?? ''}`;

          return {
            page_path: path,
            referrer_domain: referrerDomain(),
            content_type: inferContentType(),
            answer_slug: answerSlug,
            category: clean(primaryEntity ?? categorySlug),
            entity_slug: entitySlug,
            risk_class: answerLayout?.getAttribute('data-risk-class') ?? (document.querySelector('.crisis') ? 'crisis-sensitive' : 'standard'),
            intent_stage: intentStageFromText(pageContext),
            sensitivity: sensitivityFromText(pageContext),
            device_type: deviceType(),
          };
        };

        const compactParams = (params) =>
          Object.fromEntries(
            Object.entries({ ...commonParams(), ...params })
              .map(([key, value]) => [key, typeof value === 'string' ? clean(value) : value])
              .filter(([, value]) => value !== undefined && value !== null && value !== '')
          );

        const sendFirstPartyIntentEvent = (eventName, params) => {
          if (!INTENT_EVENT_ENDPOINT) return;

          const body = JSON.stringify({
            event_name: eventName,
            event_params: params,
          });

          try {
            if (navigator.sendBeacon) {
              const blob = new Blob([body], { type: 'application/json' });
              navigator.sendBeacon(INTENT_EVENT_ENDPOINT, blob);
              return;
            }

            fetch(INTENT_EVENT_ENDPOINT, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body,
              keepalive: true,
            }).catch(() => {});
          } catch {
            // Tracking should never affect the educational page experience.
          }
        };

        window.deeperTrackEvent = (eventName, params = {}) => {
          const compactedParams = compactParams(params);
          if (typeof window.gtag === 'function') {
            window.gtag('event', eventName, compactedParams);
          }
          sendFirstPartyIntentEvent(eventName, compactedParams);
        };

        if (document.querySelector('.answer-layout')) {
          window.deeperTrackEvent('answer_viewed');
        } else if (path.startsWith('/categories/') && path !== '/categories/') {
          window.deeperTrackEvent('category_viewed', { entity_slug: slugFromPath('categories') });
        } else if (path.startsWith('/entities/') && path !== '/entities/') {
          window.deeperTrackEvent('entity_viewed', { entity_slug: slugFromPath('entities') });
        } else if (path === '/editorial-policy/') {
          window.deeperTrackEvent('editorial_policy_viewed');
        }

        const inferHubSlug = () => {
          if (path === '/' || path === '') return 'home';
          if (path.startsWith('/adhd')) return 'adhd';
          if (path.startsWith('/ai-mental-health')) return 'ai-mental-health';
          if (path.startsWith('/modalities')) return 'modalities';
          if (path === '/answers/') return 'answers-index';
          return undefined;
        };

        const hubSlug = inferHubSlug();
        if (hubSlug) {
          window.deeperTrackEvent('hub_viewed', { hub_slug: hubSlug });
        }

        const scrollMilestones = new Set();
        const trackScrollDepth = () => {
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (docHeight <= 0) return;
          const pct = Math.round((window.scrollY / docHeight) * 100);
          for (const milestone of [25, 50, 75, 90]) {
            if (pct >= milestone && !scrollMilestones.has(milestone)) {
              scrollMilestones.add(milestone);
              window.deeperTrackEvent('scroll_depth', {
                depth_pct: milestone,
                hub_slug: inferHubSlug(),
              });
            }
          }
        };

        window.addEventListener('scroll', () => requestAnimationFrame(trackScrollDepth), { passive: true });
        trackScrollDepth();

        const hamburger = document.querySelector('.nav-hamburger');
        const drawer = document.getElementById('nav-drawer');
        const overlay = document.querySelector('.nav-overlay');

        const openDrawer = () => {
          if (!drawer || !hamburger || !overlay) return;
          drawer.setAttribute('aria-hidden', 'false');
          hamburger.setAttribute('aria-expanded', 'true');
          hamburger.setAttribute('aria-label', 'Close menu');
          overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        };

        const closeDrawer = () => {
          if (!drawer || !hamburger || !overlay) return;
          drawer.setAttribute('aria-hidden', 'true');
          hamburger.setAttribute('aria-expanded', 'false');
          hamburger.setAttribute('aria-label', 'Open menu');
          overlay.classList.remove('active');
          document.body.style.overflow = '';
        };

        hamburger?.addEventListener('click', () => {
          const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
          if (isOpen) closeDrawer();
          else openDrawer();
        });

        overlay?.addEventListener('click', closeDrawer);

        drawer?.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', closeDrawer);
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeDrawer();
        });

        if (document.querySelector('.crisis')) {
          window.deeperTrackEvent('crisis_banner_seen', { risk_class: 'crisis-sensitive' });
        }

        if (document.querySelector('.practitioner-card')) {
          window.deeperTrackEvent('practitioner_callout_viewed', { content_type: 'external_referral' });
        }

        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element ? event.target.closest('a') : null;
          if (!link) return;

          const href = link.getAttribute('href') ?? '';
          const label = clean(link.textContent ?? '', 80);
          const trackDeeperOutboundClick = (target, placement) => {
            const destinationDomain = target.hostname.replace(/^www\./, '');
            window.deeperTrackEvent('deeper_outbound_click', {
              content_type: 'external_referral',
              link_label: label,
              destination_domain: destinationDomain,
              outbound_domain: target.hostname,
              placement,
              source_page: window.location.pathname,
              utm_source: target.searchParams.get('utm_source') ?? undefined,
              utm_medium: target.searchParams.get('utm_medium') ?? undefined,
              utm_campaign: target.searchParams.get('utm_campaign') ?? undefined,
              utm_content: target.searchParams.get('utm_content') ?? undefined,
            });
          };

          if (link.closest('.site-nav-links, .nav-drawer-inner') && href.startsWith('/')) {
            window.deeperTrackEvent('hub_link_clicked', {
              link_label: label,
              target_path: href,
            });
          }

          if (link.closest('.crisis')) {
            window.deeperTrackEvent('crisis_resource_clicked', {
              link_label: label,
              outbound_domain: href.startsWith('tel:') ? 'phone' : undefined,
              risk_class: 'crisis-sensitive',
            });
          }

          if (link.closest('[data-ai-section="follow-up-questions"]')) {
            window.deeperTrackEvent('follow_up_question_clicked', {
              link_label: label,
              target_path: href.startsWith('/') ? href : undefined,
            });
          }

          if (
            link.closest('[data-ai-section="related-questions"]') ||
            link.closest('[data-ai-section="related-questions-bottom"]')
          ) {
            window.deeperTrackEvent('answer_related_clicked', {
              link_label: label,
              target_path: href.startsWith('/') ? href : undefined,
            });
          }

          if (link.closest('.answer-trust-panel') && /^https?:\/\//.test(href)) {
            window.deeperTrackEvent('source_ref_clicked', {
              link_label: label,
              outbound_domain: new URL(href).hostname,
            });
          }

          if (link.closest('.practitioner-card')) {
            const outboundDomain = /^https?:\/\//.test(href) ? new URL(href).hostname : undefined;
            window.deeperTrackEvent('practitioner_callout_clicked', {
              content_type: 'external_referral',
              link_label: label,
              outbound_domain: outboundDomain,
            });
          }

          if (/^https?:\/\//.test(href)) {
            const target = new URL(href);
            if (target.hostname !== sameHost) {
              trackDeeperOutboundClick(target, link.closest('.practitioner-card') ? 'practitioner-card' : 'external-link');
              window.deeperTrackEvent('external_referral_clicked', {
                content_type: 'external_referral',
                link_label: label,
                outbound_domain: target.hostname,
              });
            }
          }
        });
      })();
    </script>
  </body>
</html>
