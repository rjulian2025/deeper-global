# Local project overrides (gitignored via .env*)
# Routine content scripts also read ~/.config/deeper-global/secrets.env.
# Run once from repo root: npm run env:sync
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
CRON_SECRET=""
# Preview/staging builds: set PUBLIC_INDEXABLE=false (see npm run build:preview)
# PUBLIC_INDEXABLE=true
# Production analytics (no hardcoded fallback — omit to disable GA4 in builds)
PUBLIC_GA_MEASUREMENT_ID=""
# Aliases also read by src/lib/site-env.ts:
# PUBLIC_GA4_MEASUREMENT_ID=""
# NEXT_PUBLIC_GA_ID=""
# Search Console HTML-tag verification (optional; domain DNS verification also valid)
# PUBLIC_GOOGLE_SITE_VERIFICATION=""
PUBLIC_MAPBOX_TOKEN=""
